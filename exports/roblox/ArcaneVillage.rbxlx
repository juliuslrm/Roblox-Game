<Item class="ModuleScript" referent="RBX000051"><Properties><string name="Name">ResourceService</string><ProtectedString name="Source"><![CDATA[-- Server-owned gathering nodes shared by all players of a server.
local D = require(script.Parent.Data)
local Inv = require(script.Parent.InventoryService)
local Locations = D.Locations
local Res = {}
function Res.new()
	local nodes = {}
	for id, def in pairs(Locations.nodes) do nodes[id] = { remaining = def.capacity, timer = 0 } end
	return nodes
end
function Res.step(nodes, dt)
	for id, state in pairs(nodes) do
		local def = Locations.nodes[id]
		if state.remaining < def.capacity then
			state.timer = state.timer + dt
			while state.timer >= def.respawnSec and state.remaining < def.capacity do
				state.timer = state.timer - def.respawnSec
				state.remaining = math.min(def.capacity, state.remaining + def.amount)
			end
		else
			state.timer = 0
		end
	end
end
-- Returns gained amount or nil, code. Takes at most one portion; never more than is left or fits.
function Res.gather(nodes, P, nodeId)
	local def, state = Locations.nodes[nodeId], nodes[nodeId]
	if not def then return nil, "NOT_FOUND" end
	if state.remaining <= 0 then return nil, "NOT_READY" end
	local n = math.min(def.amount, state.remaining, Inv.room(P.items, def.item, Inv.PLAYER))
	if n <= 0 then return nil, "NO_SPACE" end
	state.remaining = state.remaining - n
	Inv.add(P.items, { [def.item] = n })
	return n
end
return Res
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000052"><Properties><string name="Name">ResourceWorld</string><ProtectedString name="Source"><![CDATA[-- ROBLOX ADAPTER: puts a model of the resource at every resource node and lets players harvest it
-- by interacting with that model.  Game rules stay in ResourceService; this module only mirrors
-- the node state (available / used up) into the world.
local D = require(script.Parent.Data)
local Art = require(script.Parent.ResourceArt)
local Locations, Items = D.Locations, D.Items
local World = {}
World.__index = World

local EMPTY_TRANSPARENCY = 0.7

-- Stand-in when the model library is missing (plain test place): a small crate, so there is still
-- an object to interact with.
local function fallback(folder, pivot)
	local part = Instance.new("Part")
	part.Name = "Resource"
	part.Size = Vector3.new(2.4, 1.8, 2.4)
	part.CFrame = pivot * CFrame.new(0, 0.9, 0)
	part.Color, part.Material = Color3.fromRGB(134, 87, 58), Enum.Material.Wood
	part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	part.Parent = folder
	return part
end

local function imported(folder, templates, name, pivot)
	local template = templates and templates:FindFirstChild(name, true)
	local shape = Art[name]
	if not template or not shape or not template:IsA("BasePart") then return nil end
	local mesh = template:Clone()
	mesh.Name = "Resource"
	mesh.Size = Vector3.new(table.unpack(shape.size))
	-- keep the template's rotation: the asset loader stores the import correction there
	mesh.CFrame = pivot * CFrame.new(table.unpack(shape.center)) * (template.CFrame - template.CFrame.Position)
	mesh.Parent = folder
	return mesh
end

-- Fixed, node-specific turn so equal models do not all face the same way.
local function yawOf(id)
	local sum = 0
	for i = 1, #id do sum = (sum * 31 + string.byte(id, i)) % 360 end
	return sum
end

-- nodeAnchors: id -> { x, y, z } in village-local coordinates; groundPosition(anchor) -> world Vector3
-- onGather(player, nodeId) is called when a player uses the prompt of a node.
function World.build(parent, nodeAnchors, origin, templates, groundPosition, onGather)
	local self = setmetatable({ entries = {} }, World)
	local root = Instance.new("Folder")
	root.Name = "ArcaneResources"
	for id, anchor in pairs(nodeAnchors) do
		local node = Locations.nodes[id]
		local folder = Instance.new("Folder")
		folder.Name, folder.Parent = id, root
		local pivot = CFrame.new(groundPosition(anchor)) * (origin - origin.Position) * CFrame.Angles(0, math.rad(yawOf(id)), 0)
		local body = imported(folder, templates, "res_" .. node.item, pivot) or fallback(folder, pivot)
		body.Anchored, body.CanCollide, body.CanTouch = true, false, false
		body:SetAttribute("ArcaneNode", id)
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText, prompt.ObjectText = "Sammeln", Items[node.item].name
		prompt.MaxActivationDistance, prompt.RequiresLineOfSight, prompt.HoldDuration = 10, false, 0.15
		prompt.Triggered:Connect(function(player) onGather(player, id) end)
		prompt.Parent = body
		self.entries[id] = { body = body, prompt = prompt, empty = false }
	end
	local previous = parent:FindFirstChild(root.Name)
	if previous then previous:Destroy() end
	root.Parent = parent
	self.root = root
	return self
end

-- nodes: world.nodes (id -> { remaining }).  A used-up resource fades and cannot be harvested until
-- it has grown back.
function World:update(nodes)
	for id, entry in pairs(self.entries) do
		local state = nodes[id]
		local empty = state ~= nil and state.remaining <= 0
		if empty ~= entry.empty then
			entry.empty = empty
			entry.body.Transparency = empty and EMPTY_TRANSPARENCY or 0
			entry.prompt.Enabled = not empty
		end
	end
end

return World
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000053"><Properties><string name="Name">SecurityService</string><ProtectedString name="Source"><![CDATA[-- Payload validation, rate limiting and replay protection for client requests.
local D = require(script.Parent.Data)
local Config, Protocol, Util = D.Config, D.Protocol, D.Util
local Sec = {}
local INT_LIMIT = 1000000

local function validId(v)
	return type(v) == "string" and #v >= 1 and #v <= 48 and string.find(v, "^[%w_#]+$") ~= nil
end

local function check(kind, v)
	if kind == "int" then return Util.isInt(v) and v >= -INT_LIMIT and v <= INT_LIMIT
	elseif kind == "num" then return Util.isFinite(v)
	elseif kind == "bool" then return type(v) == "boolean"
	elseif kind == "str" then return type(v) == "string" and #v <= 64
	elseif kind == "id" then return validId(v)
	elseif kind == "ids" then
		if type(v) ~= "table" then return false end
		local n = 0
		for k, x in pairs(v) do
			n = n + 1
			if not Util.isInt(k) or k < 1 or n > 128 or not validId(x) then return false end
		end
		return #v == n
	end
	return false
end

-- Returns a clean copy that only contains declared fields, or nil.
function Sec.validate(action, payload)
	local spec = Protocol.actions[action]
	if not spec or type(payload) ~= "table" then return nil end
	local clean = {}
	for field, kind in pairs(spec) do
		local optional = string.sub(field, -1) == "?"
		local name = optional and string.sub(field, 1, -2) or field
		local v = payload[name]
		if v == nil then
			if not optional then return nil end
		elseif not check(kind, v) then
			return nil
		else
			clean[name] = (kind == "ids") and Util.deepCopy(v) or v
		end
	end
	if payload.actionId ~= nil then
		if not validId(payload.actionId) then return nil end
		clean.actionId = payload.actionId
	end
	return clean
end

function Sec.allow(session, action, now)
	local rule = Config.rate[action] or Config.rate.default
	local buckets = session.rt.buckets
	local b = buckets[action]
	if not b then
		b = { tokens = rule.burst, at = now }
		buckets[action] = b
	end
	b.tokens = math.min(rule.burst, b.tokens + math.max(0, now - b.at) * rule.perSec)
	b.at = now
	if b.tokens < 1 then return false end
	b.tokens = b.tokens - 1
	return true
end

function Sec.replayed(session, actionId)
	return actionId and session.rt.recent[actionId] or nil
end
function Sec.remember(session, actionId, result)
	if not actionId then return end
	local rt = session.rt
	rt.recent[actionId] = result
	rt.recentOrder[#rt.recentOrder + 1] = actionId
	if #rt.recentOrder > 64 then
		rt.recent[table.remove(rt.recentOrder, 1)] = nil
	end
end
return Sec
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000054"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[-- Customers buy real stock from the shop shelves of a workshop. Sole writer of shelf sales.
local D = require(script.Parent.Data)
local Eco = require(script.Parent.EconomyService)
local Config, Machines, Items, Util = D.Config, D.Machines, D.Items, D.Util
local Shop = {}

local function rand(P)
	local s, r = Util.nextRandom(P.shop.rng)
	P.shop.rng = s
	return r
end

function Shop.shelves(P)
	local list = {}
	for _, e in ipairs(P.workshop.layout) do
		if Machines[e.machine].kind == "shelf" then list[#list + 1] = e.uid end
	end
	return list
end

function Shop.stock(P)
	local stock = {}
	for _, uid in ipairs(Shop.shelves(P)) do
		for item, n in pairs(P.workshop.buffers[uid].inv) do stock[item] = (stock[item] or 0) + n end
	end
	return stock
end

function Shop.rerollDemand(P)
	local lo, hi = Config.shop.demandMin * 100, Config.shop.demandMax * 100
	for _, id in ipairs(Util.sortedKeys(Items)) do
		if Items[id].type == "product" then P.shop.demand[id] = math.floor(lo + rand(P) * (hi - lo) + 0.5) end
	end
end

-- One purchase: stock, wallet, statistics and the sale event change together or not at all.
function Shop.sell(P, item, qty, emit)
	local left = qty
	local shelves = Shop.shelves(P)
	local have = 0
	for _, uid in ipairs(shelves) do have = have + (P.workshop.buffers[uid].inv[item] or 0) end
	if have < qty or qty < 1 or Items[item].type ~= "product" then return nil end
	for _, uid in ipairs(shelves) do
		local inv = P.workshop.buffers[uid].inv
		local take = math.min(left, inv[item] or 0)
		if take > 0 then
			inv[item] = inv[item] - take
			if inv[item] == 0 then inv[item] = nil end
			left = left - take
		end
	end
	local price = Eco.priceFor(P, item, Items[item].sellBase)
	local coins = price * qty
	Eco.earn(P, coins)
	P.stats.sold = P.stats.sold + qty
	P.shop.serial = (P.shop.serial or 0) + 1
	local sale = { type = "sell", item = item, n = qty, coins = coins, price = price, id = P.shop.serial }
	emit(sale)
	return sale
end

function Shop.step(P, dt, emit)
	local shop = P.shop
	if next(shop.demand) == nil then Shop.rerollDemand(P) end
	shop.demandIn = (shop.demandIn or 0) - dt
	if shop.demandIn <= 0 then
		Shop.rerollDemand(P)
		shop.demandIn = Config.shop.demandDriftSec
	end
	shop.nextIn = shop.nextIn - dt
	if shop.nextIn > 0 then return end
	local shelves = #Shop.shelves(P)
	local speed = 1 + 0.15 * math.max(0, shelves - 1) + 0.05 * Eco.repLevel(P)
	shop.nextIn = (Config.shop.customerMinSec + rand(P) * (Config.shop.customerMaxSec - Config.shop.customerMinSec)) / speed
	local stock = Shop.stock(P)
	local ids, total = Util.sortedKeys(stock), 0
	for _, id in ipairs(ids) do total = total + (shop.demand[id] or 100) end
	if total == 0 then
		emit({ type = "customer_left" })
		return
	end
	local pick, acc, chosen = rand(P) * total, 0, ids[#ids]
	for _, id in ipairs(ids) do
		acc = acc + (shop.demand[id] or 100)
		if pick <= acc then chosen = id break end
	end
	local qty = math.min(stock[chosen], (rand(P) < 0.35) and 2 or 1)
	Shop.sell(P, chosen, qty, emit)
end
return Shop
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000055"><Properties><string name="Name">VillageAdapter</string><ProtectedString name="Source"><![CDATA[-- Connects the gameplay to the generated village WITHOUT changing it.
-- computeAnchors() is pure: it derives every interaction point from WorldLayout (asset id of the
-- unique building instance), so anchors follow the buildings when the world is regenerated.
local D = require(script.Parent.Data)
local Locations = D.Locations
local Adapter = {}

-- layout = require(WorldLayout). Returns anchors, nodeAnchors, missing (location ids without instance).
-- Anchor fields: x, y, z (y = ground height of the instance origin), fx, fz (unit vector pointing
-- away from the building), yaw (degrees).
function Adapter.computeAnchors(layout)
	local index = {}
	for i, name in ipairs(layout.assetNames) do index[name] = i end
	local byAsset = {}
	for _, row in ipairs(layout.instances) do
		local name = layout.assetNames[row[1]]
		if not byAsset[name] then byAsset[name] = row end
	end
	local anchors, nodeAnchors, missing = {}, {}, {}
	for id, loc in pairs(Locations.locations) do
		local row, def = byAsset[loc.asset], layout.assets[loc.asset]
		if row and def then
			local yaw = math.rad(row[5])
			local fx, fz = math.sin(yaw), math.cos(yaw)                 -- model front (+Z) in world space
			local reach = def.center[3] + def.size[3] / 2 + (loc.standoff or 5)
			if id == "plaza" then reach = def.size[3] / 2 + 6 end
			anchors[id] = { x = row[2] + fx * reach, y = row[3], z = row[4] + fz * reach, fx = fx, fz = fz,
				yaw = row[5], originX = row[2], originZ = row[4] }
		else
			missing[#missing + 1] = id
		end
	end
	for id, node in pairs(Locations.nodes) do
		local a = anchors[node.at]
		if a then
			local rx, rz = a.fz, -a.fx                                  -- right-hand side when looking at the door
			nodeAnchors[id] = { x = a.x + rx * node.ox + a.fx * node.oz, y = a.y, z = a.z + rz * node.ox + a.fz * node.oz }
		end
	end
	return anchors, nodeAnchors, missing
end
return Adapter
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000056"><Properties><string name="Name">WorkshopSimulation</string><ProtectedString name="Source"><![CDATA[-- One deterministic simulation step of a workshop (spec §12 order of operations).
local D = require(script.Parent.Data)
local Logistics = require(script.Parent.LogisticsService)
local Production = require(script.Parent.ProductionService)
local Shop = require(script.Parent.ShopService)
local Metrics = require(script.Parent.MetricsService)
local Config = D.Config
local Sim = {}

function Sim.newRuntime()
	return { clock = 0, tick = 0, dirty = true, graph = nil, stats = Metrics.new() }
end

-- Returns the list of events of this step (craft, sell, piped, customer_left).
function Sim.step(P, rt, dt)
	if not (dt == dt) or dt <= 0 then return {} end
	if dt > Config.sim.maxDt then dt = Config.sim.maxDt end
	if rt.dirty or not rt.graph then
		rt.graph = Logistics.build(P)
		rt.dirty = false
	end
	local events = {}
	local function emit(ev) events[#events + 1] = ev end
	rt.clock = rt.clock + dt
	rt.tick = rt.tick + 1
	Logistics.stepSolids(P, rt.graph, dt, rt.tick)
	Logistics.stepFluids(P, rt.graph, dt, emit)
	Production.step(P, rt.graph, dt, emit)
	Shop.step(P, dt, emit)
	for _, ev in ipairs(events) do
		if ev.type == "craft" then
			P.stats.crafted = P.stats.crafted + 1
			Metrics.record(rt.stats, rt.clock, ev)
		elseif ev.type == "sell" then
			Metrics.record(rt.stats, rt.clock, ev)
		end
	end
	Metrics.prune(rt.stats, rt.clock)
	return events
end
return Sim
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000057"><Properties><string name="Name">WorkshopWorld</string><ProtectedString name="Source"><![CDATA[-- ROBLOX ADAPTER: builds the walkable workshops (open buildings on plots in the village) and the visible
-- representation of every placed entity.  All game rules live in the pure services; this module only
-- mirrors server state into Instances.
local D = require(script.Parent.Data)
local Config, Machines, Grid = D.Config, D.Machines, D.GridMath
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("ArcaneShared")
local Architecture = require(Shared.WorkshopArchitecture)
local Models = require(Shared.WorkshopModels)
local WW = {}
WW.__index = WW

local COLORS = {
	machine = Color3.fromRGB(134, 87, 58), storage = Color3.fromRGB(181, 133, 86), transport = Color3.fromRGB(110, 106, 102),
	pipe = Color3.fromRGB(95, 160, 138),
}
local STATE_TEXT = { Running = "läuft", WaitingForInputs = "wartet auf Zutaten", OutputBlocked = "Ausgang voll",
	NoFuel = "kein Brennstoff", Paused = "pausiert", InvalidRecipe = "kein Rezept" }

local function part(props, parent)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do p[k] = v end
	p.Parent = parent
	return p
end

-- templates: optional Folder with imported machine meshes named after Machines[id].modelAssetId
-- plots: optional list of world positions (Vector3, ground level) of the building plots in the
--   village.  With plots the workshops are open buildings that players simply walk into; without
--   them (no level plan) they are closed interiors far away, entered by teleport as before.
function WW.new(parent, templates, plots, plotHalf)
	local self = setmetatable({ rooms = {}, slots = {}, templates = templates, plots = plots, plotHalf = plotHalf or 42 }, WW)
	if plots and #plots == 0 then self.plots = nil end
	self.root = Instance.new("Folder")
	self.root.Name = "ArcaneWorkshops"
	self.root.Parent = parent
	return self
end

-- Interiors live far away from the village so they are never visible from it.
function WW:slotOrigin(slot)
	if self.plots then
		-- floor surface a little above the levelled ground (it varies by up to 0.7 studs)
		return self.plots[slot + 1] + Vector3.new(0, WW.FLOOR_LIFT, 0)
	end
	return Vector3.new(6000 + (slot % 4) * 600, 800, 6000 + math.floor(slot / 4) * 600)
end

function WW:cellCenter(room, floor, x, z)
	local half = room.cells * Config.cellSize / 2
	return room.origin + Vector3.new(x * Config.cellSize - half + 1, (floor - 1) * Config.floorHeight, z * Config.cellSize - half + 1)
end

WW.FLOOR_LIFT = 0.6

-- Is a world position on the plot of a room (inside the building or on its yard)?  Used by the
-- server to decide in whose workshop a character stands.
function WW:ownerAt(position)
	if not self.plots then return nil end
	for ownerId, room in pairs(self.rooms) do
		local half = room.cells * Config.cellSize / 2 + 1.5
		local d = position - room.origin
		if math.abs(d.X) <= half and math.abs(d.Z) <= half and d.Y > -4 and d.Y < room.floors * Config.floorHeight + 8 then
			return ownerId
		end
	end
	return nil
end

local ARCHITECTURE_COLORS = {
	wood_dark = "5B3A26", wood_mid = "86573A", wood_pale = "D2AE7C", wood_red = "7A3B2A",
	plaster_cream = "EBDDBE", plaster_sage = "B9C4A0", stone_dark = "6E6A66", stone_warm = "B4A58C", stone_light = "C9C2B2",
	iron = "3E4046", brass = "C99A3C", glass_lit = "FFD27A", glass_light = "7FB2C9",
	leaf_dark = "3F7D3A", leaf_teal = "3F8A6A", roof_purple = "6F4E7C",
}

-- Yard of an open workshop: marks the whole plot the building may grow into.
local function buildYard(room, shell, plotHalf, label)
	local stone, wood = Color3.fromHex(ARCHITECTURE_COLORS.stone_light), Color3.fromHex(ARCHITECTURE_COLORS.wood_dark)
	local ground = room.origin - Vector3.new(0, WW.FLOOR_LIFT, 0)
	local edge = plotHalf - 1
	for s = -1, 1, 2 do
		-- flat kerb stones along the plot boundary; low enough to walk over
		part({ Name = "PlotKerb", Size = Vector3.new(edge * 2 + 1, 0.5, 1), Position = ground + Vector3.new(0, 0.05, s * edge),
			Color = stone, Material = Enum.Material.Slate, CanCollide = false, CanQuery = false }, shell)
		part({ Name = "PlotKerb", Size = Vector3.new(1, 0.5, edge * 2 + 1), Position = ground + Vector3.new(s * edge, 0.05, 0),
			Color = stone, Material = Enum.Material.Slate, CanCollide = false, CanQuery = false }, shell)
		for t = -1, 1, 2 do
			part({ Name = "PlotPost", Size = Vector3.new(0.9, 4, 0.9), Position = ground + Vector3.new(s * edge, 2, t * edge),
				Color = wood, Material = Enum.Material.Wood, CanCollide = true }, shell)
		end
	end
	-- name board at every opening of the plot
	local half = room.cells * Config.cellSize / 2
	for _, dir in ipairs({ Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) }) do
		local side = Vector3.new(-dir.Z, 0, dir.X)
		local at = room.origin + dir * (half + 1.5) + side * (Architecture.OPENING / 2 + 1.6)
		part({ Name = "SignPost", Size = Vector3.new(0.5, 6, 0.5), Position = at + Vector3.new(0, 3 - WW.FLOOR_LIFT, 0),
			Color = wood, Material = Enum.Material.Wood, CanCollide = false, CanQuery = false }, shell)
		local board = part({ Name = "SignBoard", Size = Vector3.new(5, 2, 0.3),
			CFrame = CFrame.lookAt(at + Vector3.new(0, 6.2 - WW.FLOOR_LIFT, 0), at + Vector3.new(0, 6.2 - WW.FLOOR_LIFT, 0) + dir),
			Color = Color3.fromHex(ARCHITECTURE_COLORS.wood_pale), Material = Enum.Material.Wood, CanCollide = false, CanQuery = false }, shell)
		for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
			local gui = Instance.new("SurfaceGui")
			gui.Face, gui.PixelsPerStud = face, 40
			local text = Instance.new("TextLabel")
			text.Size, text.BackgroundTransparency, text.TextScaled = UDim2.new(1, 0, 1, 0), 1, true
			text.Font, text.TextColor3, text.Text = Enum.Font.GothamBold, Color3.fromRGB(60, 40, 28), label
			text.Parent = gui
			gui.Parent = board
		end
	end
end

local function buildShell(self, room)
	if room.shell then room.shell:Destroy() end
	local shell = Instance.new("Folder")
	shell.Name = "Shell"
	local size = room.cells * Config.cellSize
	local boxes, lights = Architecture.build(size, room.floors, Config.floorHeight, self.plots ~= nil)
	if self.plots then buildYard(room, shell, self.plotHalf, room.label or "Werkstatt") end
	for _, spec in ipairs(boxes) do
		local item = part({
			Name = spec.name, Size = Vector3.new(table.unpack(spec.size)),
			CFrame = CFrame.new(room.origin + Vector3.new(table.unpack(spec.position)))
				* CFrame.Angles(0, 0, math.rad(spec.roll or 0)),
			Color = Color3.fromHex(ARCHITECTURE_COLORS[spec.color]),
			Material = (spec.name == "Lamp") and Enum.Material.Neon or Enum.Material.SmoothPlastic,
			CanCollide = spec.collides, CanQuery = spec.collides,
		}, shell)
		if spec.floor then item:SetAttribute("ArcaneFloor", spec.floor) end
		if spec.name == "ExitDoor" then
			local prompt = Instance.new("ProximityPrompt")
			prompt.ActionText, prompt.ObjectText, prompt.HoldDuration, prompt.MaxActivationDistance = "Verlassen", "Werkstatt", 0.2, 12
			prompt.Parent = item
			room.exitPrompt = prompt
		end
	end
	for _, spec in ipairs(lights) do
		local anchor = part({
			Name = "LightAnchor", Size = Vector3.new(0.2, 0.2, 0.2),
			Position = room.origin + Vector3.new(table.unpack(spec.position)),
			Transparency = 1, CanCollide = false, CanQuery = false, CastShadow = false,
		}, shell)
		local light = Instance.new("PointLight")
		light.Range, light.Brightness, light.Color = spec.range, spec.strength, Color3.fromRGB(255, 218, 164)
		light.Parent = anchor
	end
	shell.Parent = room.folder
	room.shell = shell
end

function WW:ensureRoom(ownerId, cells, floors, label)
	local room = self.rooms[ownerId]
	if not room then
		local slot = 0
		while self.slots[slot] do slot = slot + 1 end
		if self.plots and slot >= #self.plots then return nil end -- every plot is taken
		self.slots[slot] = ownerId
		room = { owner = ownerId, slot = slot, origin = self:slotOrigin(slot), entities = {}, cells = 0, floors = 0, label = label }
		room.folder = Instance.new("Folder")
		room.folder.Name = "Workshop_" .. ownerId
		room.folder.Parent = self.root
		room.entityFolder = Instance.new("Folder")
		room.entityFolder.Name = "Entities"
		room.entityFolder.Parent = room.folder
		self.rooms[ownerId] = room
	end
	if room.cells ~= cells or room.floors ~= floors then
		room.cells, room.floors = cells, floors
		buildShell(self, room)
		room.version = nil
	end
	return room
end

function WW:spawnCFrame(room)
	local size = room.cells * Config.cellSize
	return CFrame.new(room.origin + Vector3.new(0, 4, -size / 2 + 5)) * CFrame.Angles(0, math.rad(180), 0)
end

local function entityModel(self, room, e)
	local def = Machines[e.machine]
	local w, d = Grid.size(def, e.rot)
	local cs = Config.cellSize
	local height = (def.category == "transport") and 0.8 or (def.kind == "shelf") and 6 or 4
	if def.layer == "pipe" then height = 0.5 end
	local base = WW.cellCenter(self, room, e.floor, e.gx, e.gz) + Vector3.new((w - 1) * cs / 2, height / 2 + (def.layer == "pipe" and 0.05 or 0), (d - 1) * cs / 2)
	local template = self.templates and self.templates:FindFirstChild(def.modelAssetId, true)
	local body
	if template and template:IsA("BasePart") then
		body = template:Clone()
		body.Anchored = true
		if template:GetAttribute("PublishedMachineLibrary") then
			-- undo whatever scale the importer applied: the mesh was designed to fill its footprint
			local k = math.max(body.Size.X, body.Size.Z) / (math.max(def.w, def.d) * cs)
			if k > 1.05 or k < 0.6 then body.Size = body.Size / k end
			-- keep the template's own rotation (the asset loader corrects the import orientation there)
			-- and stand the mesh on the floor: a MeshPart's CFrame is the centre of its bounding box
			local floorY = base.Y - height / 2
			body.CFrame = CFrame.new(base.X, floorY + body.Size.Y / 2, base.Z) * CFrame.Angles(0, math.rad(-90 * e.rot), 0)
				* (template.CFrame - template.CFrame.Position)
		else
			local pivot = CFrame.new(base - Vector3.new(0, height / 2, 0))
				* CFrame.Angles(0, math.rad(-90 * e.rot), 0)
			local mesh = Models[def.modelAssetId]
			if mesh then
				-- Imported MeshParts are centred on the geometry bounds. Recover the
				-- original grid-centred, ground-level pivot before applying rotation.
				local offset = Vector3.new(table.unpack(mesh.center))
				body.Size = Vector3.new(table.unpack(mesh.size))
				body.CFrame = pivot * CFrame.new(offset)
				for _, spec in ipairs(mesh.lights or {}) do
					local attachment = Instance.new("Attachment")
					attachment.Position = Vector3.new(table.unpack(spec.position)) - offset
					attachment.Parent = body
					local light = Instance.new("PointLight")
					light.Color = Color3.new(table.unpack(spec.color))
					light.Brightness, light.Range = spec.brightness, spec.range
					light.Parent = attachment
				end
			else
				body.CFrame = pivot
			end
		end
	else
		body = part({ Size = Vector3.new(w * cs - 0.2, height, d * cs - 0.2), Position = base,
			Color = (def.layer == "pipe") and COLORS.pipe or COLORS[def.category] or COLORS.machine,
			Material = (def.category == "transport") and Enum.Material.Metal or Enum.Material.Wood }, nil)
	end
	body.Name = e.uid
	body:SetAttribute("ArcaneUid", e.uid)
	body:SetAttribute("ArcaneMachine", e.machine)
	if def.category ~= "transport" then
		local gui = Instance.new("BillboardGui")
		gui.Name, gui.Size, gui.StudsOffset, gui.AlwaysOnTop, gui.MaxDistance = "Label", UDim2.new(0, 170, 0, 44), Vector3.new(0, height / 2 + 2.2, 0), false, 60
		local text = Instance.new("TextLabel")
		text.Name, text.Size, text.BackgroundTransparency, text.TextScaled = "Text", UDim2.new(1, 0, 1, 0), 0.25, true
		text.BackgroundColor3, text.TextColor3, text.Font = Color3.fromRGB(35, 32, 31), Color3.fromRGB(247, 244, 236), Enum.Font.GothamMedium
		text.Parent = gui
		gui.Parent = body
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText, prompt.ObjectText, prompt.MaxActivationDistance, prompt.RequiresLineOfSight = "Öffnen", def.name, 9, false
		prompt.Parent = body
	else
		-- direction marker and item token for belts
		local arrow = part({ Name = "Arrow", Size = Vector3.new(0.5, 0.2, 1.2), Color = Color3.fromRGB(201, 154, 60), CanCollide = false,
			CFrame = CFrame.new(base + Vector3.new(0, height / 2 + 0.1, 0)) * CFrame.Angles(0, math.rad(-90 * e.rot), 0) }, body)
		arrow.Name = "Arrow"
		local token = part({ Name = "Token", Size = Vector3.new(0.9, 0.9, 0.9), Position = base + Vector3.new(0, height / 2 + 0.6, 0),
			Color = Color3.fromRGB(95, 163, 67), Transparency = 1, CanCollide = false, Shape = Enum.PartType.Ball }, body)
		token.Name = "Token"
	end
	body.Parent = room.entityFolder
	return body
end

-- Mirrors a workshop view (Game.workshopView) into Instances. Cheap when nothing changed.
function WW:sync(view, label)
	local room = self:ensureRoom(view.owner, view.cells, view.floors, label)
	if not room then return nil end
	if room.version ~= view.version then
		local seen = {}
		for _, e in ipairs(view.entities) do
			seen[e.uid] = true
			local cur = room.entities[e.uid]
			local sig = e.machine .. ":" .. e.gx .. ":" .. e.gz .. ":" .. e.floor .. ":" .. e.rot
			if not cur or cur.sig ~= sig then
				if cur then cur.body:Destroy() end
				room.entities[e.uid] = { sig = sig, body = entityModel(self, room, e) }
			end
		end
		for uid, cur in pairs(room.entities) do
			if not seen[uid] then
				cur.body:Destroy()
				room.entities[uid] = nil
			end
		end
		room.version = view.version
	end
	for _, e in ipairs(view.entities) do
		local cur = room.entities[e.uid]
		if cur then
			local label = cur.body:FindFirstChild("Label")
			if label then
				local def = Machines[e.machine]
				local line = def.name
				if def.kind == "machine" or def.kind == "pump" then
					line = line .. "\n" .. (STATE_TEXT[e.state] or "bereit")
					if e.job then line = line .. string.format(" %d%%", math.floor((1 - e.job.remaining / e.job.total) * 100)) end
				else
					local n = 0
					for _, c in pairs(e.inv) do n = n + c end
					for _, c in pairs(e.fluids) do n = n + math.floor(c / 1000) end
					line = line .. "\n" .. n .. " Stück"
				end
				label.Text.Text = line
			end
			local token = cur.body:FindFirstChild("Token")
			if token then token.Transparency = e.item and 0 or 1 end
		end
	end
	return room
end

function WW:removeRoom(ownerId)
	local room = self.rooms[ownerId]
	if not room then return end
	self.slots[room.slot] = nil
	room.folder:Destroy()
	self.rooms[ownerId] = nil
end
return WW
