<Item class="ModuleScript" referent="RBX000014"><Properties><string name="Name">Locations</string><ProtectedString name="Source"><![CDATA[-- Village locations and resource nodes. Positions are NOT stored here: VillageAdapter derives
-- every anchor from the generated WorldLayout (asset id of the unique building instance).
-- unlock: nil (always) | { research = id } | { quest = id } | { rep = level }
local L = { locations = {}, nodes = {} }
local function loc(id, asset, name, npc, services, unlock, extra)
	local e = { id = id, asset = asset, name = name, npc = npc, services = services, unlock = unlock,
		radius = 16, markerStyle = "service" }
	if extra then for k, v in pairs(extra) do e[k] = v end end
	L.locations[id] = e
end
loc("plaza", "fountain", "Marktplatz", "npc_herald", { "spawn", "tutorial", "project" }, nil, { radius = 30, markerStyle = "hub" })
loc("workshop_door", "house_01_timber_cottage", "Deine Werkstatt", "npc_mentor", { "workshop" }, nil, { markerStyle = "home" })
loc("town_hall", "lm_town_hall", "Rathaus", "npc_mayor", { "main_quests", "plot", "reputation" })
loc("market_hall", "lm_market_hall", "Markthalle", "npc_broker", { "orders", "research" }, nil, { interior = "market" })
loc("tavern", "lm_tavern", "Gasthaus Zum Goldenen Krug", "npc_innkeeper", { "stories", "coop" })
loc("smithy", "lm_smithy", "Schmiede", "npc_smith", { "stories", "license" })
loc("bakery", "house_05_bakery", "Bäckerei", "npc_baker", { "stories" })
loc("showcase", "house_11_stair_house", "Treppenhaus-Werkstatt", "npc_tinkerer", { "stories" }, { research = "belt_basics" })
loc("farm", "house_04_farmhouse", "Bauernhaus", "npc_farmer", { "stories", "seeds" })
loc("barn", "house_17_red_barn", "Rote Scheune", "npc_storekeeper", { "logistics" }, { research = "storage" })
loc("windmill", "lm_windmill", "Windmühle", "npc_miller", { "stories", "milling" })
loc("chapel", "lm_chapel", "Kapelle", "npc_priest", { "stories", "runes" }, { research = "rune_study" })
loc("watchtower", "lm_watchtower", "Wachturm", "npc_watchman", { "stories", "map" }, { quest = "q11" })
loc("fisher", "house_13_fisher_hut", "Fischerhütte", "npc_fisher", { "stories" })
loc("pond", "dock", "Teich und Bootssteg", nil, { "water" }, nil, { radius = 24, markerStyle = "nature" })
loc("bridge", "bridge_stone", "Steinbrücke", nil, { "water" }, nil, { markerStyle = "nature" })

-- Resource nodes: gathered by hand. offset = studs in the location's local frame
-- (x = right of the entrance, z = away from the building, i.e. towards the street).
local function node(id, item, at, ox, oz, amount, capacity, respawn, unlock)
	L.nodes[id] = { id = id, item = item, at = at, ox = ox, oz = oz, amount = amount, capacity = capacity,
		respawnSec = respawn, unlock = unlock }
end
node("n_mint_plaza", "herb_mint", "plaza", -20, 18, 2, 6, 20)
node("n_mint_door", "herb_mint", "workshop_door", 10, 6, 2, 6, 20)
node("n_mint_pond", "herb_mint", "pond", -12, 4, 3, 9, 25)
node("n_sunleaf_plaza", "herb_sunleaf", "plaza", 22, 16, 2, 6, 22)
node("n_sunleaf_bakery", "herb_sunleaf", "bakery", -9, 7, 2, 6, 22)
node("n_water_fountain", "water", "plaza", 0, 13, 1000, 6000, 6)
node("n_water_pond", "water", "pond", 0, -3, 2000, 12000, 6)
node("n_water_bridge", "water", "bridge", 0, 10, 1000, 6000, 8)
node("n_mushroom_tavern", "mushroom_gloom", "tavern", -16, 8, 1, 4, 30)
node("n_mushroom_fisher", "mushroom_gloom", "fisher", 8, 8, 1, 4, 30)
node("n_berry_farm", "berry_red", "farm", 14, 8, 2, 8, 30, { research = "craftsman" })
node("n_wood_mill", "wood_log", "windmill", 16, 10, 1, 6, 25, { research = "craftsman" })
node("n_stone_mill", "stone", "windmill", -16, 10, 2, 8, 25, { research = "craftsman" })
node("n_sand_pond", "sand", "pond", 12, 5, 2, 8, 25, { research = "craftsman" })
node("n_charcoal_smithy", "fuel_charcoal", "smithy", -12, 8, 2, 8, 30, { research = "craftsman" })
node("n_copper_tower", "ore_copper", "watchtower", 14, 6, 2, 8, 35, { quest = "q11" })
node("n_iron_tower", "ore_iron", "watchtower", -14, 6, 2, 8, 35, { quest = "q11" })
node("n_crystal_tower", "crystal_raw", "watchtower", 0, 18, 1, 4, 45, { research = "rune_study" })
node("n_crystal_chapel", "crystal_raw", "chapel", 16, 8, 1, 4, 45, { research = "rune_study" })
node("n_moonleaf_chapel", "herb_moonleaf", "chapel", -16, 8, 2, 6, 40, { research = "moonbotany" })
node("n_seed_mint_farm", "seed_mint", "farm", -12, 8, 1, 3, 60, { research = "farming" })
node("n_seed_sun_farm", "seed_sunleaf", "farm", -16, 12, 1, 3, 60, { research = "farming" })
return L
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000015"><Properties><string name="Name">Machines</string><ProtectedString name="Source"><![CDATA[-- Placeable workshop entities: machines, storage and logistics.
-- Footprints are in grid cells (1 cell = 2 studs). Local frame: +z = front, +x = right.
-- Directions: 0 = +z (front), 1 = +x (right), 2 = -z (back), 3 = -x (left).
-- kind: machine | pump | crate | shelf | belt | turn | hopper | splitter | merger | sorter | pipe | tank | lift | gate
local M = {}
local function ports(w, d, fluidIn, fluidOut)
	local cx, cz = math.floor((w - 1) / 2), math.floor((d - 1) / 2)
	local p = { { id = "in", type = "solid", mode = "in", x = cx, z = 0, dir = 2 },
		{ id = "out", type = "solid", mode = "out", x = cx, z = d - 1, dir = 0 } }
	if fluidIn then p[#p + 1] = { id = "fin", type = "fluid", mode = "in", x = 0, z = cz, dir = 3 } end
	if fluidOut then p[#p + 1] = { id = "fout", type = "fluid", mode = "out", x = w - 1, z = cz, dir = 1 } end
	return p
end
local function machine(id, name, tier, cost, w, d, research, opt)
	opt = opt or {}
	M[id] = { id = id, name = name, kind = opt.kind or "machine", tier = tier, cost = cost, w = w, d = d,
		layer = "machine", research = research, ports = ports(w, d, opt.fluidIn, opt.fluidOut),
		usesFuel = opt.usesFuel, buildLimit = opt.buildLimit, modelAssetId = "mach_" .. id,
		category = opt.category or "machine" }
end
machine("kettle", "Braukessel", 0, 0, 2, 2, "starter_alchemy", { fluidIn = true, buildLimit = 1 })
machine("grinder", "Kräutermühle", 1, 45, 2, 2, "herbalism")
machine("saw", "Sägebank", 1, 55, 3, 2, "craftsman")
machine("crusher", "Stampfwerk", 1, 65, 2, 2, "craftsman")
machine("furnace", "Schmelzofen", 1, 110, 3, 2, "glassworks", { usesFuel = true })
machine("glassbench", "Glasbläsertisch", 1, 65, 2, 2, "glassworks")
machine("extractor", "Extraktor", 2, 170, 3, 2, "essence_craft", { fluidIn = true, fluidOut = true })
machine("bottler", "Abfüller", 2, 135, 2, 2, "essence_craft", { fluidIn = true })
machine("mixer", "Mischwerk", 2, 165, 2, 2, "fruit_mixing", { fluidIn = true, fluidOut = true })
machine("runetable", "Runentisch", 2, 250, 3, 3, "rune_study")
machine("forge", "Esse", 3, 300, 3, 3, "smithing", { usesFuel = true })
machine("enchanter", "Verzauberungspult", 3, 420, 3, 3, "enchantment", { fluidIn = true })
machine("infuser", "Infusor", 4, 600, 3, 3, "infusion")
machine("crystal_refiner", "Kristallschleifer", 4, 680, 3, 3, "crystal_mastery")
machine("advanced_cauldron", "Meisterkessel", 5, 1200, 4, 4, "arcane_depths", { fluidIn = true })
machine("herb_grower", "Kräuterbeet", 2, 210, 3, 3, "farming", { fluidIn = true })
machine("quarry_drill", "Erzbohrer", 3, 750, 3, 3, "licensed_mining", { usesFuel = true, buildLimit = 2 })
M.well_pump = { id = "well_pump", name = "Brunnenpumpe", kind = "pump", tier = 2, cost = 160, w = 2, d = 2,
	layer = "machine", research = "water_engineering", buildLimit = 4, modelAssetId = "mach_well_pump",
	category = "machine", fluid = "water",
	ports = { { id = "fout", type = "fluid", mode = "out", x = 1, z = 0, dir = 1 } } }

local function logi(id, name, kind, tier, cost, research, extra)
	local e = { id = id, name = name, kind = kind, tier = tier, cost = cost, w = 1, d = 1, layer = "belt",
		research = research, modelAssetId = "logi_" .. id, category = "transport", ports = {} }
	if extra then for k, v in pairs(extra) do e[k] = v end end
	M[id] = e
end
local IN_B = { id = "in", type = "solid", mode = "in", x = 0, z = 0, dir = 2 }
local IN_L = { id = "inl", type = "solid", mode = "in", x = 0, z = 0, dir = 3 }
local IN_R = { id = "inr", type = "solid", mode = "in", x = 0, z = 0, dir = 1 }
local OUT_F = { id = "out", type = "solid", mode = "out", x = 0, z = 0, dir = 0 }
local OUT_L = { id = "outl", type = "solid", mode = "out", x = 0, z = 0, dir = 3 }
local OUT_R = { id = "outr", type = "solid", mode = "out", x = 0, z = 0, dir = 1 }
logi("wooden_belt", "Holzförderband", "belt", 2, 4, "belt_basics", { ports = { IN_B, IN_L, IN_R, OUT_F } })
logi("belt_turn", "Bandkurve", "belt", 2, 5, "belt_basics", { ports = { IN_B, OUT_L } })
logi("input_hopper", "Entnahmetrichter", "hopper", 2, 20, "belt_basics", { ports = { OUT_F } })
logi("splitter", "Verteiler", "splitter", 2, 40, "flow_control", { ports = { IN_B, OUT_F, OUT_L, OUT_R } })
logi("merger", "Zusammenführer", "merger", 2, 40, "flow_control", { ports = { IN_B, IN_L, IN_R, OUT_F } })
logi("filter_sorter", "Filtersortierer", "sorter", 3, 90, "smart_sorting", { ports = { IN_B, OUT_F, OUT_L } })
logi("vertical_lift", "Lastenaufzug", "lift", 3, 150, "multi_floor", { ports = { IN_B, OUT_F } })
logi("magical_gate", "Magisches Tor", "gate", 5, 600, "portal_logistics", { ports = { IN_B, OUT_F }, buildLimit = 8 })
logi("pipe_straight", "Rohr", "pipe", 3, 6, "pipe_networks", { layer = "pipe", category = "transport" })
logi("pipe_bend", "Rohrbogen", "pipe", 3, 6, "pipe_networks", { layer = "pipe", category = "transport" })
M.fluid_tank = { id = "fluid_tank", name = "Flüssigkeitstank", kind = "tank", tier = 3, cost = 120, w = 2, d = 2,
	layer = "machine", research = "pipe_networks", ports = {}, capacity = 16000, modelAssetId = "logi_fluid_tank",
	category = "storage" }
M.storage_crate = { id = "storage_crate", name = "Lagerkiste", kind = "crate", tier = 0, cost = 25, w = 2, d = 2,
	layer = "machine", research = "starter_alchemy", ports = {}, slots = 30, modelAssetId = "logi_storage_crate",
	category = "storage" }
M.shop_shelf = { id = "shop_shelf", name = "Verkaufsregal", kind = "shelf", tier = 0, cost = 40, w = 3, d = 1,
	layer = "machine", research = "starter_alchemy", ports = {}, slots = 8, buildLimit = 3,
	modelAssetId = "logi_shop_shelf", category = "storage" }
return M
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000016"><Properties><string name="Name">MarketCatalog</string><ProtectedString name="Source"><![CDATA[-- Market NPCs run the five existing stalls. Prices and bundle sizes are server-owned.
local Market = { order = { "selma", "nyra", "lio", "aron", "esme" }, radius = 12 }
Market.merchants = {
	selma = {
		name = "Selma Wurzelbund", trade = "Kräuter und Saat", color = "4F8A55",
		line = "Frische Kräuter für den Kessel. Die Saat ist fürs eigene Beet.",
		stall = "market_stall_fruit", occurrence = 1,
		offers = {
			{ item = "herb_mint", amount = 2, coins = 26 },
			{ item = "herb_sunleaf", amount = 2, coins = 32 },
			{ item = "berry_red", amount = 2, coins = 48, unlock = { research = "craftsman" } },
			{ item = "seed_mint", amount = 1, coins = 24, unlock = { research = "farming" } },
			{ item = "seed_sunleaf", amount = 1, coins = 29, unlock = { research = "farming" } },
		},
	},
	nyra = {
		name = "Nyra Dämmerhut", trade = "Nachtflora und Rohkristalle", color = "6F4E7C",
		line = "Dämmerpilze vertragen keinen Mittag. Bei den Kristallen ist das anders.",
		stall = "market_stall_cloth", occurrence = 1,
		offers = {
			{ item = "mushroom_gloom", amount = 1, coins = 32 },
			{ item = "crystal_raw", amount = 1, coins = 58, unlock = { research = "rune_study" } },
			{ item = "herb_moonleaf", amount = 2, coins = 44, unlock = { research = "moonbotany" } },
		},
	},
	lio = {
		name = "Lio Glasfunke", trade = "Glassand und Phiolen", color = "3D6FA5",
		line = "Sand für den Ofen. Phiolen, wenn die Abfüllung schon wartet.",
		stall = "market_stall_cloth", occurrence = 2,
		offers = {
			{ item = "sand", amount = 4, coins = 20, unlock = { research = "craftsman" } },
			{ item = "vial", amount = 4, coins = 32, unlock = { research = "glassworks" } },
		},
	},
	aron = {
		name = "Aron Glutbart", trade = "Erz und Brennstoff", color = "B5482F",
		line = "Kohle für die Glut. Kupfer und Eisen kommen vom Wachturm.",
		stall = "market_stall_bread", occurrence = 1,
		offers = {
			{ item = "fuel_charcoal", amount = 4, coins = 24, unlock = { research = "craftsman" } },
			{ item = "ore_copper", amount = 2, coins = 34, unlock = { quest = "q11" } },
			{ item = "ore_iron", amount = 2, coins = 42, unlock = { quest = "q11" } },
		},
	},
	esme = {
		name = "Esme Eichenmaß", trade = "Holz und Stein", color = "3F7F7A",
		line = "Gerades Holz für die Säge, sauberer Stein fürs Stampfwerk.",
		stall = "market_stall_fruit", occurrence = 2,
		offers = {
			{ item = "wood_log", amount = 2, coins = 18, unlock = { research = "craftsman" } },
			{ item = "stone", amount = 4, coins = 20, unlock = { research = "craftsman" } },
		},
	},
}

function Market.anchors(layout)
	local anchors, counts, byStall = {}, {}, {}
	if not layout then return anchors end
	for _, id in ipairs(Market.order) do
		local def = Market.merchants[id]
		byStall[def.stall .. "#" .. def.occurrence] = id
	end
	for index, row in ipairs(layout.instances) do
		if layout.groupNames[row[7]] == "market" then
			local name = layout.assetNames[row[1]]
			counts[name] = (counts[name] or 0) + 1
			local id = byStall[name .. "#" .. counts[name]]
			if id then
				local yaw = math.rad(row[5])
				local fx, fz = math.sin(yaw), math.cos(yaw)
				anchors[id] = { x = row[2], y = row[3], z = row[4], yaw = row[5], index = index,
					approachX = row[2] + fx * 4.4, approachZ = row[4] + fz * 4.4 }
			end
		end
	end
	return anchors
end

function Market.near(anchor, playerPosition)
	if not anchor or not playerPosition then return false end
	local dx, dz = anchor.approachX - playerPosition.x, anchor.approachZ - playerPosition.z
	return dx * dx + dz * dz <= Market.radius * Market.radius
end

return Market
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000017"><Properties><string name="Name">MarketIdle</string><ProtectedString name="Source"><![CDATA[local Motion = require(script.Parent.MarketMotion)
local Idle = {}

function Idle.sample(track, seconds)
	local offset = seconds % Motion.duration * (#track - 1) / Motion.duration
	local index = math.floor(offset) + 1
	local a, b = track[index], track[math.min(index + 1, #track)]
	local alpha = offset - math.floor(offset)
	local dot = a[1] * b[1] + a[2] * b[2] + a[3] * b[3] + a[4] * b[4]
	local sign = dot < 0 and -1 or 1
	local x = a[1] * (1 - alpha) + b[1] * alpha * sign
	local y = a[2] * (1 - alpha) + b[2] * alpha * sign
	local z = a[3] * (1 - alpha) + b[3] * alpha * sign
	local w = a[4] * (1 - alpha) + b[4] * alpha * sign
	local length = math.sqrt(x*x + y*y + z*z + w*w)
	return x / length, y / length, z / length, w / length
end

return Idle
]]></ProtectedString></Properties></Item>
