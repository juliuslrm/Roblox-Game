<Item class="StarterPlayer" referent="RBX000072"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX000071"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX000070"><Properties><string name="Name">ArcaneClient</string></Properties><Item class="LocalScript" referent="RBX000065"><Properties><string name="Name">Bootstrap</string><ProtectedString name="Source"><![CDATA[-- ROBLOX CLIENT (UNVERIFIED_IN_STUDIO): HUD, panels and build mode of Arcane Village.
-- Mobile first: large touch targets, one panel at a time, everything reachable without a keyboard.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local Shared = ReplicatedStorage:WaitForChild("ArcaneShared")
local Items = require(Shared.Items)
local Recipes = require(Shared.Recipes)
local Machines = require(Shared.Machines)
local Research = require(Shared.Research)
local Quests = require(Shared.Quests)
local Locations = require(Shared.Locations)
local Market = require(Shared.MarketCatalog)
local Config = require(Shared.Config)
local Grid = require(Shared.GridMath)
local Net = require(script.Parent:WaitForChild("NetworkClient"))
local MachineWindow = require(script.Parent:WaitForChild("MachineWindow"))
local Ports = require(Shared.MachinePorts)
local BeltPath = require(Shared.BeltPath)
local player = Players.LocalPlayer

local C = { cream = Color3.fromRGB(241, 235, 221), ink = Color3.fromRGB(35, 32, 31), brass = Color3.fromRGB(201, 154, 60),
	wood = Color3.fromRGB(91, 58, 38), ok = Color3.fromRGB(79, 138, 85), warn = Color3.fromRGB(206, 122, 59),
	bad = Color3.fromRGB(193, 67, 59), dim = Color3.fromRGB(138, 127, 115) }

-- ---------------------------------------------------------------- widgets
local gui = Instance.new("ScreenGui")
gui.Name, gui.ResetOnSpawn, gui.IgnoreGuiInset = "ArcaneUI", false, false
gui.Parent = player:WaitForChild("PlayerGui")
local scale = Instance.new("UIScale")
scale.Parent = gui
local function rescale()
	local cam = workspace.CurrentCamera
	if cam then scale.Scale = math.clamp(math.min(cam.ViewportSize.X / 1280, cam.ViewportSize.Y / 720), 0.7, 1.4) end
end
rescale()
RunService.Heartbeat:Connect(rescale)

local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
local function corner(o, r) make("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o) end
local function label(text, parent, size, color, bold)
	return make("TextLabel", { Text = text, Size = size or UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, TextColor3 = color or C.ink,
		Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true, AutomaticSize = Enum.AutomaticSize.Y }, parent)
end
local function button(text, parent, onClick, color)
	local b = make("TextButton", { Text = text, Size = UDim2.new(0, 132, 0, 44), BackgroundColor3 = color or C.brass, TextColor3 = C.ink,
		Font = Enum.Font.GothamBold, TextSize = 15, AutoButtonColor = true, TextWrapped = true }, parent)
	corner(b)
	local busy = false
	b.Activated:Connect(function()
		if busy then return end           -- no double submits while the server answers
		busy = true
		local ok, err = pcall(onClick)
		if not ok then warn(err) end
		busy = false
	end)
	return b
end
local function amount(id, n)
	local it = Items[id]
	if it and it.unit == "ml" then return n .. " ml " .. it.name end
	return n .. " × " .. (it and it.name or id)
end
local function itemList(map)
	local parts = {}
	for id, n in pairs(map or {}) do parts[#parts + 1] = amount(id, n) end
	table.sort(parts)
	return (#parts > 0) and table.concat(parts, ", ") or "–"
end

-- toasts
local toastFrame = make("Frame", { Size = UDim2.new(0, 420, 0, 200), Position = UDim2.new(0.5, -210, 0, 70), BackgroundTransparency = 1 }, gui)
make("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center }, toastFrame)
local function toast(text, color)
	local t = make("TextLabel", { Text = text, Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = color or C.ink, TextColor3 = C.cream,
		Font = Enum.Font.GothamMedium, TextSize = 16, TextWrapped = true }, toastFrame)
	corner(t)
	task.delay(3.5, function() t:Destroy() end)
end
local function send(action, payload)
	local result = Net.send(action, payload)
	local msg = Net.message(result)
	if msg then toast(msg, C.bad) end
	return result
end

-- HUD
local hud = make("Frame", { Size = UDim2.new(0, 300, 0, 132), Position = UDim2.new(0, 12, 0, 12), BackgroundColor3 = C.cream }, gui)
corner(hud, 10)
make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingTop = UDim.new(0, 6), PaddingRight = UDim.new(0, 10) }, hud)
make("UIListLayout", { Padding = UDim.new(0, 2) }, hud)
local hudMoney = label("", hud, nil, C.ink, true)
local hudQuest = label("", hud, nil, C.wood, true)
local hudHint = label("", hud, nil, C.ink)
local hudSave = label("", hud, nil, C.dim)

-- panel host
local panel = make("Frame", { Size = UDim2.new(0, 430, 1, -170), Position = UDim2.new(1, -442, 0, 12), BackgroundColor3 = C.cream, Visible = false }, gui)
corner(panel, 10)
local panelTitle = make("TextLabel", { Size = UDim2.new(1, -60, 0, 40), Position = UDim2.new(0, 12, 0, 4), BackgroundTransparency = 1, Text = "",
	Font = Enum.Font.GothamBold, TextSize = 20, TextColor3 = C.wood, TextXAlignment = Enum.TextXAlignment.Left }, panel)
local scroll = make("ScrollingFrame", { Size = UDim2.new(1, -16, 1, -56), Position = UDim2.new(0, 8, 0, 48), BackgroundTransparency = 1,
	CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 8 }, panel)
make("UIListLayout", { Padding = UDim.new(0, 6) }, scroll)
local current = nil            -- { name, render }
local function closePanel() current = nil panel.Visible = false end
button("X", panel, closePanel, C.bad).Size = UDim2.new(0, 44, 0, 40)
panel:FindFirstChildOfClass("TextButton").Position = UDim2.new(1, -50, 0, 4)

local function clear()
	for _, child in ipairs(scroll:GetChildren()) do
		if not child:IsA("UIListLayout") then child:Destroy() end
	end
end
-- a row: text on the left, optional action button on the right
local function row(text, actionText, onClick, color)
	local f = make("Frame", { Size = UDim2.new(1, -8, 0, 48), BackgroundColor3 = Color3.fromRGB(233, 224, 204), AutomaticSize = Enum.AutomaticSize.Y }, scroll)
	corner(f, 6)
	local l = label(text, f, UDim2.new(1, actionText and -150 or -12, 0, 44), color)
	l.Position = UDim2.new(0, 8, 0, 2)
	if actionText then
		local b = button(actionText, f, onClick)
		b.Position = UDim2.new(1, -138, 0, 2)
	end
	return f
end
local function heading(text) label(text, scroll, UDim2.new(1, -8, 0, 26), C.wood, true) end
-- Short fingerprint of everything the panels show that changes through actions.
local function signature(s)
	local parts = { s.wallet, s.knowledge, s.repPoints, s.questIndex, s.version, tostring(s.inWorkshop),
		s.quest and s.quest.progress or 0, s.project and s.project.progress or 0, s.workshop and s.workshop.version or 0 }
	local ids = {}
	for id in pairs(s.items) do ids[#ids + 1] = id end
	table.sort(ids)
	for _, id in ipairs(ids) do parts[#parts + 1] = id .. "=" .. s.items[id] end
	local n = 0
	for _ in pairs(s.research) do n = n + 1 end
	parts[#parts + 1] = n
	for _, o in ipairs(s.orders or {}) do parts[#parts + 1] = tostring(o.id) end
	for id, c in pairs(s.chains or {}) do parts[#parts + 1] = id .. (c.done or 0) end
	for i = 1, #parts do parts[i] = tostring(parts[i]) end
	return table.concat(parts, "|")
end
local machineWindow                -- created further down; only one window is open at a time
local function open(name, title, render)
	if machineWindow and machineWindow.isOpen() then machineWindow.close() end
	current = { name = name, title = title, render = render, version = Net.snapshot and signature(Net.snapshot), at = os.clock() }
	panelTitle.Text = title
	panel.Visible = true
	clear()
	scroll.CanvasPosition = Vector2.new(0, 0)
	if Net.snapshot then render(Net.snapshot) end
end
-- Panels with running timers; everything else only changes when the game state changes.
local LIVE = { machine = 2, workshop = 2 }
-- The server sends a snapshot every second.  Rebuilding the open panel each time made lists jump
-- back to the top and swallowed taps on buttons that were just being replaced.  Rebuild only when
-- the state changed (or at a slow pace for panels that show timers) and keep the scroll position.
local function refresh(force)
	local s = Net.snapshot
	if not (current and s) then return end
	local age = os.clock() - current.at
	local sig = signature(s)
	if not force and sig == current.version and age < (LIVE[current.name] or 8) then return end
	current.version, current.at = sig, os.clock()
	local keep = scroll.CanvasPosition
	clear()
	current.render(s)
	task.defer(function() scroll.CanvasPosition = keep end)
end

-- ---------------------------------------------------------------- panels
local function renderInventory(s)
	heading("Rohstoffe und Zwischenprodukte")
	local ids = {}
	for id in pairs(s.items) do ids[#ids + 1] = id end
	table.sort(ids)
	for _, id in ipairs(ids) do
		if Items[id].type ~= "product" then row(amount(id, s.items[id])) end
	end
	heading("Produkte")
	for _, id in ipairs(ids) do
		if Items[id].type == "product" then row(amount(id, s.items[id]) .. "   (Wert " .. Items[id].sellBase .. ")") end
	end
	if #ids == 0 then row("Dein Beutel ist leer. Sammle Kräuter am Marktplatz.") end
end

-- Storage and transport parts (crates, shelves, tanks, belts ...) keep the simple list panel;
-- production machines have their own window (MachineWindow.lua).
local selectedUid = nil
local function renderStorage(s)
	local e
	for _, x in ipairs(s.workshop and s.workshop.entities or {}) do if x.uid == selectedUid then e = x end end
	if not e then row("Dieses Bauteil gibt es nicht mehr, oder du stehst nicht in der Werkstatt.") return end
	local def = Machines[e.machine]
	heading("Inhalt")
	local any = false
	local function contents(store, slot, title)
		for id, n in pairs(store or {}) do
			any = true
			row(title .. ": " .. amount(id, n), "Entnehmen", function()
				send("TransferStack", { from = e.uid, to = "inv", item = id, amount = n, slot = slot })
			end)
		end
	end
	contents(e.inv, "in", "Lager") contents(e.fluids, "in", "Flüssigkeit") contents(e.out, "out", "Fertig")
	if e.item then any = true row("Auf dem Band: " .. amount(e.item, 1)) end
	if not any then row("Leer.") end
	if def.kind == "crate" or def.kind == "shelf" or def.kind == "tank" then
		heading("Aus dem Beutel einfüllen")
		for id, n in pairs(s.items) do
			local fits = (def.kind == "crate" and Items[id].unit ~= "ml")
				or (def.kind == "shelf" and Items[id].type == "product")
				or (def.kind == "tank" and Items[id].unit == "ml")
			if fits then
				row(amount(id, n), "Einfüllen", function()
					if def.kind == "shelf" then send("StockShelf", { uid = e.uid, item = id, amount = n })
					else send("TransferStack", { from = "inv", to = e.uid, item = id, amount = n }) end
				end)
			end
		end
	end
	heading("Bauteil")
	row("Drehen (90°)", "Drehen", function() send("RotateMachine", { uid = e.uid }) end)
	row("Abbauen – Inhalt kommt in den Beutel, 60 % der Kosten zurück", "Abbauen", function()
		if send("RemoveMachine", { uid = e.uid }).ok then closePanel() end
	end, C.bad)
end

local Build = { machine = nil, rot = 0, ghost = nil, cell = nil }
local startBuild                   -- defined with the build mode further down
local function renderBuild(s)
	if not s.workshop then row("Bauen kannst du nur in deiner Werkstatt. Folge dem Wegweiser „Deine Werkstatt“ und geh hinein.") return end
	for _, cat in ipairs({ { "machine", "Maschinen" }, { "transport", "Transport" }, { "storage", "Lager" } }) do
		heading(cat[2])
		local ids = {}
		for id, def in pairs(Machines) do if def.category == cat[1] then ids[#ids + 1] = id end end
		table.sort(ids, function(a, b) return Machines[a].cost < Machines[b].cost end)
		for _, id in ipairs(ids) do
			local def = Machines[id]
			if s.research[def.research] then
				row(def.name .. "  –  " .. def.cost .. " Münzen  (" .. def.w * 2 .. "×" .. def.d * 2 .. " Studs)", "Platzieren", function()
					startBuild(id)
					closePanel()
					if Machines[id].kind == "belt" and id ~= "belt_turn" then
						toast("Bandstrecke: Anfang antippen, Ende antippen, ✓ baut. ⟳ kehrt die Richtung um. Am PC: ziehen.", C.wood)
					else
						toast("Tippe auf den Werkstattboden, um den Platz zu wählen. ⟳ dreht, ✓ baut, X bricht ab.", C.wood)
					end
				end)
			else
				row("🔒 " .. def.name .. "\nForschung: " .. Research[def.research].name, nil, nil, C.dim)
			end
		end
	end
end

local function renderResearch(s)
	label("Wissen: " .. s.knowledge .. "   (erforschen in der Markthalle oder in deiner Werkstatt)", scroll, nil, C.wood, true)
	for tier = 1, 5 do
		heading("Stufe " .. tier)
		for id, node in pairs(Research) do
			if node.tier == tier then
				local ready = true
				local needs = {}
				for _, p in ipairs(node.prereqs) do
					if not s.research[p] then ready = false needs[#needs + 1] = Research[p].name end
				end
				local unlocks = {}
				for _, u in ipairs(node.unlocks) do
					unlocks[#unlocks + 1] = (Machines[u] and Machines[u].name) or (Recipes[u] and itemList(Recipes[u].outputs)) or u
				end
				local text = node.name .. "  (" .. node.cost .. " Wissen)\n→ " .. table.concat(unlocks, ", ")
				if s.research[id] then row("✓ " .. text, nil, nil, C.ok)
				elseif not ready then row("🔒 " .. text .. "\nBenötigt: " .. table.concat(needs, ", "), nil, nil, C.dim)
				else row(text, "Erforschen", function() send("UnlockResearch", { research = id }) end) end
			end
		end
	end
end

local function renderOrders(s)
	if s.quest then
		heading("Hauptauftrag")
		local o = s.quest.objective
		if o.type == "deliver" then
			row(s.quest.title .. "\n" .. s.quest.hint, "Abgeben", function() send("ClaimOrder", { kind = "main", id = s.quest.id }) end)
		else
			row(s.quest.title .. "\n" .. s.quest.hint)
		end
	end
	heading("Auftragstafel der Markthalle")
	for _, o in ipairs(s.orders) do
		row(o.title .. "\n" .. itemList(o.items) .. "  →  " .. o.coins .. " Münzen, " .. o.rep .. " Ruf", "Abgeben", function()
			send("ClaimOrder", { kind = "order", id = o.id })
		end)
	end
	heading("Dorfbewohner")
	for id, c in pairs(s.chains) do
		if c.step then
			local where = Locations.locations[c.at].name
			if c.unlocked then
				row(c.name .. " (" .. c.done .. "/" .. c.total .. ") – " .. where .. "\n" .. c.step.title .. ": " .. itemList(c.step.items), "Abgeben", function()
					send("ClaimOrder", { kind = "chain", id = id })
				end)
			else
				row("🔒 " .. c.name .. " – " .. where, nil, nil, C.dim)
			end
		else
			row("✓ " .. c.name, nil, nil, C.ok)
		end
	end
	if s.project then
		heading("Dorfprojekt (diese Server-Sitzung)")
		local p = s.project
		row(p.title .. "\n" .. p.progress .. " / " .. p.count .. " " .. Items[p.item].name .. (p.done and "  – fertig!" or ""),
			(not p.done) and "Spenden" or nil, function() send("DonateProject", { amount = 1 }) end)
	end
end

local function renderWorkshop(s)
	local w = s.workshop
	if not w then row("Du bist nicht in einer Werkstatt. Folge dem Wegweiser „Deine Werkstatt“ und geh hinein.") return end
	heading("Betrieb")
	row(string.format("Durchsatz: %.1f Teile pro Minute (letzte Minute)", w.ratePerMin))
	row("Im Regal: " .. itemList(w.stock) .. string.format("\nNächster Kunde in etwa %d s", math.max(0, math.ceil(w.nextCustomerIn))))
	heading("Ausbau")
	local nextPlot = Config.plotTiers[w.sizeTier + 1]
	if nextPlot then
		row("Grundfläche " .. nextPlot.cells * 2 .. "×" .. nextPlot.cells * 2 .. " Studs – " .. nextPlot.cost .. " Münzen", "Kaufen", function() send("BuyUpgrade", { kind = "plot" }) end)
	end
	local nextFloor = Config.floors[w.floors + 1]
	if nextFloor then
		row("Etage " .. (w.floors + 1) .. " – " .. nextFloor.cost .. " Münzen", "Kaufen", function() send("BuyUpgrade", { kind = "floor" }) end)
	end
end

-- ---------------------------------------------------------------- action bar
local bar = make("Frame", { Size = UDim2.new(0, 700, 0, 52), Position = UDim2.new(0.5, -350, 1, -64), BackgroundTransparency = 1 }, gui)
make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center }, bar)
button("Beutel", bar, function() open("inv", "Beutel", renderInventory) end)
button("Bauen", bar, function() open("build", "Baukatalog", renderBuild) end)
button("Forschung", bar, function() open("research", "Forschung", renderResearch) end)
button("Aufträge", bar, function() open("orders", "Aufträge", renderOrders) end)
button("Werkstatt", bar, function() open("workshop", "Werkstatt", renderWorkshop) end)

-- ---------------------------------------------------------------- build mode (ghost on the grid)
local confirm = make("Frame", { Size = UDim2.new(0, 220, 0, 56), Position = UDim2.new(0.5, -110, 1, -130), BackgroundTransparency = 1, Visible = false }, gui)
make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }, confirm)
-- Marks at the connections of the machines (made invisible by the server): shown while building
-- and while a machine window is open.
local marksShown = false
local function showPortMarks(on)
	if on == marksShown then return end
	marksShown = on
	local root = workspace:FindFirstChild("ArcaneWorkshops")
	if not root then return end
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("ArcanePortMark") then
			d.Transparency = on and 0.1 or 1
			local label = d:FindFirstChild("PortLabel")
			if label then label.Enabled = on end
		end
	end
end
workspace.DescendantAdded:Connect(function(d)
	if marksShown and d:IsA("BasePart") then
		task.defer(function()
			if marksShown and d:GetAttribute("ArcanePortMark") then
				d.Transparency = 0.1
				local label = d:FindFirstChild("PortLabel")
				if label then label.Enabled = true end
			end
		end)
	end
end)

local clearLine                                   -- defined with the line building below
local function stopBuild()
	if clearLine then clearLine() end
	Build.machine, Build.pointer, Build.cell = nil, nil, nil
	if Build.ghost then Build.ghost:Destroy() Build.ghost = nil end
	confirm.Visible = false
	showPortMarks(machineWindow ~= nil and machineWindow.isOpen())
end
local function placeGhost()
	if not (Build.machine and Build.cell) then return end
	local c = Build.cell
	local result = send("PlaceMachine", { machine = Build.machine, gx = c.gx, gz = c.gz, floor = c.floor, rot = Build.rot })
	if result.ok then toast(Machines[Build.machine].name .. " gebaut", C.ok) end
end
local onRotate, onConfirm, onCancel             -- defined with the line building below
button("⟳", confirm, function() onRotate() end).Size = UDim2.new(0, 64, 0, 52)
button("✓", confirm, function() onConfirm() end, C.ok).Size = UDim2.new(0, 64, 0, 52)
button("X", confirm, function() onCancel() end, C.bad).Size = UDim2.new(0, 64, 0, 52)

-- Grid direction (0 = +z, 1 = +x, 2 = -z, 3 = -x) that lies to the right of the current view.
-- The workshop grid is aligned with the world axes.
local function rightOfView()
	local cam = workspace.CurrentCamera
	local right = cam and cam.CFrame.RightVector or Vector3.new(1, 0, 0)
	local best, bestDot = 1, -math.huge
	for dir = 0, 3 do
		local dot = right.X * Grid.DX[dir] + right.Z * Grid.DZ[dir]
		if dot > bestDot then best, bestDot = dir, dot end
	end
	return best
end
-- Starts placing a part.  Conveyors start pointing to the right as the player sees it at this
-- moment; the direction is then kept until the player turns it, whatever the camera does.
startBuild = function(id)
	local def = Machines[id]
	local conveyor = def.category == "transport" and def.layer ~= "pipe"
	Build.machine, Build.pointer, Build.cell = id, nil, nil
	Build.rot = conveyor and rightOfView() or 0
	if Build.ghost then Build.ghost:Destroy() Build.ghost = nil end
	showPortMarks(true)
end

local function pointerPosition()
	if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		-- touch: the last spot tapped on the floor; before the first tap the screen centre
		if Build.pointer then return Build.pointer end
		local cam = workspace.CurrentCamera
		return Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
	end
	return UserInputService:GetMouseLocation()
end
-- First workshop floor under a screen point.  The ray passes the own character (which stands in the
-- middle of the screen on a phone), machines and walls.
local function floorUnder(pos)
	local cam = workspace.CurrentCamera
	local ray = cam:ViewportPointToRay(pos.X, pos.Y)
	local ignore = { Build.ghost, player.Character }
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local from = ray.Origin
	for _ = 1, 8 do
		params.FilterDescendantsInstances = ignore
		local hit = workspace:Raycast(from, ray.Direction * 500, params)
		if not hit then return nil end
		if hit.Instance:GetAttribute("ArcaneFloor") then return hit end
		ignore[#ignore + 1] = hit.Instance
	end
	return nil
end

-- ghost: footprint box plus arrows that show exactly what the placed part will do
local GHOST_IN, GHOST_OUT = Color3.fromRGB(63, 138, 106), Color3.fromRGB(201, 154, 60)
local function ghostArrow(name, color, text)
	local folder = make("Folder", { Name = name }, Build.ghost)
	local pieces = {}
	for i = 1, 3 do
		pieces[i] = make("Part", { Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
			Material = Enum.Material.SmoothPlastic, Color = color, Size = (i == 1) and Vector3.new(0.3, 0.14, 1.3) or Vector3.new(0.3, 0.14, 0.75) }, folder)
	end
	if text then
		local gui = make("BillboardGui", { Size = UDim2.new(0, 96, 0, 22), StudsOffset = Vector3.new(0, 1.2, 0), AlwaysOnTop = true }, pieces[1])
		local label = make("TextLabel", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = color, BackgroundTransparency = 0.1, Text = text,
			TextColor3 = C.cream, Font = Enum.Font.GothamBold, TextScaled = true }, gui)
		corner(label, 6)
	end
	return pieces
end
local function aimArrow(pieces, tip, dir)
	local look = CFrame.lookAt(tip, tip + dir)
	pieces[1].CFrame = look * CFrame.new(0, 0, 0.85)
	pieces[2].CFrame = look * CFrame.Angles(0, math.rad(140), 0) * CFrame.new(0, 0, -0.3)
	pieces[3].CFrame = look * CFrame.Angles(0, math.rad(-140), 0) * CFrame.new(0, 0, -0.3)
end

-- ---------------------------------------------------------------- belt lines
-- Belts are laid as whole lines: first cell, last cell, and the line runs between them (one corner
-- at most, the corner belt takes the goods in from its side).  Mouse: press on the first cell, drag,
-- release.  Touch: tap the first cell, tap the last cell (tap again to move it), then ✓.
-- ⟳ reverses the flow of a line (a single belt turns), X drops the line (or leaves building).
local function lineCapable(id) local def = Machines[id] return def and def.kind == "belt" and id ~= "belt_turn" end
local Line = { start = nil, flip = false, pool = {}, folder = nil, label = nil, plan = nil, hover = nil }
local function cellAt(s, hit)
	local cs = Config.cellSize
	local half = s.workshop.cells * cs / 2
	return { gx = math.floor((hit.Position.X - s.room.x + half) / cs), gz = math.floor((hit.Position.Z - s.room.z + half) / cs),
		floor = hit.Instance:GetAttribute("ArcaneFloor") }
end
clearLine = function()
	if Line.folder then Line.folder:Destroy() end
	Line.folder, Line.pool, Line.label, Line.plan, Line.start, Line.flip = nil, {}, nil, nil, nil, false
end
local function lineGhost(i)
	local g = Line.pool[i]
	if g then return g end
	if not Line.folder then Line.folder = make("Folder", { Name = "ArcaneLineGhost" }, workspace) end
	local box = make("Part", { Name = "Cell", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
		Material = Enum.Material.SmoothPlastic, Transparency = 0.5, Size = Vector3.new(Config.cellSize - 0.15, 0.7, Config.cellSize - 0.15) }, Line.folder)
	local arrow = {}
	for k = 1, 3 do
		arrow[k] = make("Part", { Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
			Material = Enum.Material.SmoothPlastic, Color = C.cream, Size = (k == 1) and Vector3.new(0.22, 0.1, 0.9) or Vector3.new(0.22, 0.1, 0.55) }, Line.folder)
	end
	g = { box = box, arrow = arrow }
	Line.pool[i] = g
	return g
end
-- what the line connects to: text for the label, and whether the end really feeds something
local function connections(s, plan)
	local ents = s.workshop.entities
	local function at(floor, x, z)
		for _, e in ipairs(ents) do
			local def = Machines[e.machine]
			if e.floor == floor and def.layer ~= "pipe" then
				local w, d = Grid.size(def, e.rot)
				if x >= e.gx and x < e.gx + w and z >= e.gz and z < e.gz + d then return e, def end
			end
		end
	end
	local first, last = plan.cells[1], plan.cells[#plan.cells]
	local floor = plan.floor
	local text = {}
	-- end: the cell the last belt hands to
	local nx, nz = last.gx + Grid.DX[last.rot], last.gz + Grid.DZ[last.rot]
	local e, def = at(floor, nx, nz)
	if e then
		if def.kind == "crate" or def.kind == "shelf" then
			text[#text + 1] = "→ " .. def.name
		elseif Ports.isMachine(def) then
			local inSide = e.inSide or Ports.DEFAULT_IN
			local px, pz, pdir = Ports.cell(def, e, inSide)
			if px + Grid.DX[pdir] == last.gx and pz + Grid.DZ[pdir] == last.gz and (pdir + 2) % 4 == last.rot then
				text[#text + 1] = "→ " .. def.name .. " · Einlauf ✓"
			else
				text[#text + 1] = "⚠ " .. def.name .. ": hier ist kein Einlauf"
			end
		elseif def.category == "transport" then
			text[#text + 1] = "→ " .. def.name
		end
	end
	-- start: something that feeds the first belt
	for _, o in ipairs(ents) do
		local odef = Machines[o.machine]
		if o.floor == floor and Ports.isMachine(odef) then
			local _, outSide = Ports.sides(odef, o)
			local px, pz, pdir = Ports.cell(odef, o, outSide)
			if px + Grid.DX[pdir] == first.gx and pz + Grid.DZ[pdir] == first.gz then
				table.insert(text, 1, "← " .. odef.name .. " · Auslauf")
			end
		elseif o.floor == floor and odef.kind == "hopper" then
			local f = o.rot % 4
			if o.gx + Grid.DX[f] == first.gx and o.gz + Grid.DZ[f] == first.gz then table.insert(text, 1, "← " .. odef.name) end
		end
	end
	return table.concat(text, "\n")
end
local function lineFrame(s)
	local hit = floorUnder(pointerPosition())
	if not hit then return end
	local cell = cellAt(s, hit)
	Line.hover = cell
	local start = Line.start or cell
	local cells = BeltPath.cells(start.gx, start.gz, cell.gx, cell.gz, Build.rot, Line.flip)
	if not cells then return end
	local plan = { floor = start.floor, cells = cells }
	Line.plan = plan
	local cs = Config.cellSize
	local half = s.workshop.cells * cs / 2
	local floorY = s.room.y + (plan.floor - 1) * Config.floorHeight
	local taken = {}
	for _, e in ipairs(s.workshop.entities) do
		local def = Machines[e.machine]
		if e.floor == plan.floor and def.layer ~= "pipe" then
			for _, c in ipairs(Grid.cells(def, e.gx, e.gz, e.rot)) do taken[c[1] .. ":" .. c[2]] = true end
		end
	end
	local blocked = 0
	for i, c in ipairs(cells) do
		local g = lineGhost(i)
		local bad = c.gx < 0 or c.gz < 0 or c.gx >= s.workshop.cells or c.gz >= s.workshop.cells or taken[c.gx .. ":" .. c.gz]
			or BeltPath.reserved(s.workshop.cells, Config.door.width, Config.door.depth, plan.floor, c.gx, c.gz)
		if bad then blocked = blocked + 1 end
		local centre = Vector3.new(s.room.x - half + (c.gx + 0.5) * cs, floorY + 0.35, s.room.z - half + (c.gz + 0.5) * cs)
		g.box.CFrame, g.box.Color, g.box.Transparency = CFrame.new(centre), bad and C.bad or C.ok, 0.5
		local dir = Vector3.new(Grid.DX[c.rot], 0, Grid.DZ[c.rot])
		local tip = centre + Vector3.new(0, 0.4, 0) + dir * 0.55
		local look = CFrame.lookAt(tip, tip + dir)
		g.arrow[1].CFrame = look * CFrame.new(0, 0, 0.5)
		g.arrow[2].CFrame = look * CFrame.Angles(0, math.rad(140), 0) * CFrame.new(0, 0, -0.22)
		g.arrow[3].CFrame = look * CFrame.Angles(0, math.rad(-140), 0) * CFrame.new(0, 0, -0.22)
		for _, a in ipairs(g.arrow) do a.Transparency = 0 end
	end
	for i = #cells + 1, #Line.pool do
		local g = Line.pool[i]
		g.box.Transparency = 1
		for _, a in ipairs(g.arrow) do a.Transparency = 1 end
	end
	-- label over the last belt: count, price, what it connects
	local last = Line.pool[#cells].box
	if not Line.label then
		Line.label = make("BillboardGui", { Size = UDim2.new(0, 230, 0, 64), StudsOffset = Vector3.new(0, 3, 0), AlwaysOnTop = true }, last)
		local t = make("TextLabel", { Name = "Text", Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = C.ink, BackgroundTransparency = 0.15,
			TextColor3 = C.cream, Font = Enum.Font.GothamBold, TextScaled = true, Text = "" }, Line.label)
		corner(t, 8)
		make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }, t)
	end
	Line.label.Adornee, Line.label.Parent = last, last
	local cost = #cells * Machines[Build.machine].cost
	local head = string.format("%d %s · %d Münzen", #cells, #cells == 1 and "Band" or "Bänder", cost)
	if blocked > 0 then head = head .. " · " .. blocked .. " blockiert" end
	if cost > s.wallet then head = head .. " · zu teuer" end
	local info = connections(s, plan)
	Line.label.Text.Text = (info ~= "") and (head .. "\n" .. info) or head
	Line.label.Text.TextColor3 = (blocked > 0 or cost > s.wallet) and Color3.fromRGB(255, 190, 170) or C.cream
end
local function placeLine()
	local plan = Line.plan
	if not (Build.machine and plan) then return end
	local result = send("PlaceBelts", { machine = Build.machine, floor = plan.floor, cells = plan.cells })
	if result.ok then
		toast(#plan.cells == 1 and "Band gebaut" or (#plan.cells .. " Bänder gebaut"), C.ok)
		Line.start, Line.flip = nil, false
	elseif result.payload and result.payload.index then
		toast("Band " .. result.payload.index .. " der Strecke ist blockiert", C.bad)
	end
end
onRotate = function()
	if Build.machine and lineCapable(Build.machine) and Line.start then Line.flip = not Line.flip
	else Build.rot = (Build.rot + 1) % 4 end
end
onConfirm = function()
	if Build.machine and lineCapable(Build.machine) then placeLine() else placeGhost() end
end
onCancel = function()
	if Line.start then Line.start, Line.flip = nil, false else clearLine() stopBuild() end
end
UserInputService.TouchTapInWorld:Connect(function(position, processed)
	if not Build.machine or processed then return end
	Build.pointer = position
	-- belts: the first tap fixes the start of the line, every further tap moves its end
	if lineCapable(Build.machine) and not Line.start then
		local s = Net.snapshot
		local hit = s and s.workshop and s.room and floorUnder(position)
		if hit then Line.start = cellAt(s, hit) end
	end
end)

RunService.RenderStepped:Connect(function()
	local s = Net.snapshot
	if not (Build.machine and s and s.workshop and s.room) then
		if Build.machine or Build.ghost then stopBuild() end
		if Line.folder then clearLine() end
		return
	end
	confirm.Visible = true
	if lineCapable(Build.machine) then
		if Build.ghost then Build.ghost:Destroy() Build.ghost = nil end
		lineFrame(s)
		return
	elseif Line.folder then
		clearLine()
	end
	local hit = floorUnder(pointerPosition())
	if not hit then return end
	local def = Machines[Build.machine]
	local w, d = Grid.size(def, Build.rot)
	local cs = Config.cellSize
	local half = s.workshop.cells * cs / 2
	local gx = math.floor((hit.Position.X - s.room.x + half) / cs)
	local gz = math.floor((hit.Position.Z - s.room.z + half) / cs)
	local floor = hit.Instance:GetAttribute("ArcaneFloor")
	Build.cell = { gx = gx, gz = gz, floor = floor }
	if not Build.ghost or Build.ghostFor ~= Build.machine then
		if Build.ghost then Build.ghost:Destroy() end
		Build.ghost = make("Part", { Anchored = true, CanCollide = false, CanQuery = false, Transparency = 0.55, Material = Enum.Material.SmoothPlastic,
			Color = C.ok, Name = "ArcaneGhost" }, workspace)
		Build.ghostFor, Build.arrows = Build.machine, {}
		if Ports.isMachine(def) then
			Build.arrows.inlet = ghostArrow("In", GHOST_IN, "Einlauf")
			Build.arrows.outlet = ghostArrow("Out", GHOST_OUT, "Auslauf")
		elseif def.category == "transport" and def.layer ~= "pipe" then
			Build.arrows.flow = ghostArrow("Flow", GHOST_OUT, nil)
		end
	end
	local floorY = s.room.y + (floor - 1) * Config.floorHeight
	local function cellCentre(x, z)
		return Vector3.new(s.room.x - half + (x + 0.5) * cs, floorY, s.room.z - half + (z + 0.5) * cs)
	end
	Build.ghost.Size = Vector3.new(w * cs, 3, d * cs)
	Build.ghost.Position = Vector3.new(s.room.x - half + gx * cs + w * cs / 2, floorY + 1.5, s.room.z - half + gz * cs + d * cs / 2)
	local ghostEntity = { gx = gx, gz = gz, rot = Build.rot, floor = floor }
	if Build.arrows.inlet then
		-- a new machine starts with the definition's sides: inlet at the back, outlet at the front
		for key, side in pairs({ inlet = Ports.DEFAULT_IN, outlet = Ports.DEFAULT_OUT }) do
			local x, z, dir = Ports.cell(def, ghostEntity, side)
			local out = Vector3.new(Grid.DX[dir], 0, Grid.DZ[dir])
			local at = cellCentre(x, z) + out * cs + Vector3.new(0, 0.2, 0)
			if key == "inlet" then aimArrow(Build.arrows.inlet, at - out * 0.75, -out)
			else aimArrow(Build.arrows.outlet, at + out * 0.75, out) end
		end
	elseif Build.arrows.flow then
		-- the arrow points where goods will actually leave this part
		local outDir = Build.rot % 4
		for _, p in ipairs(def.ports or {}) do
			if p.mode == "out" then outDir = (p.dir + Build.rot) % 4 break end
		end
		local flow = Vector3.new(Grid.DX[outDir], 0, Grid.DZ[outDir])
		aimArrow(Build.arrows.flow, cellCentre(gx, gz) + Vector3.new(0, 3.1, 0) + flow * 0.7, flow)
	end
	-- red when the cells are taken or outside (the server decides in the end)
	local blocked = gx < 0 or gz < 0 or gx + w > s.workshop.cells or gz + d > s.workshop.cells
	for _, e in ipairs(s.workshop.entities) do
		local ew, ed = Grid.size(Machines[e.machine], e.rot)
		if e.floor == floor and Machines[e.machine].layer == def.layer and gx < e.gx + ew and e.gx < gx + w and gz < e.gz + ed and e.gz < gz + d then
			blocked = true
		end
	end
	Build.ghost.Color = blocked and C.bad or C.ok
end)
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not Build.machine then return end
	if input.KeyCode == Enum.KeyCode.R then onRotate()
	elseif input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.X then onCancel()
	elseif input.KeyCode == Enum.KeyCode.Return then onConfirm()
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
		if lineCapable(Build.machine) then Line.start = Line.hover          -- press: first cell of the line
		else placeGhost() end
	end
end)
UserInputService.InputEnded:Connect(function(input)
	-- release: last cell; the line is built at once
	if input.UserInputType == Enum.UserInputType.MouseButton1 and Build.machine and lineCapable(Build.machine) and Line.start then
		placeLine()
		Line.start = nil
	end
end)

-- ---------------------------------------------------------------- prompts, snapshots, notifications
machineWindow = MachineWindow.create({ gui = gui, make = make, corner = corner, send = send, toast = toast, Net = Net,
	onClose = function() showPortMarks(Build.machine ~= nil) end })
ProximityPromptService.PromptTriggered:Connect(function(prompt)
	local uid = prompt.Parent and prompt.Parent:GetAttribute("ArcaneUid")
	if not uid then return end
	local def = Machines[prompt.Parent:GetAttribute("ArcaneMachine")]
	if Ports.isMachine(def) then
		closePanel()
		machineWindow.open(uid)
		showPortMarks(true)
	else
		selectedUid = uid
		open("machine", def.name, renderStorage)
	end
end)
Net.on("OpenMarket", function(id)
	local merchant = Market.merchants[id]
	if not merchant then return end
	local buying = false
	open("market", merchant.name, function(s)
		heading(merchant.trade)
		label(merchant.line, scroll)
		for _, offer in ipairs(merchant.offers) do
			local description = amount(offer.item, offer.amount) .. " · " .. offer.coins .. " Münzen"
			if s.market and s.market[offer.item] then
				row(description, "Kaufen", function()
					if buying then return end
					buying = true
					local result = send("BuyMarketOffer", { merchant = id, item = offer.item })
					buying = false
					if result.ok and result.code == "OK" then
						toast("Gekauft: " .. amount(result.payload.item, result.payload.amount), C.ok)
					end
				end)
			else
				local rule = offer.unlock
				local research = rule and rule.research and Research[rule.research]
				local quest = rule and rule.quest and Quests.main[rule.quest]
				row(description .. "\nFreischalten: " .. (research and research.name or quest and quest.title or "Fortschritt"), nil, nil, C.dim)
			end
		end
	end)
end)
Net.on("OpenLocation", function(id)
	local loc = Locations.locations[id]
	local services = table.concat(loc.services, ",")
	if string.find(services, "research") then open("research", loc.name .. " – Forschung", renderResearch)
	else open("orders", loc.name, renderOrders) end
end)
Net.on("ActionResult", function(result)
	if result.ok and result.payload and result.payload.item then
		toast("+ " .. amount(result.payload.item, result.payload.amount), C.ok)
	else
		local msg = Net.message(result)
		if msg then toast(msg, C.bad) end
	end
end)
Net.on("Status", function(data)
	if data.status == "failed" or data.status == "locked" or data.status == "corrupt" then
		toast("Spielstand konnte nicht geladen werden. Du kannst dich umsehen; bitte später neu verbinden.", C.bad)
	end
end)
Net.on("Saved", function(data)
	hudSave.Text = (data.ok and data.persistent) and "Gespeichert" or "Speichern fehlgeschlagen – wird erneut versucht"
end)

local NOTE = {
	quest_done = function(n) return "Auftrag erledigt: " .. Quests.main[n.quest].title end,
	discovery = function(n) return "Neues Rezept entdeckt: +" .. n.knowledge .. " Wissen" end,
	order_done = function(n) return "Lieferung angenommen: +" .. n.coins .. " Münzen" end,
	chain_step = function() return "Danke für die Lieferung!" end,
	project_done = function() return "Das Dorfprojekt ist fertig!" end,
	visit = function(n) return "Entdeckt: " .. Locations.locations[n.at].name end,
	coop = function(n) return "Werkstatt-Einladung: Rolle " .. n.role end,
}
-- ---------------------------------------------------------------- signposts
-- Two markers that are visible through everything: the own workshop and the place the current
-- main quest sends the player to.  Positions come from the server snapshot.
local function signpost(color)
	local anchor = make("Part", { Name = "ArcaneSignpost", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
		Transparency = 1, Size = Vector3.new(1, 1, 1) }, workspace)
	local board = make("BillboardGui", { Size = UDim2.new(0, 180, 0, 46), AlwaysOnTop = true, MaxDistance = 100000, Enabled = false,
		StudsOffsetWorldSpace = Vector3.new(0, 14, 0) }, anchor)
	local text = make("TextLabel", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = color, BackgroundTransparency = 0.15,
		TextColor3 = C.cream, Font = Enum.Font.GothamBold, TextScaled = true, Text = "" }, board)
	corner(text, 10)
	make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }, text)
	return { anchor = anchor, board = board, text = text, label = "" }
end
local posts = { home = signpost(C.wood), quest = signpost(C.ok) }
local function setPost(post, target, labelText)
	post.board.Enabled = target ~= nil
	if target then
		post.anchor.Position = Vector3.new(target.x, target.y, target.z)
		post.label = labelText
	end
end
local postAcc = 0
RunService.Heartbeat:Connect(function(dt)
	postAcc = postAcc + dt
	if postAcc < 0.25 then return end
	postAcc = 0
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	for _, post in pairs(posts) do
		if post.board.Enabled then
			local distance = root and math.floor((root.Position - post.anchor.Position).Magnitude) or nil
			post.text.Text = distance and (post.label .. "  ·  " .. distance .. " m") or post.label
			-- close by the marker would only be in the way
			post.text.Visible = not distance or distance > 14
		end
	end
end)

Net.onSnapshot(function(s)
	local atHome = s.inWorkshop == s.userId
	local questAtHome = s.guide and s.guide.home
	setPost(posts.home, (not atHome and not questAtHome) and s.home or nil, "Deine Werkstatt")
	setPost(posts.quest, (s.guide and not (questAtHome and atHome)) and s.guide or nil, s.guide and ("Auftrag: " .. s.guide.label) or "")
	hudMoney.Text = s.wallet .. " Münzen   " .. s.knowledge .. " Wissen   Ruf " .. s.repLevel
	if s.quest then
		hudQuest.Text = s.quest.title
		hudHint.Text = s.quest.hint
	else
		hudQuest.Text, hudHint.Text = "Alle Hauptaufträge erledigt", "Baue deine Fabrik weiter aus."
	end
	if s.safeMode then hudSave.Text = "Nur-Ansehen-Modus: Spielstand nicht geladen"
	elseif s.persistent == false then hudSave.Text = "Achtung: Fortschritt wird in dieser Sitzung nicht gespeichert" end
	for _, n in ipairs(s.notes or {}) do
		local f = NOTE[n.kind]
		if f then toast(f(n), C.ok) end
	end
	refresh()
	machineWindow.update(s)
end)
Net.send("RequestSnapshot")
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX000066"><Properties><string name="Name">GoodsAnimator</string><ProtectedString name="Source"><![CDATA[-- ROBLOX CLIENT: draws the goods gliding over the conveyors.
-- The server publishes per conveyor part which item lies on it and since when (attributes Goods*,
-- see WorkshopWorld:syncGoods); GoodsMotion turns that into smooth positions; this script only
-- keeps one model per moving item and sets its CFrame every frame.  Nothing here is replicated.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("ArcaneShared")
local Config = require(Shared.Config)
local GoodsMotion = require(Shared.GoodsMotion)
local ItemArt = require(Shared.ItemArt)
local Icons = require(Shared.ItemIcons)

local RANGE = 160                                   -- studs: conveyors further away are not animated
local motion = GoodsMotion.new(Config.cellSize)
local bodies = {}                                   -- conveyor part -> true
local models = {}                                   -- visual serial -> { item, part }
local holder = Instance.new("Folder")
holder.Name = "ArcaneGoods"
holder.Parent = workspace
local templates = ReplicatedStorage:WaitForChild("ArcaneItemModels", 20)

-- ---- moving cleats on the running surface of the belts ----------------------------------------
-- Each belt in view gets CLEATS thin ridges that run over its surface at the speed of the goods,
-- on the same line (straight or around the curve).  All belts use the same clock, so the ridges
-- of neighbouring belts line up.
local CLEATS, CLEAT_NEAR, CLEAT_FAR = 4, 70, 90
local CLEAT_COLOR = Color3.fromRGB(176, 140, 96)
local belts = {}                                    -- belt part -> { c = carrier data, cleats = { parts } | nil }
local function addBelt(body, c)
	if body:GetAttribute("BeltIn") ~= nil and c.out >= 0 then
		belts[body] = { c = c, inDir = body:GetAttribute("BeltIn") }
	end
end
local function dropCleats(b)
	if b.cleats then
		for _, part in ipairs(b.cleats) do part:Destroy() end
		b.cleats = nil
	end
end
local function moveCleats(now, eye)
	local h = Config.cellSize / 2
	for body, b in pairs(belts) do
		if not body.Parent then
			dropCleats(b)
			belts[body] = nil
		else
			local c = b.c
			local dist = (Vector3.new(c.x, c.y, c.z) - eye).Magnitude
			if dist > CLEAT_FAR then
				dropCleats(b)
			elseif dist < CLEAT_NEAR or b.cleats then
				if not b.cleats then
					b.cleats = {}
					for i = 1, CLEATS do
						local part = Instance.new("Part")
						part.Name = "Cleat"
						part.Size = Vector3.new(1.36, 0.05, 0.12)
						part.Color, part.Material = CLEAT_COLOR, Enum.Material.Wood
						part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch, part.CastShadow = true, false, false, false, false
						part.Parent = holder
						b.cleats[i] = part
					end
				end
				local phase = now / c.period
				for i, part in ipairs(b.cleats) do
					local f = (phase + (i - 1) / CLEATS) % 1
					local x, z, yaw = GoodsMotion.pathPoint(c.x, c.z, h, b.inDir, c.out, f)
					part.CFrame = CFrame.new(x, c.y + 0.025, z) * CFrame.Angles(0, yaw, 0)
				end
			end
		end
	end
end

local function readStatic(body)
	local cell, surface = body:GetAttribute("GoodsCell"), body:GetAttribute("GoodsSurface")
	if typeof(cell) ~= "Vector3" or typeof(surface) ~= "Vector3" then return nil end
	local c = { room = body:GetAttribute("GoodsRoom"), floor = cell.Y, gx = cell.X, gz = cell.Z,
		x = surface.X, y = surface.Y, z = surface.Z, out = body:GetAttribute("GoodsOut") or -1,
		period = body:GetAttribute("GoodsPeriod") or 2, rise = body:GetAttribute("GoodsRise") }
	local nextCell, warp = body:GetAttribute("GoodsNext"), body:GetAttribute("GoodsWarp")
	if typeof(nextCell) == "Vector3" then c.next = { gx = nextCell.X, floor = nextCell.Y, gz = nextCell.Z } end
	if typeof(warp) == "Vector3" then c.warp = { x = warp.X, y = warp.Y, z = warp.Z, out = body:GetAttribute("GoodsWarpOut") or 0 } end
	return c
end
local function readState(body)
	motion:setState(body, body:GetAttribute("GoodsItem"), body:GetAttribute("GoodsAt"), body:GetAttribute("GoodsIn"),
		workspace:GetServerTimeNow())
end
local function add(body)
	if bodies[body] or not body:IsA("BasePart") or body:GetAttribute("GoodsOut") == nil then return end
	local c = readStatic(body)
	if not c then return end
	bodies[body] = true
	motion:setCarrier(body, c)
	addBelt(body, c)
	readState(body)
	for _, name in ipairs({ "GoodsItem", "GoodsAt", "GoodsIn" }) do
		body:GetAttributeChangedSignal(name):Connect(function() readState(body) end)
	end
end
local function remove(body)
	if bodies[body] then
		bodies[body] = nil
		motion:removeCarrier(body)
	end
end
local function scan()
	local root = workspace:FindFirstChild("ArcaneWorkshops")
	if not root then return end
	for _, d in ipairs(root:GetDescendants()) do add(d) end
end
workspace.DescendantAdded:Connect(function(d)
	if d:IsA("BasePart") then task.defer(add, d) end
end)
workspace.DescendantRemoving:Connect(remove)
task.spawn(function()
	while true do
		scan()
		task.wait(3)
	end
end)

-- one model per moving item: the item's Blender model, or a coloured ball without the library
local function newModel(item)
	local name = "item_" .. item
	local template = templates and templates:FindFirstChild(name, true)
	local shape = ItemArt[name]
	local part, offset, base
	if template and shape and template:IsA("BasePart") then
		part = template:Clone()
		part.Size = Vector3.new(table.unpack(shape.size))
		-- keep the template's rotation: the asset loader stores the import correction there
		offset = CFrame.new(table.unpack(shape.center)) * (template.CFrame - template.CFrame.Position)
		base = part.Size
	else
		local icon = Icons.item(item)
		part = Instance.new("Part")
		part.Shape, part.Size = Enum.PartType.Ball, Vector3.new(0.9, 0.9, 0.9)
		part.Color = Color3.fromRGB(icon.color[1], icon.color[2], icon.color[3])
		offset, base = CFrame.new(0, 0.45, 0), part.Size
	end
	part.Name = name
	part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch, part.CastShadow = true, false, false, false, false
	part.Parent = holder
	return { item = item, part = part, offset = offset, base = base, scale = 1 }
end

-- every item gets its own fixed turn, so a row of equal goods does not look stamped
local function turnOf(item)
	local sum = 0
	for i = 1, #item do sum = (sum * 31 + string.byte(item, i)) % 360 end
	return math.rad(sum)
end

RunService.RenderStepped:Connect(function(dt)
	local camera = workspace.CurrentCamera
	if not camera then return end
	moveCleats(workspace:GetServerTimeNow(), camera.CFrame.Position)
	motion:step(workspace:GetServerTimeNow(), dt)
	local eye = camera.CFrame.Position
	local alive = {}
	for serial, v in pairs(motion.visuals) do
		local near = (Vector3.new(v.x, v.y, v.z) - eye).Magnitude <= RANGE
		if near then
			local m = models[serial]
			if m and m.item ~= v.item then m.part:Destroy() m = nil end
			if not m then
				m = newModel(v.item)
				models[serial] = m
			end
			local scale = math.max(v.scale, 0.02)
			if math.abs(m.scale - scale) > 0.005 then
				m.scale = scale
				m.part.Size = m.base * scale
			end
			m.part.Transparency = (v.scale < 0.05) and 1 or 0
			m.part.CFrame = CFrame.new(v.x, v.y, v.z) * CFrame.Angles(0, v.yaw + turnOf(v.item) + (v.spin or 0), 0)
				* CFrame.new(m.offset.Position * scale) * (m.offset - m.offset.Position)
			alive[serial] = true
		end
	end
	for serial, m in pairs(models) do
		if not alive[serial] then
			m.part:Destroy()
			models[serial] = nil
		end
	end
end)
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000067"><Properties><string name="Name">MachineWindow</string><ProtectedString name="Source"><![CDATA[-- ROBLOX CLIENT: the window of one production machine - its own little workplace.
--
--   +---------------------------------------------------------------+
--   | Kräutermühle                                   läuft      [X] |
--   | [Zutaten]        [ Motiv  ====>  Fortschritt ]     [Ergebnis] |
--   | Anschlüsse:  Draufsicht mit Einlauf / Auslauf, Automatisch    |
--   | Rezepte, Brennstoff, Drehen, Abbauen (scrollt)                |
--   +---------------------------------------------------------------+
--
-- Everything shown comes from the server snapshot of exactly this machine instance; every change
-- (filling, taking out, choosing sides) is a server action.  Only the progress bar is advanced
-- locally between two snapshots.
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("ArcaneShared")
local Items = require(Shared.Items)
local Recipes = require(Shared.Recipes)
local Machines = require(Shared.Machines)
local Research = require(Shared.Research)
local Icons = require(Shared.ItemIcons)
local Ports = require(Shared.MachinePorts)
local Sheet = require(Shared.ItemIconSheet)

local Window = {}

local PARCHMENT, PARCHMENT_DARK = Color3.fromRGB(241, 231, 208), Color3.fromRGB(226, 212, 182)
local WOOD, WOOD_LIGHT = Color3.fromRGB(74, 48, 32), Color3.fromRGB(122, 84, 56)
local BRASS, INK = Color3.fromRGB(201, 154, 60), Color3.fromRGB(46, 36, 30)
local OK, WARN, BAD = Color3.fromRGB(79, 138, 85), Color3.fromRGB(206, 122, 59), Color3.fromRGB(193, 67, 59)
local IN_COLOR, OUT_COLOR, FLUID_COLOR = Color3.fromRGB(63, 138, 106), Color3.fromRGB(201, 154, 60), Color3.fromRGB(96, 150, 190)

local function amountText(id, n)
	if Items[id] and Items[id].unit == "ml" then return n .. " ml" end
	return tostring(n)
end

-- Why does the machine stand still?  Concrete, in the player's words.
function Window.reason(e)
	local s = e.state
	if e.paused or s == "Paused" then return "Pausiert", WARN end
	if not e.recipe then return "Kein Rezept gewählt", WARN end
	if s == "OutputBlocked" then return "Auslauf voll", BAD end
	if s == "NoFuel" then return "Holzkohle fehlt", BAD end
	if s == "WaitingForInputs" then
		local it = e.waiting and Items[e.waiting]
		return (it and it.name or "Zutat") .. " fehlt", WARN
	end
	if s == "Running" then return "Läuft", OK end
	return "Bereit", OK
end

-- ctx: { gui, make, corner, send, toast, Net, onClose }
function Window.create(ctx)
	local make, corner, send = ctx.make, ctx.corner, ctx.send
	local self = { uid = nil, sig = nil, live = nil, mode = "out" }

	local frame = make("Frame", { Name = "MachineWindow", Size = UDim2.new(0, 480, 1, -96), Position = UDim2.new(1, -492, 0, 12),
		BackgroundColor3 = WOOD, Visible = false }, ctx.gui)
	corner(frame, 12)
	make("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = BRASS, Thickness = 2 }, frame)
	local sheet = make("Frame", { Size = UDim2.new(1, -12, 1, -52), Position = UDim2.new(0, 6, 0, 46), BackgroundColor3 = PARCHMENT }, frame)
	corner(sheet, 8)
	local title = make("TextLabel", { Size = UDim2.new(1, -190, 0, 40), Position = UDim2.new(0, 14, 0, 3), BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold, TextSize = 21, TextColor3 = PARCHMENT, TextXAlignment = Enum.TextXAlignment.Left, Text = "" }, frame)
	local chip = make("TextLabel", { Size = UDim2.new(0, 124, 0, 28), Position = UDim2.new(1, -182, 0, 9), BackgroundColor3 = OK,
		Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = PARCHMENT, Text = "" }, frame)
	corner(chip, 14)
	local close = make("TextButton", { Size = UDim2.new(0, 44, 0, 36), Position = UDim2.new(1, -50, 0, 5), BackgroundColor3 = BAD,
		Font = Enum.Font.GothamBold, TextSize = 18, TextColor3 = PARCHMENT, Text = "X" }, frame)
	corner(close, 8)

	-- fixed part: process row and connection row (never scrolls)
	local process = make("Frame", { Size = UDim2.new(1, -12, 0, 150), Position = UDim2.new(0, 6, 0, 6), BackgroundColor3 = PARCHMENT_DARK }, sheet)
	corner(process, 8)
	local portsRow = make("Frame", { Size = UDim2.new(1, -12, 0, 124), Position = UDim2.new(0, 6, 0, 162), BackgroundColor3 = PARCHMENT_DARK }, sheet)
	corner(portsRow, 8)
	local scroll = make("ScrollingFrame", { Size = UDim2.new(1, -12, 1, -298), Position = UDim2.new(0, 6, 0, 292), BackgroundTransparency = 1,
		CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 8, BorderSizePixel = 0 }, sheet)
	make("UIListLayout", { Padding = UDim.new(0, 6) }, scroll)

	local function clear(holder)
		for _, child in ipairs(holder:GetChildren()) do
			if not (child:IsA("UIListLayout") or child:IsA("UICorner")) then child:Destroy() end
		end
	end
	local function act(action, payload)
		local result = send(action, payload)
		self.sig = nil                                  -- redraw with the confirmed state
		return result
	end
	local function textButton(text, parent, size, position, color, onClick)
		local b = make("TextButton", { Text = text, Size = size, Position = position, BackgroundColor3 = color or BRASS, TextColor3 = INK,
			Font = Enum.Font.GothamBold, TextSize = 14, TextWrapped = true, AutoButtonColor = true }, parent)
		corner(b, 7)
		local busy = false
		b.Activated:Connect(function()
			if busy then return end
			busy = true
			local ok, err = pcall(onClick)
			if not ok then warn(err) end
			busy = false
		end)
		return b
	end

	-- one material slot: tile with symbol, amount and name; optional tap action
	local function slot(parent, x, y, id, line, missing, onTap)
		local icon = Icons.item(id)
		local tile = make(onTap and "TextButton" or "Frame", { Size = UDim2.new(0, 66, 0, 66), Position = UDim2.new(0, x, 0, y),
			BackgroundColor3 = Color3.fromRGB(icon.color[1], icon.color[2], icon.color[3]) }, parent)
		if onTap then tile.Text, tile.AutoButtonColor = "", true end
		corner(tile, 8)
		make("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = missing and BAD or WOOD_LIGHT, Thickness = missing and 3 or 1.5 }, tile)
		local cell = Sheet.image ~= "" and Sheet.items[id]
		if cell then
			-- picture rendered from the item's Blender model, cut out of the common sheet
			tile.BackgroundColor3 = PARCHMENT
			make("ImageLabel", { Size = UDim2.new(0, 44, 0, 44), Position = UDim2.new(0.5, -22, 0, -3), BackgroundTransparency = 1,
				Image = Sheet.image, ImageRectOffset = Vector2.new(cell[1] * Sheet.cell, cell[2] * Sheet.cell),
				ImageRectSize = Vector2.new(Sheet.cell, Sheet.cell), ScaleType = Enum.ScaleType.Fit }, tile)
		else
			make("TextLabel", { Size = UDim2.new(1, 0, 0, 36), Position = UDim2.new(0, 0, 0, 2), BackgroundTransparency = 1, Text = icon.symbol,
				TextSize = 28, Font = Enum.Font.GothamBold, TextColor3 = INK }, tile)
		end
		local count = make("TextLabel", { Size = UDim2.new(1, -4, 0, 16), Position = UDim2.new(0, 2, 0, 36), BackgroundColor3 = PARCHMENT,
			BackgroundTransparency = 0.15, Text = line, TextSize = 12, Font = Enum.Font.GothamBold, TextColor3 = missing and BAD or INK,
			TextScaled = false }, tile)
		corner(count, 4)
		make("TextLabel", { Size = UDim2.new(1, 8, 0, 14), Position = UDim2.new(0, -4, 1, 1), BackgroundTransparency = 1,
			Text = Items[id] and Items[id].name or id, TextSize = 10, Font = Enum.Font.Gotham, TextColor3 = INK,
			TextTruncate = Enum.TextTruncate.AtEnd }, tile)
		if onTap then tile.Activated:Connect(onTap) end
		return tile
	end

	local function drawProcess(e, def, s)
		clear(process)
		local r = e.recipe and Recipes[e.recipe]
		make("TextLabel", { Size = UDim2.new(0, 150, 0, 16), Position = UDim2.new(0, 8, 0, 4), BackgroundTransparency = 1, Text = "Zutaten",
			Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = WOOD, TextXAlignment = Enum.TextXAlignment.Left }, process)
		make("TextLabel", { Size = UDim2.new(0, 150, 0, 16), Position = UDim2.new(1, -158, 0, 4), BackgroundTransparency = 1, Text = "Ergebnis",
			Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = WOOD, TextXAlignment = Enum.TextXAlignment.Right }, process)
		-- left: what the recipe needs and what is inside
		local inputs = {}
		if r then
			for id in pairs(r.inputs) do inputs[#inputs + 1] = id end
			table.sort(inputs)
		end
		local index = 0
		local function place(i) return 8 + (i % 2) * 72, 22 + math.floor(i / 2) * 84 end
		for _, id in ipairs(inputs) do
			local liquid = Items[id].unit == "ml"
			local have = (liquid and e.fluids[id] or e.inv[id]) or 0
			local need = r.inputs[id]
			local x, y = place(index)
			index = index + 1
			slot(process, x, y, id, amountText(id, have) .. "/" .. need, have < need, function()
				local lack = math.max(need - have, liquid and 1000 or 1)
				local inBag = s.items[id] or 0
				if inBag <= 0 then ctx.toast((Items[id].name) .. " fehlt im Beutel", BAD) return end
				act("TransferStack", { from = "inv", to = e.uid, item = id, amount = math.min(lack, inBag) })
			end)
		end
		if def.usesFuel and index < 4 then
			local need = r and r.fuelUnits or 1
			local x, y = place(index)
			slot(process, x, y, "fuel_charcoal", e.fuel .. "/" .. need, e.fuel < need, function()
				local inBag = s.items.fuel_charcoal or 0
				if inBag <= 0 then ctx.toast("Holzkohle fehlt im Beutel", BAD) return end
				act("TransferStack", { from = "inv", to = e.uid, item = "fuel_charcoal", amount = math.min(4, inBag) })
			end)
		end
		if not r then
			make("TextLabel", { Size = UDim2.new(0, 150, 0, 60), Position = UDim2.new(0, 8, 0, 40), BackgroundTransparency = 1, TextWrapped = true,
				Text = "Wähle unten ein Rezept.", Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = INK }, process)
		end
		-- middle: motif, progress arrow, reason
		local mid = make("Frame", { Size = UDim2.new(0, 150, 0, 124), Position = UDim2.new(0.5, -75, 0, 18), BackgroundTransparency = 1 }, process)
		make("TextLabel", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Text = Icons.machine(e.machine), TextSize = 36,
			Font = Enum.Font.GothamBold, TextColor3 = INK }, mid)
		local track = make("Frame", { Size = UDim2.new(1, -26, 0, 18), Position = UDim2.new(0, 4, 0, 50), BackgroundColor3 = WOOD_LIGHT }, mid)
		corner(track, 5)
		local fill = make("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = BRASS }, track)
		corner(fill, 5)
		make("TextLabel", { Size = UDim2.new(0, 24, 0, 28), Position = UDim2.new(1, -24, 0, 45), BackgroundTransparency = 1, Text = "▶",
			TextSize = 22, Font = Enum.Font.GothamBold, TextColor3 = BRASS }, mid)
		local status = make("TextLabel", { Size = UDim2.new(1, 0, 0, 40), Position = UDim2.new(0, 0, 0, 74), BackgroundTransparency = 1, Text = "",
			TextWrapped = true, Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = INK }, mid)
		self.live = { fill = fill, status = status }
		-- right: finished goods in the output buffer (tap to take them out)
		local outputs, seen = {}, {}
		for id in pairs(e.out or {}) do outputs[#outputs + 1], seen[id] = id, true end
		for id in pairs(e.outFluid or {}) do outputs[#outputs + 1], seen[id] = id, true end
		if r then
			for id in pairs(r.outputs) do
				if not seen[id] then outputs[#outputs + 1] = id end
			end
		end
		table.sort(outputs)
		for i, id in ipairs(outputs) do
			if i > 4 then break end
			local n = (e.out and e.out[id]) or (e.outFluid and e.outFluid[id]) or 0
			local col, rowIndex = (i - 1) % 2, math.floor((i - 1) / 2)
			local tile = slot(process, 0, 22 + rowIndex * 84, id, amountText(id, n), false, n > 0 and function()
				act("TransferStack", { from = e.uid, to = "inv", item = id, amount = n, slot = "out" })
			end or nil)
			tile.Position = UDim2.new(1, -74 - col * 72, 0, 22 + rowIndex * 84)
		end
	end

	-- top view of the machine in its own frame: front at the bottom, like standing in front of it
	local SIDE_AT = { [0] = { 0.5, 1 }, [1] = { 1, 0.5 }, [2] = { 0.5, 0 }, [3] = { 0, 0.5 } }
	local function drawPorts(e, def)
		clear(portsRow)
		local fluid = Ports.fluidSides(def)
		make("TextLabel", { Size = UDim2.new(0, 200, 0, 16), Position = UDim2.new(0, 8, 0, 4), BackgroundTransparency = 1, Text = "Anschlüsse (Draufsicht)",
			Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = WOOD, TextXAlignment = Enum.TextXAlignment.Left }, portsRow)
		local view = make("Frame", { Size = UDim2.new(0, 96, 0, 96), Position = UDim2.new(0, 34, 0, 24), BackgroundTransparency = 1 }, portsRow)
		local body = make("Frame", { Size = UDim2.new(0, 52, 0, 52), Position = UDim2.new(0.5, -26, 0.5, -26), BackgroundColor3 = WOOD_LIGHT }, view)
		corner(body, 6)
		make("TextLabel", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = Icons.machine(e.machine), TextSize = 24,
			Font = Enum.Font.GothamBold, TextColor3 = PARCHMENT }, body)
		for side = 0, 3 do
			local at = SIDE_AT[side]
			local text, color, enabled = "", PARCHMENT, true
			if fluid[side] then
				text, color, enabled = "💧", FLUID_COLOR, false
			elseif side == e.inSide then
				text, color = "Ein", IN_COLOR
			elseif side == e.outSide then
				text, color = "Aus", OUT_COLOR
			end
			local b = make("TextButton", { Size = UDim2.new(0, 40, 0, 26), AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(at[1], (at[1] - 0.5) * -8, at[2], (at[2] - 0.5) * -6), BackgroundColor3 = color, Text = text,
				Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = (text == "") and INK or PARCHMENT, AutoButtonColor = enabled, Active = enabled }, view)
			corner(b, 6)
			make("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = WOOD, Thickness = 1.5 }, b)
			if enabled then
				b.Activated:Connect(function()
					if self.mode == "in" then act("SetMachinePorts", { uid = e.uid, inSide = side })
					else act("SetMachinePorts", { uid = e.uid, outSide = side }) end
				end)
			end
		end
		make("TextLabel", { Size = UDim2.new(0, 96, 0, 12), Position = UDim2.new(0, 34, 1, -14), BackgroundTransparency = 1, Text = "Vorderseite",
			Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = WOOD }, portsRow)
		-- right of the view: which connection a tap sets, and the outlet mode
		local x0 = 172
		make("TextLabel", { Size = UDim2.new(1, -x0 - 8, 0, 16), Position = UDim2.new(0, x0, 0, 6), BackgroundTransparency = 1,
			Text = "Seite antippen setzt:", Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = INK, TextXAlignment = Enum.TextXAlignment.Left }, portsRow)
		local function modeButton(label, mode, x, color)
			local on = self.mode == mode
			local b = textButton(label, portsRow, UDim2.new(0, 136, 0, 30), UDim2.new(0, x, 0, 26), on and color or PARCHMENT, function()
				self.mode = mode
				self.sig = nil
			end)
			b.TextColor3 = on and PARCHMENT or INK
			make("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = color, Thickness = 2 }, b)
		end
		modeButton("Einlauf", "in", x0, IN_COLOR)
		modeButton("Auslauf", "out", x0 + 144, OUT_COLOR)
		local auto = e.outAuto ~= false
		make("TextLabel", { Size = UDim2.new(1, -x0 - 8, 0, 32), Position = UDim2.new(0, x0, 0, 60), BackgroundTransparency = 1, TextWrapped = true,
			Text = "Einlauf " .. Ports.SIDE_NAME[e.inSide] .. " · Auslauf " .. Ports.SIDE_NAME[e.outSide] .. "\nAuslauf: "
				.. (auto and "Automatisch (folgt dem Band)" or "Manuell (fest)"),
			Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = INK, TextXAlignment = Enum.TextXAlignment.Left }, portsRow)
		local b = textButton(auto and "Automatisch ✓" or "Automatisch", portsRow, UDim2.new(0, 136, 0, 26), UDim2.new(0, x0, 0, 94),
			auto and OK or BRASS, function()
				if not auto then act("SetMachinePorts", { uid = e.uid, auto = true }) end
			end)
		b.TextColor3 = auto and PARCHMENT or INK
		if next(fluid) then
			make("TextLabel", { Size = UDim2.new(0, 140, 0, 26), Position = UDim2.new(0, x0 + 144, 0, 94), BackgroundTransparency = 1, TextWrapped = true,
				Text = "💧 Rohranschluss, fest", Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = FLUID_COLOR,
				TextXAlignment = Enum.TextXAlignment.Left }, portsRow)
		end
	end

	local function listRow(text, actionText, onClick, color)
		local f = make("Frame", { Size = UDim2.new(1, -10, 0, 44), BackgroundColor3 = PARCHMENT_DARK, AutomaticSize = Enum.AutomaticSize.Y }, scroll)
		corner(f, 6)
		make("TextLabel", { Text = text, Size = UDim2.new(1, actionText and -128 or -14, 0, 40), Position = UDim2.new(0, 8, 0, 2),
			BackgroundTransparency = 1, TextColor3 = color or INK, Font = Enum.Font.Gotham, TextSize = 13, TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left, AutomaticSize = Enum.AutomaticSize.Y }, f)
		if actionText then textButton(actionText, f, UDim2.new(0, 112, 0, 36), UDim2.new(1, -118, 0, 4), nil, onClick) end
	end
	local function heading(text)
		make("TextLabel", { Text = text, Size = UDim2.new(1, -10, 0, 20), BackgroundTransparency = 1, TextColor3 = WOOD,
			Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left }, scroll)
	end
	local function itemList(map)
		local parts = {}
		for id, n in pairs(map or {}) do
			parts[#parts + 1] = amountText(id, n) .. (Items[id].unit == "ml" and " " or " × ") .. Items[id].name
		end
		table.sort(parts)
		return table.concat(parts, ", ")
	end
	local function drawList(e, def, s)
		local keep = scroll.CanvasPosition
		clear(scroll)
		heading("Rezepte")
		local ids = {}
		for id, r in pairs(Recipes) do if r.machineId == e.machine then ids[#ids + 1] = id end end
		table.sort(ids)
		for _, id in ipairs(ids) do
			local r = Recipes[id]
			local line = itemList(r.inputs) .. "  →  " .. itemList(r.outputs) .. "  (" .. r.durationSec .. " s)"
			if not s.research[r.requiredResearch] then
				listRow("🔒 " .. line .. "\nForschung: " .. Research[r.requiredResearch].name, nil, nil, Color3.fromRGB(138, 127, 115))
			else
				listRow(((e.recipe == id) and "● " or "") .. line, "Herstellen", function()
					act("StartManualCraft", { uid = e.uid, recipe = id })
				end)
			end
		end
		heading("Maschine")
		listRow(e.paused and "Die Maschine ist pausiert." or "Die Maschine arbeitet, sobald Zutaten da sind.", e.paused and "Fortsetzen" or "Pause",
			function() act("ToggleMachine", { uid = e.uid }) end)
		listRow("Drehen (90°) – Ein- und Auslauf drehen sich mit", "Drehen", function() act("RotateMachine", { uid = e.uid }) end)
		listRow("Abbauen – Inhalt kommt in den Beutel, 60 % der Kosten zurück", "Abbauen", function()
			if act("RemoveMachine", { uid = e.uid }).ok then self.close() end
		end, BAD)
		if e.machine == "kettle" then
			listRow("Experiment: 1 Kraut + 1000 ml Wasser → +3 Wissen (max. 5 pro Tag)", "Forschen", function() act("Experiment", { uid = e.uid }) end)
		end
		task.defer(function() scroll.CanvasPosition = keep end)
	end

	local function find(s)
		for _, e in ipairs(s and s.workshop and s.workshop.entities or {}) do
			if e.uid == self.uid then return e end
		end
		return nil
	end
	-- fingerprint of everything drawn statically (progress is animated separately)
	local function signature(e, s)
		local parts = { e.machine, tostring(e.recipe), tostring(e.state), tostring(e.waiting), tostring(e.paused), e.fuel or 0,
			tostring(e.inSide), tostring(e.outSide), tostring(e.outAuto), e.rot, self.mode }
		for _, store in ipairs({ e.inv or {}, e.fluids or {}, e.out or {}, e.outFluid or {} }) do
			local ids = {}
			for id in pairs(store) do ids[#ids + 1] = id end
			table.sort(ids)
			for _, id in ipairs(ids) do parts[#parts + 1] = id .. "=" .. store[id] end
			parts[#parts + 1] = "/"
		end
		local r = e.recipe and Recipes[e.recipe]
		if r then for id in pairs(r.inputs) do parts[#parts + 1] = id .. ":" .. (s.items[id] or 0) end end
		local n = 0
		for _ in pairs(s.research) do n = n + 1 end
		parts[#parts + 1] = n
		for i = 1, #parts do parts[i] = tostring(parts[i]) end
		return table.concat(parts, "|")
	end

	function self.isOpen() return frame.Visible end
	function self.close()
		if not frame.Visible then return end
		frame.Visible = false
		self.uid, self.sig, self.live, self.job = nil, nil, nil, nil
		if ctx.onClose then ctx.onClose() end
	end
	close.Activated:Connect(self.close)

	-- called with every snapshot and after own actions
	function self.update(s)
		if not frame.Visible then return end
		local e = find(s)
		if not e then
			-- left the workshop or the machine was removed by someone else
			self.close()
			return
		end
		local def = Machines[e.machine]
		title.Text = def.name
		local text, color = Window.reason(e)
		chip.Text, chip.BackgroundColor3 = text, color
		-- progress as confirmed by the server, stamped with the local time it arrived
		self.job = e.job and { remaining = e.job.remaining, total = e.job.total, at = os.clock(), running = e.state == "Running" } or nil
		self.reason, self.reasonColor = text, color
		local sig = signature(e, s)
		if sig ~= self.sig then
			self.sig = sig
			drawProcess(e, def, s)
			drawPorts(e, def)
			drawList(e, def, s)
		end
	end

	function self.open(uid)
		self.uid, self.sig, self.mode = uid, nil, "out"
		frame.Visible = true
		scroll.CanvasPosition = Vector2.new(0, 0)
		self.update(ctx.Net.snapshot)
	end

	-- smooth progress between two confirmed updates
	RunService.RenderStepped:Connect(function()
		if not (frame.Visible and self.live) then return end
		if self.sig == nil and ctx.Net.snapshot then self.update(ctx.Net.snapshot) end
		local live, job = self.live, self.job
		if not live or not live.fill.Parent then return end
		if job and job.total > 0 then
			local remaining = job.remaining
			if job.running then remaining = math.max(0, remaining - (os.clock() - job.at)) end
			live.fill.Size = UDim2.new(math.clamp(1 - remaining / job.total, 0, 1), 0, 1, 0)
			if job.running then
				live.status.Text = string.format("Läuft · noch %d s", math.ceil(remaining))
				live.status.TextColor3 = OK
			else
				live.status.Text, live.status.TextColor3 = self.reason or "", self.reasonColor or INK
			end
		else
			live.fill.Size = UDim2.new(0, 0, 1, 0)
			live.status.Text, live.status.TextColor3 = self.reason or "", self.reasonColor or INK
		end
	end)

	return self
end

return Window
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX000068"><Properties><string name="Name">MarketIdle</string><ProtectedString name="Source"><![CDATA[-- ROBLOX CLIENT: plays the idle loops of the market traders.
-- A trader is a folder "Figure" of seven anchored MeshParts that the server placed in the rest
-- pose.  MarketMotion holds, per part, the joint frame for every sample of the loop; a part moves
-- with  pivot * frame(t) * CFrame.new(-joint) * restLocal.  Only this client sees the motion, the
-- server never moves the parts, so nothing has to be replicated.
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("ArcaneShared")
local Motion = require(Shared.MarketMotion)

local RANGE = 130                      -- studs: figures further away stand still
local PHASE = { selma = 0, nyra = 1.7, lio = 3.1, aron = 4.6, esme = 2.4 }   -- so they do not move in step

-- joint frames as CFrames, already combined with the joint offset
local tracks = {}
for role, data in pairs(Motion.roles) do
	tracks[role] = { duration = data.duration, parts = {} }
	for part, rows in pairs(data.parts) do
		local joint = data.joints[part]
		local back = CFrame.new(-joint[1], -joint[2], -joint[3])
		local frames = table.create(#rows)
		for i, r in ipairs(rows) do
			frames[i] = CFrame.new(r[1], r[2], r[3], r[4], r[5], r[6], r[7]) * back
		end
		tracks[role].parts[part] = frames
	end
end

local figures = {}                     -- Folder -> { pivot, track, parts = { { part, frames, restLocal } }, phase }

local function register(figure)
	if figures[figure] then return end
	local role = figure:GetAttribute("MerchantRole")
	local pivot = figure:GetAttribute("MerchantPivot")
	local track = role and tracks[role]
	if not track or typeof(pivot) ~= "CFrame" then return end
	local parts, missing = {}, false
	for name, frames in pairs(track.parts) do
		local part = figure:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			-- still in the rest pose here: the server never moves the parts
			parts[#parts + 1] = { part = part, frames = frames, restLocal = pivot:ToObjectSpace(part.CFrame) }
		else
			missing = true
		end
	end
	if missing then return end          -- not everything has arrived yet, try again later
	figures[figure] = { pivot = pivot, track = track, parts = parts, phase = PHASE[role] or 0,
		centre = pivot.Position + Vector3.new(0, 3, 0) }
end

local function scan()
	local market = workspace:FindFirstChild("ArcaneMarket")
	if not market then return end
	for _, d in ipairs(market:GetDescendants()) do
		if d:IsA("Folder") and d.Name == "Figure" then register(d) end
	end
end
task.spawn(function()
	while true do
		scan()
		for figure in pairs(figures) do
			if not figure:IsDescendantOf(workspace) then figures[figure] = nil end
		end
		task.wait(2)
	end
end)

RunService.RenderStepped:Connect(function()
	local camera = workspace.CurrentCamera
	if not camera or not next(figures) then return end
	local eye = camera.CFrame.Position
	local now = workspace:GetServerTimeNow()
	for _, f in pairs(figures) do
		if (eye - f.centre).Magnitude <= RANGE then
			for _, entry in ipairs(f.parts) do
				local count = #entry.frames
				local at = ((now + f.phase) % f.track.duration) / f.track.duration * count
				local i = math.floor(at)
				local a, b = entry.frames[i % count + 1], entry.frames[(i + 1) % count + 1]
				entry.part.CFrame = f.pivot * a:Lerp(b, at - i) * entry.restLocal
			end
		end
	end
end)
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000069"><Properties><string name="Name">NetworkClient</string><ProtectedString name="Source"><![CDATA[-- ROBLOX CLIENT (UNVERIFIED_IN_STUDIO): thin wrapper around the two remotes. All state shown in
-- the UI comes from server snapshots; the client never computes money, items or unlocks itself.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("ArcaneShared")
local Protocol = require(Shared.Protocol)
local Net = { snapshot = nil, listeners = {}, handlers = {}, seq = 0 }
local request = ReplicatedStorage:WaitForChild(Protocol.remoteName, 30)
local event = ReplicatedStorage:WaitForChild(Protocol.eventName, 30)

function Net.onSnapshot(fn) Net.listeners[#Net.listeners + 1] = fn end
function Net.on(name, fn) Net.handlers[name] = fn end
local function publish(snap)
	if not snap then return end
	Net.snapshot = snap
	for _, fn in ipairs(Net.listeners) do task.spawn(fn, snap) end
end
-- Returns the server result table ({ ok, code, payload }).
function Net.send(action, payload)
	if not request then return { ok = false, code = "NOT_READY" } end
	payload = payload or {}
	Net.seq = Net.seq + 1
	payload.actionId = "c" .. Net.seq .. "_" .. math.floor(os.clock() * 1000) % 100000
	local ok, result = pcall(function() return request:InvokeServer(action, payload) end)
	if not ok or type(result) ~= "table" then return { ok = false, code = "NOT_READY" } end
	publish(result.snapshot)
	return result
end
function Net.message(result)
	if result.ok then return nil end
	return Protocol.messages[result.code] or result.code
end
if event then
	event.OnClientEvent:Connect(function(name, data)
		if name == "Snapshot" then publish(data)
		elseif Net.handlers[name] then Net.handlers[name](data) end
	end)
end
return Net
]]></ProtectedString></Properties></Item>
</Item>
