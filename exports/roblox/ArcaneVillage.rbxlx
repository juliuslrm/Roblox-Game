		["house_01_timber_cottage"] = {category = "houses", collision = "proxy", size = {28.0193, 42.676, 24.4817}, center = {0, 17.338, 0.6549}, castShadow = true, colliders = {{shape = "box", center = {0, 11.6813, 0.65}, size = {24.6, 31.3627, 19.9}, yaw_deg = 0}}, lights = {{position = {-1.5829, 7.05, 10.4838}, color = {1, 0.82, 0.55}, brightness = 0.9, range = 22}}},
		["house_02_gabled_townhouse"] = {category = "houses", collision = "proxy", size = {23.1905, 52.5585, 31.8364}, center = {-0.005, 22.2792, 1.1013}, castShadow = true, colliders = {{shape = "box", center = {0, 15.8574, 1.1}, size = {18.6, 39.7148, 26.8}, yaw_deg = 0}}, lights = {{position = {-7.6819, 6.65, 13.5926}, color = {1, 0.82, 0.55}, brightness = 0.9, range = 22}}},
