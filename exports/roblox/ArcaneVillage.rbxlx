<Item class="ModuleScript" referent="RBX000042"><Properties><string name="Name">MarketWorld</string><ProtectedString name="Source"><![CDATA[-- Places the five merchants at the planned stalls. Art is optional in the base place.
local Market = require(script.Parent.Data).Market
local Art = require(script.Parent.MarketArt)
local World = {}

local WOOD = Color3.fromRGB(133, 87, 58)
local DARK = Color3.fromRGB(83, 57, 42)

local function block(parent, name, frame, size, color, collides, transparency)
	local part = Instance.new("Part")
	part.Name, part.CFrame, part.Size = name, frame, size
	part.Anchored, part.CanCollide = true, collides
	part.CanQuery, part.CanTouch = collides, false
	part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	part.Color, part.Transparency = color, transparency or 0
	part.CastShadow = transparency ~= 1
	part.Parent = parent
	return part
end

local function imported(parent, templates, name, pivot, role)
	local template = templates and templates:FindFirstChild(name, true)
	local shape = Art[name]
	if not template or not shape then return false end
	if not template:IsA("BasePart") then
		local parts = {}
		for _, child in ipairs(template:GetDescendants()) do
			if child:IsA("BasePart") then parts[#parts + 1] = child end
		end
		template = #parts == 1 and parts[1] or nil
	end
	if not template or not template.Archivable then return false end
	local mesh = template:Clone()
	mesh.Size = Vector3.new(table.unpack(shape.size))
	-- keep the template's rotation: the asset loader stores the import correction there
	mesh.CFrame = pivot * CFrame.new(table.unpack(shape.center)) * (template.CFrame - template.CFrame.Position)
	mesh.Anchored, mesh.CanCollide, mesh.CanQuery, mesh.CanTouch = true, false, false, false
	local rootBone = role and mesh:FindFirstChild("root", true)
	if rootBone and rootBone:IsA("Bone") then
		mesh:SetAttribute("MarketRigRole", role)
	end
	mesh.Parent = parent
	return true
end

local function fallbackStall(folder, pivot, accent)
	block(folder, "Counter", pivot * CFrame.new(0, 1.4, 0.45), Vector3.new(7.8, 2.8, 2.05), WOOD, false)
	block(folder, "CounterTop", pivot * CFrame.new(0, 2.86, 0.45), Vector3.new(8.2, 0.28, 2.25), DARK, false)
	for _, x in ipairs({-4.15, 4.15}) do
		block(folder, "Post", pivot * CFrame.new(x, 4.25, 0.4), Vector3.new(0.34, 8.5, 0.34), DARK, false)
	end
	for i = 0, 7 do
		block(folder, "Awning", pivot * CFrame.new((i - 3.5) * 1.11, 8.55, 0.25),
			Vector3.new(1.11, 0.18, 5.6), i % 2 == 0 and accent or Color3.fromRGB(234, 220, 190), false)
	end
end

local function ellipsoid(folder, name, frame, size, color)
	local part = block(folder, name, frame, Vector3.new(1, 1, 1), color, false)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType, mesh.Scale = Enum.MeshType.Sphere, size
	mesh.Parent = part
end

local function fallbackMerchant(folder, pivot, accent)
	local skin = Color3.fromRGB(221, 169, 143)
	ellipsoid(folder, "Coat", pivot * CFrame.new(0, 3.62, 0), Vector3.new(1.13, 2.52, 0.70), accent)
	ellipsoid(folder, "Neck", pivot * CFrame.new(0, 4.94, 0), Vector3.new(0.28, 0.58, 0.29), skin)
	ellipsoid(folder, "Head", pivot * CFrame.new(0, 5.56, 0.04), Vector3.new(0.58, 0.85, 0.55), skin)
	ellipsoid(folder, "HatBrim", pivot * CFrame.new(0, 5.93, 0.01), Vector3.new(1.26, 0.11, 0.97), DARK)
	ellipsoid(folder, "HatCrown", pivot * CFrame.new(0.05, 6.08, 0.01), Vector3.new(0.65, 0.48, 0.57), accent)
	for _, side in ipairs({ -1, 1 }) do
		local arm = pivot * CFrame.new(side * 0.64, 3.92, 0.04) * CFrame.Angles(0, 0, side * 0.18)
		ellipsoid(folder, "Sleeve", arm, Vector3.new(0.35, 1.57, 0.39), accent)
		ellipsoid(folder, "Hand", pivot * CFrame.new(side * 0.75, 3.16, 0.11), Vector3.new(0.25, 0.39, 0.27), skin)
		ellipsoid(folder, "Leg", pivot * CFrame.new(side * 0.24, 1.57, 0), Vector3.new(0.44, 2.77, 0.43), DARK)
		ellipsoid(folder, "Boot", pivot * CFrame.new(side * 0.24, 0.24, 0.15), Vector3.new(0.43, 0.47, 0.68), DARK)
	end
end

function World.build(parent, anchors, origin, templates, groundPosition, onOpen)
	local root = Instance.new("Folder")
	root.Name = "ArcaneMarket"
	local village = parent:FindFirstChild("Village")
	local oldStalls = village and village:FindFirstChild("market")
	local oldByIndex = {}
	if oldStalls then
		for _, item in ipairs(oldStalls:GetChildren()) do
			local index = item:GetAttribute("LayoutIndex")
			if index then oldByIndex[index] = item end
		end
	end
	local replaced = {}
	for _, id in ipairs(Market.order) do
		local anchor = anchors[id]
		if anchor then
			local def = Market.merchants[id]
			local accent = Color3.fromHex(def.color)
			local folder = Instance.new("Folder")
			folder.Name, folder.Parent = id, root
			local approach = groundPosition({ x = anchor.approachX, y = anchor.y, z = anchor.approachZ })
			local position = origin * Vector3.new(anchor.x, anchor.y, anchor.z)
			local pivot = CFrame.new(position.X, approach.Y, position.Z)
				* (origin - origin.Position) * CFrame.Angles(0, math.rad(anchor.yaw), 0)
			if not imported(folder, templates, "stall_" .. id, pivot) then fallbackStall(folder, pivot, accent) end
			local npc = pivot * CFrame.new(0, 0, -1.6)
			if not imported(folder, templates, "merchant_" .. id, npc, id) then
				fallbackMerchant(folder, npc, accent)
			end
			block(folder, "CounterCollision", pivot * CFrame.new(0, 1.5, 0.45), Vector3.new(8.2, 3, 2.25), WOOD, true, 1)
			local promptAnchor = block(folder, "TradePrompt", CFrame.new(approach + Vector3.new(0, 2.5, 0)),
				Vector3.new(0.2, 0.2, 0.2), accent, false, 1)
			local prompt = Instance.new("ProximityPrompt")
			prompt.ActionText, prompt.ObjectText = "Handeln", def.name
			prompt.MaxActivationDistance, prompt.RequiresLineOfSight = Market.radius, false
			prompt.HoldDuration = 0.15
			prompt.Triggered:Connect(function(player) onOpen(player, id) end)
			prompt.Parent = promptAnchor
			if oldByIndex[anchor.index] then replaced[#replaced + 1] = oldByIndex[anchor.index] end
		end
	end
	local previous = parent:FindFirstChild(root.Name)
	if previous then previous:Destroy() end
	root.Parent = parent
	for _, item in ipairs(replaced) do item:Destroy() end
	return root
end

return World
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000043"><Properties><string name="Name">MetricsService</string><ProtectedString name="Source"><![CDATA[-- Production statistics over sliding time windows (runtime only, not persisted).
local D = require(script.Parent.Data)
local Config, Items = D.Config, D.Items
local Metrics = {}
-- log is a queue with explicit head / tail indices (the # operator is unreliable once entries are pruned)
function Metrics.new() return { log = {}, head = 1, tail = 0 } end
function Metrics.record(stats, clock, ev)
	stats.tail = stats.tail + 1
	stats.log[stats.tail] = { t = clock, item = ev.item, n = ev.n, auto = ev.auto, kind = ev.type }
end
function Metrics.prune(stats, clock)
	local limit = clock - Config.sim.statsWindowSec
	local log = stats.log
	while stats.head <= stats.tail and log[stats.head].t < limit do
		log[stats.head] = nil
		stats.head = stats.head + 1
	end
	if stats.head > 4096 then            -- compact the array from time to time
		local fresh, n = {}, 0
		for i = stats.head, stats.tail do
			n = n + 1
			fresh[n] = log[i]
		end
		stats.log, stats.head, stats.tail = fresh, 1, n
	end
end
local function each(stats, clock, windowSec, fn)
	for i = stats.head, stats.tail do
		local r = stats.log[i]
		if r.t >= clock - windowSec then fn(r) end
	end
end
-- pieces per minute of crafted outputs (liquids count per 1000 ml)
function Metrics.rate(stats, clock, windowSec, item)
	local total = 0
	each(stats, clock, windowSec, function(r)
		if r.kind == "craft" and (item == nil or r.item == item) then
			total = total + ((Items[r.item].unit == "ml") and r.n / 1000 or r.n)
		end
	end)
	return total * 60 / windowSec
end
function Metrics.autoProductLines(stats, clock, windowSec)
	local seen, n = {}, 0
	each(stats, clock, windowSec, function(r)
		if r.kind == "craft" and r.auto and Items[r.item].type == "product" and not seen[r.item] then
			seen[r.item] = true
			n = n + 1
		end
	end)
	return n
end
function Metrics.perItem(stats, clock, windowSec)
	local out = {}
	each(stats, clock, windowSec, function(r)
		local key = r.kind .. ":" .. r.item
		out[key] = (out[key] or 0) + r.n
	end)
	return out
end
return Metrics
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000044"><Properties><string name="Name">PlacementService</string><ProtectedString name="Source"><![CDATA[-- Sole writer of the workshop layout: grid rules, placing, removing, rotating, blueprints.
local D = require(script.Parent.Data)
local Inv = require(script.Parent.InventoryService)
local Eco = require(script.Parent.EconomyService)
local Config, Machines, Grid, Util, Recipes = D.Config, D.Machines, D.GridMath, D.Util, D.Recipes
local Place = {}

function Place.cells(P) return Config.plotTiers[P.workshop.sizeTier].cells end

-- Reserved cells: entrance (front edge, floor 1) and staircase (back-left corner, all floors).
function Place.reserved(P, floor, x, z)
	local n = Place.cells(P)
	if floor == 1 then
		local x0 = math.floor(n / 2) - math.floor(Config.door.width / 2)
		if x >= x0 and x < x0 + Config.door.width and z < Config.door.depth then return true end
	end
	if x < 3 and z >= n - 4 then return true end
	return false
end

function Place.find(P, uid)
	for i, e in ipairs(P.workshop.layout) do
		if e.uid == uid then return e, i end
	end
	return nil
end

-- Occupancy maps: ground (machines, belts) and pipe layer.
function Place.occupancy(P, skipUid)
	local ground, pipe = {}, {}
	for _, e in ipairs(P.workshop.layout) do
		if e.uid ~= skipUid then
			local def = Machines[e.machine]
			local map = (def.layer == "pipe") and pipe or ground
			for _, c in ipairs(Grid.cells(def, e.gx, e.gz, e.rot)) do
				map[Grid.key(e.floor, c[1], c[2])] = e.uid
			end
		end
	end
	return ground, pipe
end

local function countOf(P, machineId, kindCategory)
	local n, logistics, machines = 0, 0, 0
	for _, e in ipairs(P.workshop.layout) do
		if e.machine == machineId then n = n + 1 end
		if Machines[e.machine].category == "transport" then logistics = logistics + 1 else machines = machines + 1 end
	end
	return n, logistics, machines
end

function Place.unlocked(P, machineId)
	local def = Machines[machineId]
	return def ~= nil and P.research[def.research] == true
end

-- Returns nil if the placement is legal, otherwise a result code.
function Place.check(P, machineId, gx, gz, floor, rot, skipUid, ground, pipe)
	local def = Machines[machineId]
	if not def then return "NOT_FOUND" end
	if not (Util.isInt(gx) and Util.isInt(gz) and Util.isInt(floor) and Util.isInt(rot)) then return "BAD_REQUEST" end
	if rot < 0 or rot > 3 or floor < 1 or floor > P.workshop.floors then return "BLOCKED" end
	if not Place.unlocked(P, machineId) then return "LOCKED" end
	local n = Place.cells(P)
	if not ground then ground, pipe = Place.occupancy(P, skipUid) end
	for _, c in ipairs(Grid.cells(def, gx, gz, rot)) do
		local x, z = c[1], c[2]
		if x < 0 or z < 0 or x >= n or z >= n then return "BLOCKED" end
		if Place.reserved(P, floor, x, z) then return "BLOCKED" end
		local k = Grid.key(floor, x, z)
		if def.layer == "pipe" then
			if pipe[k] then return "BLOCKED" end
			local g = ground[k]
			if g then
				local other = Place.find(P, g)
				if Machines[other.machine].category ~= "transport" then return "BLOCKED" end
			end
		else
			if ground[k] then return "BLOCKED" end
			if def.category ~= "transport" and pipe[k] then return "BLOCKED" end
		end
	end
	if def.kind == "lift" and floor >= P.workshop.floors then return "BLOCKED" end
	return nil
end

function Place.limitCode(P, machineId)
	local def = Machines[machineId]
	local same, logistics, machines = countOf(P, machineId)
	if def.buildLimit and same >= def.buildLimit then return "LIMIT" end
	if machineId == "storage_crate" and not P.research.storage and same >= Config.limits.crateLimitStart then return "LIMIT" end
	if def.category == "transport" then
		if logistics >= Config.limits.logistics then return "LIMIT" end
	elseif machines >= Config.limits.machines then return "LIMIT" end
	return nil
end

local function newBuffer() return { inv = {}, out = {}, fluids = {}, outFluid = {}, fuel = 0 } end
Place.newBuffer = newBuffer

local function addEntity(P, machineId, gx, gz, floor, rot)
	local uid = "m" .. P.workshop.nextUid
	P.workshop.nextUid = P.workshop.nextUid + 1
	local e = { uid = uid, machine = machineId, gx = gx, gz = gz, floor = floor, rot = rot }
	P.workshop.layout[#P.workshop.layout + 1] = e
	P.workshop.buffers[uid] = newBuffer()
	return e
end

function Place.place(P, machineId, gx, gz, floor, rot, free)
	local code = Place.check(P, machineId, gx, gz, floor, rot)
	if code then return nil, code end
	code = Place.limitCode(P, machineId)
	if code then return nil, code end
	local cost = free and 0 or Machines[machineId].cost
	if not Eco.pay(P, cost) then return nil, "NO_FUNDS" end
	local e = addEntity(P, machineId, gx, gz, floor, rot)
	e.paid = cost
	return e
end

-- Everything stored in an entity, as one item map (job inputs are refunded as well).
function Place.contents(P, uid)
	local b = P.workshop.buffers[uid]
	local all = {}
	if not b then return all end
	local function take(t) for id, n in pairs(t or {}) do all[id] = (all[id] or 0) + n end end
	take(b.inv) take(b.out) take(b.fluids) take(b.outFluid)
	if b.fuel and b.fuel > 0 then all.fuel_charcoal = (all.fuel_charcoal or 0) + b.fuel end
	if b.item then all[b.item] = (all[b.item] or 0) + 1 end
	if b.job and b.job.inputs then take(b.job.inputs) end
	return all
end

function Place.remove(P, uid)
	local e, index = Place.find(P, uid)
	if not e then return nil, "NOT_FOUND" end
	local contents = Place.contents(P, uid)
	if not Inv.canAdd(P.items, contents, Inv.PLAYER) then return nil, "NO_SPACE" end
	Inv.add(P.items, contents)
	table.remove(P.workshop.layout, index)
	P.workshop.buffers[uid] = nil
	local refund = math.floor((e.paid or 0) * Config.refundFactor)
	Eco.earn(P, refund)
	P.stats.coinsEarned = P.stats.coinsEarned - refund      -- a refund is not income
	for _, other in ipairs(P.workshop.layout) do
		if other.link == uid then other.link = nil end
	end
	return { refund = refund, returned = contents }
end

function Place.rotate(P, uid)
	local e = Place.find(P, uid)
	if not e then return nil, "NOT_FOUND" end
	local rot = (e.rot + 1) % 4
	local code = Place.check(P, e.machine, e.gx, e.gz, e.floor, rot, uid)
	if code then return nil, code end
	e.rot = rot
	return e
end

-- Starter layout: kettle, one crate and the shop shelf next to the entrance.
function Place.starter(P)
	local n = Place.cells(P)
	local mid = math.floor(n / 2)
	addEntity(P, "kettle", mid - 6, mid - 2, 1, 2).recipe = nil
	addEntity(P, "storage_crate", mid + 2, 3, 1, 0)
	addEntity(P, "shop_shelf", mid + 3, 1, 1, 2)
end

-- ---- blueprints ----
function Place.saveBlueprint(P, slot, name, uids)
	local maxSlots = P.research.master_blueprints and Config.limits.blueprintSlotsMaster or Config.limits.blueprintSlots
	if slot < 1 or slot > maxSlots then return nil, "LIMIT" end
	if #uids < 1 or #uids > Config.limits.blueprintParts then return nil, "LIMIT" end
	local parts, minX, minZ, floor, seen = {}, math.huge, math.huge, nil, {}
	for _, uid in ipairs(uids) do
		local e = Place.find(P, uid)
		if not e or seen[uid] then return nil, "NOT_FOUND" end
		seen[uid] = true
		floor = floor or e.floor
		if e.floor ~= floor then return nil, "BAD_REQUEST" end
		minX, minZ = math.min(minX, e.gx), math.min(minZ, e.gz)
	end
	local cost = 0
	for _, uid in ipairs(uids) do
		local e = Place.find(P, uid)
		parts[#parts + 1] = { machine = e.machine, dx = e.gx - minX, dz = e.gz - minZ, rot = e.rot, recipe = e.recipe,
			filter = e.filter and Util.deepCopy(e.filter) or nil }
		cost = cost + Machines[e.machine].cost
	end
	P.blueprints[tostring(slot)] = { name = string.sub(name, 1, 24), parts = parts, estimateCost = cost }
	return P.blueprints[tostring(slot)]
end

-- All or nothing: every part must be unlocked, affordable, within limits and free of overlaps.
function Place.placeBlueprint(P, slot, gx, gz, floor)
	local bp = P.blueprints[tostring(slot)]
	if not bp then return nil, "NOT_FOUND" end
	local backup = { layout = Util.deepCopy(P.workshop.layout), buffers = Util.deepCopy(P.workshop.buffers),
		nextUid = P.workshop.nextUid, wallet = P.wallet }
	local placed = {}
	for _, part in ipairs(bp.parts) do
		local e, code = Place.place(P, part.machine, gx + part.dx, gz + part.dz, floor, part.rot)
		if not e then
			P.workshop.layout, P.workshop.buffers = backup.layout, backup.buffers
			P.workshop.nextUid, P.wallet = backup.nextUid, backup.wallet
			return nil, code
		end
		if part.recipe and Recipes[part.recipe] and P.research[Recipes[part.recipe].requiredResearch] then
			e.recipe = part.recipe
		end
		e.filter = part.filter and Util.deepCopy(part.filter) or nil
		placed[#placed + 1] = e.uid
	end
	return placed
end
return Place
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000045"><Properties><string name="Name">ProductionService</string><ProtectedString name="Source"><![CDATA[-- Machine jobs: the only code that consumes recipe inputs and creates outputs.
local D = require(script.Parent.Data)
local Config, Machines, Recipes, Items, Util = D.Config, D.Machines, D.Recipes, D.Items, D.Util
local Prod = {}

local function storeFor(b, item)
	return (Items[item].unit == "ml") and b.fluids or b.inv
end

-- nil if the job can start, else state name and the missing item.
function Prod.missing(b, r)
	if r.fuelUnits and b.fuel < r.fuelUnits then return "NoFuel", "fuel_charcoal" end
	for _, item in ipairs(Util.sortedKeys(r.inputs)) do
		if (storeFor(b, item)[item] or 0) < r.inputs[item] then return "WaitingForInputs", item end
	end
	return nil
end

local function outputRoom(b, r)
	for item, n in pairs(r.outputs) do
		if Items[item].unit == "ml" then
			if (b.outFluid[item] or 0) + n > Config.machine.fluidCap then return false end
		elseif (b.out[item] or 0) + n > math.max(Config.machine.outputCap, n) then return false end
	end
	return true
end

function Prod.step(P, G, dt, emit)
	local buffers = P.workshop.buffers
	for _, uid in ipairs(G.order) do
		local e, b = G.ents[uid], buffers[uid]
		local def = Machines[e.machine]
		if def.kind == "pump" then
			b.acc = (b.acc or 0) + Config.sim.pumpMlPerSec * dt
			local add = math.floor(b.acc)
			b.acc = b.acc - add
			b.fluids.water = math.min(Config.machine.fluidCap, (b.fluids.water or 0) + add)
			b.state = (b.fluids.water >= Config.machine.fluidCap) and "OutputBlocked" or "Running"
		elseif def.kind == "machine" then
			if e.paused then
				b.state = "Paused"
			else
				local budget, cycles = dt, 0
				while true do
					if not b.job then
						local r = e.recipe and Recipes[e.recipe]
						if not r then b.state, b.waiting = "InvalidRecipe", nil break end
						local state, item = Prod.missing(b, r)
						if state then b.state, b.waiting = state, item break end
						for item2, n in pairs(r.inputs) do
							local store = storeFor(b, item2)
							store[item2] = store[item2] - n
							if store[item2] == 0 then store[item2] = nil end
						end
						if r.fuelUnits then b.fuel = b.fuel - r.fuelUnits end
						b.job = { recipe = r.id, remaining = r.durationSec, auto = (b.auto == true) or (r.source == true),
							inputs = Util.deepCopy(r.inputs) }
						b.waiting = nil
					end
					if b.job.remaining > budget then
						b.job.remaining = b.job.remaining - budget
						b.state = "Running"
						break
					end
					budget = budget - b.job.remaining
					b.job.remaining = 0
					local r = Recipes[b.job.recipe]
					if not outputRoom(b, r) then b.state = "OutputBlocked" break end
					for item, n in pairs(r.outputs) do
						if Items[item].unit == "ml" then b.outFluid[item] = (b.outFluid[item] or 0) + n
						else b.out[item] = (b.out[item] or 0) + n end
						emit({ type = "craft", item = item, n = n, auto = b.job.auto, recipe = r.id, uid = uid })
					end
					b.job = nil
					cycles = cycles + 1
					if cycles >= Config.sim.maxCyclesPerTick then b.state = "Running" break end
				end
			end
		end
	end
end
return Prod
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000046"><Properties><string name="Name">ProfileService</string><ProtectedString name="Source"><![CDATA[-- Player profile: creation, (de)serialisation, schema migration and repair. Pure data, no DataStore here.
local D = require(script.Parent.Data)
local Place = require(script.Parent.PlacementService)
local Inv = require(script.Parent.InventoryService)
local Config, Items, Machines, Recipes, Research, Util = D.Config, D.Items, D.Machines, D.Recipes, D.Research, D.Util
local Profile = {}

function Profile.new(userId)
	local P = {
		schemaVersion = Config.schemaVersion, userId = userId, revision = 0,
		wallet = Config.start.coins, knowledge = 0, repPoints = 0,
		items = Util.deepCopy(Config.start.items),
		research = { starter_alchemy = true }, discoveries = {},
		quest = { main = 1, progress = 0, visited = {}, chains = {}, orders = { list = {}, serial = 0, nextRefresh = 0, repDay = 0, repToday = 0 } },
		workshop = { sizeTier = 1, floors = 1, nextUid = 1, layout = {}, buffers = {} },
		shop = { rng = (userId % 2147483000) + 17, nextIn = 12, demand = {}, demandIn = 0 },
		blueprints = {}, claims = {}, experiment = { day = 0, count = 0 },
		stats = { sold = 0, crafted = 0, coinsEarned = 0 }, settings = {}, quarantine = {},
		lastSaveUnix = 0,
	}
	Place.starter(P)
	return P
end

-- Plain data only: a deep copy is the serialised form.
function Profile.serialize(P, now)
	local out = Util.deepCopy(P)
	out.lastSaveUnix = now or 0
	return out
end

Profile.migrations = {
	-- [fromVersion] = function(data) ... return data end
}

-- Returns profile, report. Never raises on bad content; invalid parts go to `quarantine`.
function Profile.load(data, userId)
	if type(data) ~= "table" then return nil, { fatal = "not a table" } end
	local report = { fixed = {} }
	local P = Util.deepCopy(data)
	local version = P.schemaVersion
	if type(version) ~= "number" or version > Config.schemaVersion then
		return nil, { fatal = "unknown schema version" }
	end
	while version < Config.schemaVersion do
		local step = Profile.migrations[version]
		if not step then return nil, { fatal = "no migration from " .. version } end
		P = step(P)
		version = version + 1
		P.schemaVersion = version
	end
	local fresh = Profile.new(userId)
	local function note(msg) report.fixed[#report.fixed + 1] = msg end
	for key, default in pairs(fresh) do
		if type(P[key]) ~= type(default) then
			P[key] = default
			note("reset " .. key)
		end
	end
	P.userId = userId
	local function cleanInt(v, lo) return Util.isInt(v) and v >= lo end
	if not cleanInt(P.wallet, 0) then P.wallet = 0 note("wallet") end
	if not cleanInt(P.knowledge, 0) then P.knowledge = 0 note("knowledge") end
	if not cleanInt(P.repPoints, 0) then P.repPoints = 0 note("rep") end
	local function cleanStore(store, where)
		for id, n in pairs(store) do
			if not Items[id] or not cleanInt(n, 1) then
				P.quarantine[#P.quarantine + 1] = { where = where, id = tostring(id), amount = tostring(n) }
				store[id] = nil
				note("item " .. tostring(id))
			end
		end
	end
	cleanStore(P.items, "inventory")
	for id in pairs(P.research) do
		if not Research[id] then P.research[id] = nil note("research " .. tostring(id)) end
	end
	P.research.starter_alchemy = true
	local w = P.workshop
	if not (cleanInt(w.sizeTier, 1) and Config.plotTiers[w.sizeTier]) then w.sizeTier = 1 note("sizeTier") end
	if not (cleanInt(w.floors, 1) and Config.floors[w.floors]) then w.floors = 1 note("floors") end
	-- rebuild the layout entity by entity; broken entries are dropped and their contents returned
	local old, oldBuffers = w.layout, w.buffers
	w.layout, w.buffers = {}, {}
	local maxUid = 0
	for _, e in ipairs(old) do
		local ok = type(e) == "table" and type(e.uid) == "string" and Machines[e.machine] ~= nil
			and not w.buffers[e.uid]
			and Place.check(P, e.machine, e.gx, e.gz, e.floor, e.rot) == nil
		local b = type(e) == "table" and oldBuffers[e.uid] or nil
		if ok then
			if e.recipe and not (Recipes[e.recipe] and Recipes[e.recipe].machineId == e.machine) then e.recipe = nil end
			w.layout[#w.layout + 1] = e
			local nb = Place.newBuffer()
			if type(b) == "table" then
				for _, key in ipairs({ "inv", "out", "fluids", "outFluid" }) do
					if type(b[key]) == "table" then nb[key] = b[key] cleanStore(nb[key], e.uid) end
				end
				if cleanInt(b.fuel, 0) then nb.fuel = b.fuel end
				if type(b.item) == "string" and Items[b.item] then nb.item = b.item nb.t = 0 end
				if type(b.job) == "table" and Recipes[b.job.recipe] and Util.isFinite(b.job.remaining) then
					nb.job = { recipe = b.job.recipe, remaining = math.max(0, b.job.remaining), auto = b.job.auto == true,
						inputs = Util.deepCopy(Recipes[b.job.recipe].inputs) }
				end
				nb.auto = b.auto == true
				nb.rr = cleanInt(b.rr, 0) and b.rr or nil
			end
			w.buffers[e.uid] = nb
			local num = tonumber(string.match(e.uid, "^m(%d+)$"))
			if num and num > maxUid then maxUid = num end
		else
			note("entity " .. tostring(type(e) == "table" and e.uid or "?"))
			if type(b) == "table" then
				P.workshop.buffers.__tmp = b
				local contents = Place.contents(P, "__tmp")
				P.workshop.buffers.__tmp = nil
				for id, n in pairs(contents) do
					if Items[id] and cleanInt(n, 1) then P.items[id] = (P.items[id] or 0) + n end
				end
			end
		end
	end
	if not cleanInt(w.nextUid, maxUid + 1) then w.nextUid = maxUid + 1 end
	if not cleanInt(P.quest.main, 1) then P.quest.main = 1 note("quest") end
	return P, report
end
return Profile
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000047"><Properties><string name="Name">ProfileStore</string><ProtectedString name="Source"><![CDATA[-- Persistence adapter. `store` must offer GetAsync(key) and UpdateAsync(key, fn) like a Roblox
-- GlobalDataStore; tests inject a mock.  Rules (spec §13):
--   * a failed load never yields a fresh default profile that could overwrite the real one
--   * saves go through UpdateAsync, refuse to overwrite a newer revision and keep a session lock
--   * every call is wrapped in pcall with bounded retries
local D = require(script.Parent.Data)
local Profile = require(script.Parent.ProfileService)
local Store = {}
Store.__index = Store
Store.LOCK_STALE_SEC = 600
Store.RETRIES = 3

-- opts: { store, serverId, now = function() -> unix seconds, wait = function(seconds) }
function Store.new(opts)
	return setmetatable({ store = opts.store, serverId = opts.serverId, now = opts.now, wait = opts.wait or function() end,
		revisions = {} }, Store)
end

local function key(userId) return "player:" .. tostring(userId) end

function Store:_retry(fn)
	local lastErr
	for attempt = 1, Store.RETRIES do
		local ok, a, b = pcall(fn)
		if ok then return true, a, b end
		lastErr = a
		if attempt < Store.RETRIES then self.wait(0.5 * attempt + (attempt * 7 % 3) * 0.1) end
	end
	return false, lastErr
end

-- Returns profile, status. status: "new" | "ok" | "repaired" | "locked" | "failed" | "corrupt".
-- Only "new", "ok" and "repaired" return a profile that may be played and saved.
function Store:load(userId)
	local now = self.now()
	local status, data
	local ok, err = self:_retry(function()
		self.store:UpdateAsync(key(userId), function(old)
			if old == nil then
				status = "new"
				return nil
			end
			local lock = old.lock
			if type(lock) == "table" and lock.serverId ~= self.serverId and now - (lock.at or 0) < Store.LOCK_STALE_SEC then
				status = "locked"
				return nil
			end
			status, data = "ok", old
			old.lock = { serverId = self.serverId, at = now }
			return old
		end)
	end)
	if not ok then return nil, "failed", err end
	if status == "locked" then return nil, "locked" end
	if status == "new" then
		self.revisions[userId] = 0
		return Profile.new(userId), "new"
	end
	local P, report = Profile.load(data.profile, userId)
	if not P then return nil, "corrupt", report.fatal end
	self.revisions[userId] = data.revision or 0
	return P, (#report.fixed > 0) and "repaired" or "ok", report
end

-- Returns true or false, reason. release = drop the session lock (player leaves).
function Store:save(userId, P, release)
	local known = self.revisions[userId]
	if known == nil then return false, "not loaded" end
	local now = self.now()
	local conflict
	local ok, err = self:_retry(function()
		conflict = nil
		self.store:UpdateAsync(key(userId), function(old)
			if old ~= nil then
				if (old.revision or 0) > known then conflict = "newer revision exists" return nil end
				local lock = old.lock
				if type(lock) == "table" and lock.serverId ~= self.serverId and now - (lock.at or 0) < Store.LOCK_STALE_SEC then
					conflict = "locked by another server"
					return nil
				end
			end
			local doc = { revision = known + 1, savedAt = now, profile = Profile.serialize(P, now) }
			doc.profile.revision = known + 1
			if not release then doc.lock = { serverId = self.serverId, at = now } end
			return doc
		end)
	end)
	if not ok then return false, err end
	if conflict then return false, conflict end
	self.revisions[userId] = known + 1
	P.revision = known + 1
	if release then self.revisions[userId] = nil end
	return true
end
return Store
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000048"><Properties><string name="Name">QuestService</string><ProtectedString name="Source"><![CDATA[-- Sole writer of quest state: main quests, NPC chains, repeatable orders.
local D = require(script.Parent.Data)
local Eco = require(script.Parent.EconomyService)
local Inv = require(script.Parent.InventoryService)
local Metrics = require(script.Parent.MetricsService)
local Config, Quests, Recipes, Items, Locations, Util = D.Config, D.Quests, D.Recipes, D.Items, D.Locations, D.Util
local Q = {}

local mainIndex = {}
for i, id in ipairs(Quests.mainOrder) do mainIndex[id] = i end

function Q.current(P) return Quests.main[Quests.mainOrder[P.quest.main]] end
function Q.isDone(P, questId) return (mainIndex[questId] or math.huge) < P.quest.main end

function Q.ruleMet(P, rule)
	if not rule then return true end
	if rule.research and not P.research[rule.research] then return false end
	if rule.quest and not Q.isDone(P, rule.quest) then return false end
	if rule.rep and Eco.repLevel(P) < rule.rep then return false end
	return true
end
function Q.locationUnlocked(P, locationId)
	local loc = Locations.locations[locationId]
	return loc ~= nil and Q.ruleMet(P, loc.unlock)
end

local function pay(P, rw)
	Eco.earn(P, rw.coins or 0)
	Eco.addKnowledge(P, rw.knowledge or 0)
	Eco.addRep(P, rw.rep or 0)
end

local function objectiveDone(P, rt, o)
	if o.visit and not P.quest.visited[o.visit] then return false end
	local t = o.type
	if t == "enter_workshop" then return P.quest.progress >= 1
	elseif t == "craft" or t == "sell" then return P.quest.progress >= (o.count or 1)
	elseif t == "piped" then return P.quest.progress >= o.ml
	elseif t == "research" then return P.research[o.id] == true
	elseif t == "floors" then return P.workshop.floors >= o.count
	elseif t == "lines" then return rt ~= nil and Metrics.autoProductLines(rt.stats, rt.clock, o.windowSec) >= o.count
	elseif t == "rate" then
		return rt ~= nil and rt.clock >= o.windowSec and Metrics.rate(rt.stats, rt.clock, o.windowSec) >= o.perMin
	end
	return false   -- deliver: only through claim
end

-- Feeds simulation / action events into quest progress and first-craft discoveries.
function Q.onEvents(P, events, notify)
	for _, ev in ipairs(events) do
		if ev.type == "craft" and ev.recipe and not P.discoveries[ev.recipe] then
			P.discoveries[ev.recipe] = true
			local k = Recipes[ev.recipe].knowledgeRewardFirstCraft or 0
			Eco.addKnowledge(P, k)
			if notify and k > 0 then notify({ kind = "discovery", recipe = ev.recipe, knowledge = k }) end
		end
		if ev.type == "visit" then P.quest.visited[ev.at] = true end
		local q = Q.current(P)
		if q then
			local o = q.objective
			if o.type == "enter_workshop" and ev.type == "enter_workshop" then
				P.quest.progress = 1
			elseif o.type == "craft" and ev.type == "craft" and (o.item == nil or o.item == ev.item)
				and (not o.auto or ev.auto) then
				P.quest.progress = P.quest.progress + ev.n
			elseif o.type == "sell" and ev.type == "sell" then
				P.quest.progress = P.quest.progress + ev.n
			elseif o.type == "piped" and ev.type == "piped" then
				P.quest.progress = P.quest.progress + ev.ml
			end
		end
	end
end

local function advance(P, q, notify)
	pay(P, q.rewards)
	P.quest.main = P.quest.main + 1
	P.quest.progress = 0
	if notify then notify({ kind = "quest_done", quest = q.id, rewards = q.rewards }) end
end

-- Completes every main quest whose (non-delivery) objective is fulfilled. Each reward is paid once.
function Q.evaluate(P, rt, notify)
	local guard = 0
	while guard < 25 do
		guard = guard + 1
		local q = Q.current(P)
		if not q or q.objective.type == "deliver" or not objectiveDone(P, rt, q.objective) then break end
		advance(P, q, notify)
	end
end

-- Which items would a delivery objective take from the inventory? nil if not possible.
local function deliveryItems(P, o)
	if o.items then
		return Inv.has(P.items, o.items) and o.items or nil
	end
	local take, left = {}, o.count
	for _, id in ipairs(o.anyOf) do
		local n = math.min(left, P.items[id] or 0)
		if n > 0 then take[id] = n left = left - n end
	end
	return (left == 0) and take or nil
end

function Q.claimMain(P, questId, notify)
	local q = Q.current(P)
	if not q or q.id ~= questId or q.objective.type ~= "deliver" then return nil, "NOT_READY" end
	local take = deliveryItems(P, q.objective)
	if not take then return nil, "NO_ITEMS" end
	Inv.remove(P.items, take)
	advance(P, q, notify)
	return q
end

function Q.chainStep(P, chainId)
	local c = Quests.chains[chainId]
	if not c then return nil end
	return c.steps[(P.quest.chains[chainId] or 0) + 1], c
end

function Q.claimChain(P, chainId, notify)
	local step = Q.chainStep(P, chainId)
	if not step then return nil, "NOT_FOUND" end
	if not Inv.remove(P.items, step.objective.items) then return nil, "NO_ITEMS" end
	P.quest.chains[chainId] = (P.quest.chains[chainId] or 0) + 1
	pay(P, step.rewards)
	if notify then notify({ kind = "chain_step", chain = chainId, step = step.id, rewards = step.rewards }) end
	return step
end

-- ---- repeatable orders ----
local templateById = {}
for _, t in ipairs(Quests.orders) do templateById[t.id] = t end

function Q.orderReward(t)
	local coins = 0
	for item, n in pairs(t.items) do
		local base = Items[item].sellBase
		if base > 0 then coins = coins + base * n * t.coinFactor else coins = coins + n * t.coinFactor end
	end
	return math.floor(coins)
end

function Q.refreshOrders(P, now)
	local board = P.quest.orders
	if now >= board.nextRefresh then
		board.list = {}
		board.nextRefresh = now + Config.orders.refreshSec
	end
	local onBoard, eligible = {}, {}
	for _, o in ipairs(board.list) do onBoard[o.tpl] = true end
	for _, t in ipairs(Quests.orders) do
		if not onBoard[t.id] and (not t.need or P.research[t.need]) then eligible[#eligible + 1] = t.id end
	end
	local rng = board.rng or (P.userId % 100000 + 7)
	while #board.list < Config.orders.active and #eligible > 0 do
		local r
		rng, r = Util.nextRandom(rng)
		local pick = table.remove(eligible, math.floor(r * #eligible) + 1)
		board.serial = board.serial + 1
		board.list[#board.list + 1] = { id = "ord" .. board.serial, tpl = pick }
	end
	board.rng = rng
end

function Q.claimOrder(P, orderId, now, notify)
	local board = P.quest.orders
	for i, o in ipairs(board.list) do
		if o.id == orderId then
			local t = templateById[o.tpl]
			if not Inv.remove(P.items, t.items) then return nil, "NO_ITEMS" end
			table.remove(board.list, i)
			local coins = Q.orderReward(t)
			Eco.earn(P, coins)
			local day = math.floor(now / 86400)
			if board.repDay ~= day then board.repDay, board.repToday = day, 0 end
			local rep = math.min(t.rep, Config.orders.repPerOrderCapPerDay - board.repToday)
			if rep > 0 then
				Eco.addRep(P, rep)
				board.repToday = board.repToday + rep
			end
			Q.refreshOrders(P, now)
			if notify then notify({ kind = "order_done", order = t.id, coins = coins, rep = math.max(rep, 0) }) end
			return { coins = coins, rep = math.max(rep, 0), tpl = t.id }
		end
	end
	return nil, "NOT_FOUND"
end
Q.templateById = templateById
return Q
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000049"><Properties><string name="Name">ResearchService</string><ProtectedString name="Source"><![CDATA[-- Sole writer of research unlocks.
local D = require(script.Parent.Data)
local Eco = require(script.Parent.EconomyService)
local Research = D.Research
local R = {}
function R.canUnlock(P, id)
	local node = Research[id]
	if not node then return "NOT_FOUND" end
	if P.research[id] then return "DUPLICATE" end
	for _, p in ipairs(node.prereqs) do
		if not P.research[p] then return "LOCKED" end
	end
	if P.knowledge < node.cost then return "NO_FUNDS" end
	return nil
end
function R.unlock(P, id)
	local code = R.canUnlock(P, id)
	if code then return nil, code end
	Eco.spendKnowledge(P, Research[id].cost)
	P.research[id] = true
	return Research[id]
end
return R
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000050"><Properties><string name="Name">ResourceArt</string><ProtectedString name="Source"><![CDATA[-- Generated by blender/build_resource_assets.py. Do not edit.
-- Bounds of the resource models in Roblox axes, relative to the ground point of the node.
return {
	res_herb_mint = { center = {0.1508, 0.6968, 0}, size = {4.4362, 1.8936, 4.3332} },
	res_herb_sunleaf = { center = {0.0633, 1.414, -0.093}, size = {4.0734, 3.328, 4.3222} },
	res_herb_moonleaf = { center = {0.0603, 1.0711, 0}, size = {3.8794, 2.6422, 3.9392} },
	res_mushroom_gloom = { center = {-0.0033, 1.1785, -0.0099}, size = {3.7907, 2.557, 3.3992} },
	res_berry_red = { center = {0.0442, 1.4004, 0.0395}, size = {4.4594, 3.2008, 3.3177} },
