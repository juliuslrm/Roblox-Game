<Item class="ModuleScript" referent="RBX000024"><Properties><string name="Name">Protocol</string><ProtectedString name="Source"><![CDATA[-- Network contract. Payload field types: "int" (small integer), "user" (Roblox user id), "num", "str", "bool",
-- "id" (short string), "ids" (array of ids), "cells" (array of { gx, gz, rot } integers).
-- A field name ending in "?" is optional.
local P = {}
P.remoteName = "ArcaneRequest"
P.eventName = "ArcaneEvent"
P.actions = {
	BuyMarketOffer = { merchant = "id", item = "id" },
	GatherNode = { node = "id" },
	EnterWorkshop = { ["owner?"] = "user" },
	LeaveWorkshop = {},
	PlaceMachine = { machine = "id", gx = "int", gz = "int", floor = "int", rot = "int" },
	RemoveMachine = { uid = "id" },
	RotateMachine = { uid = "id" },
	SetMachinePorts = { uid = "id", ["inSide?"] = "int", ["outSide?"] = "int", ["auto?"] = "bool" },
	PlaceBelts = { machine = "id", floor = "int", cells = "cells" },
	SetRecipe = { uid = "id", ["recipe?"] = "id" },
	StartManualCraft = { uid = "id", recipe = "id" },
	TransferStack = { from = "id", to = "id", item = "id", amount = "int", ["slot?"] = "id" },
	SetFilter = { uid = "id", ["items?"] = "ids", ["link?"] = "id" },
	ToggleMachine = { uid = "id" },
	BuyUpgrade = { kind = "id" },
	UnlockResearch = { research = "id" },
	StockShelf = { uid = "id", item = "id", amount = "int" },
	ClaimOrder = { kind = "id", id = "id" },
	DonateProject = { amount = "int" },
	InviteCoOp = { user = "user", role = "id" },
	SetCoOpPermission = { user = "user", role = "id" },
	SaveBlueprint = { slot = "int", name = "str", uids = "ids" },
	PlaceBlueprint = { slot = "int", gx = "int", gz = "int", floor = "int" },
	Experiment = { uid = "id" },
	RequestSnapshot = {},
}
P.codes = { OK = "OK", BAD_REQUEST = "BAD_REQUEST", RATE_LIMITED = "RATE_LIMITED", DUPLICATE = "DUPLICATE",
	NOT_FOUND = "NOT_FOUND", FORBIDDEN = "FORBIDDEN", TOO_FAR = "TOO_FAR", LOCKED = "LOCKED",
	NO_FUNDS = "NO_FUNDS", NO_ITEMS = "NO_ITEMS", NO_SPACE = "NO_SPACE", BLOCKED = "BLOCKED",
	BUSY = "BUSY", LIMIT = "LIMIT", NOT_READY = "NOT_READY", SAFE_MODE = "SAFE_MODE" }
-- German feedback texts for result codes (UI falls back to the code).
P.messages = {
	BAD_REQUEST = "Ungültige Anfrage.", RATE_LIMITED = "Zu schnell – kurz warten.", DUPLICATE = "Bereits verarbeitet.",
	NOT_FOUND = "Nicht gefunden.", FORBIDDEN = "Dafür fehlt dir die Berechtigung.", TOO_FAR = "Du bist zu weit entfernt.",
	LOCKED = "Noch nicht freigeschaltet.", NO_FUNDS = "Nicht genug Münzen oder Wissen.", NO_ITEMS = "Es fehlen Zutaten.",
	NO_SPACE = "Kein Platz im Ziel.", BLOCKED = "Dort ist kein Platz frei.", BUSY = "Die Maschine arbeitet gerade.",
	LIMIT = "Limit erreicht.", NOT_READY = "Noch nicht erfüllt.", SAFE_MODE = "Spielstand konnte nicht geladen werden – nur Ansehen möglich.",
}
return P
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000025"><Properties><string name="Name">Quests</string><ProtectedString name="Source"><![CDATA[-- Quest data. Objective types:
--   enter_workshop | craft{item,count,auto?} | sell{count} | deliver{items,at} | visit{at}
--   research{id} | place{machine} | piped{ml} | floors{count} | lines{count,windowSec} | rate{perMin,windowSec}
-- rewards: coins, knowledge, rep, flag
local Q = { main = {}, mainOrder = {}, chains = {}, orders = {}, projects = {} }
local function main(id, title, hint, objective, coins, knowledge, rep, giver)
	Q.main[id] = { id = id, title = title, dialogueKey = "main." .. id, hint = hint, objective = objective,
		rewards = { coins = coins, knowledge = knowledge, rep = rep }, giver = giver or "town_hall",
		prerequisite = Q.mainOrder[#Q.mainOrder] }
	Q.mainOrder[#Q.mainOrder + 1] = id
end
main("q01", "Deine Werkstatt wartet", "Folge dem Wegweiser „Deine Werkstatt“ und geh hinein.", { type = "enter_workshop" }, 0, 5, 0, "plaza")
main("q02", "Der erste Trank", "Braue am Kessel 1 Kleines Tonikum (2 Minze + Wasser).", { type = "craft", item = "tonic_minor", count = 1 }, 10, 8, 0, "workshop_door")
main("q03", "Ware ins Regal", "Stelle einen Trank ins Verkaufsregal und warte auf Kundschaft.", { type = "sell", count = 1 }, 15, 10, 2, "workshop_door")
main("q04", "Drei für die Markthalle", "Liefere 3 Tränke deiner Wahl in der Markthalle ab.", { type = "deliver", at = "market_hall", anyOf = { "tonic_minor", "vitality_draught", "night_ink" }, count = 3 }, 60, 15, 6)
main("q05", "Mühlenwissen", "Besuche die Windmühle, erforsche Kräuterkunde und mahle Minzpulver.", { type = "craft", item = "mint_powder", count = 2, visit = "windmill" }, 50, 25, 4)
main("q06", "Glas für Phiolen", "Erforsche Handwerk und Glashütte, schmilz Sand und blase 1 Phiole.", { type = "craft", item = "vial", count = 1 }, 80, 25, 4)
main("q07", "Bänder statt Beine", "Erforsche Förderbänder in der Markthalle.", { type = "research", id = "belt_basics" }, 100, 30, 4)
main("q08", "Die erste Kette", "Lass eine Maschine 5 Stück herstellen, die über Trichter und Band beliefert wird.", { type = "craft", count = 5, auto = true }, 120, 40, 8)
main("q09", "Wasser marsch", "Baue eine Brunnenpumpe und leite 3000 ml Wasser direkt in eine Maschine.", { type = "piped", ml = 3000 }, 140, 45, 6)
main("q10", "Tatkraft in Flaschen", "Stelle 1 Trank der Tatkraft her (Extraktor + Abfüller).", { type = "craft", item = "potion_vigor", count = 1 }, 180, 50, 8)
main("q11", "Die Schmiedelizenz", "Sprich mit dem Schmied und erforsche Schmiedekunst.", { type = "research", id = "smithing", visit = "smithy" }, 200, 55, 8)
main("q12", "Kupfer fließt", "Schmilz 1 Kupferbarren.", { type = "craft", item = "copper_ingot", count = 1 }, 220, 60, 8)
main("q13", "Runen und Glück", "Fertige 1 Glücksamulett (Runentisch + Verzauberungspult).", { type = "craft", item = "charm_luck", count = 1 }, 320, 70, 12)
main("q14", "Hoch hinaus", "Erforsche Etagenbau und kaufe im Rathaus die zweite Etage.", { type = "floors", count = 2 }, 300, 80, 12)
main("q15", "Zwei Linien", "Lass innerhalb von 3 Minuten zwei verschiedene Produkte automatisch entstehen.", { type = "lines", count = 2, windowSec = 180 }, 400, 90, 14)
main("q16", "Mondessenz", "Erforsche Mondbotanik und gewinne 1000 ml Mondextrakt.", { type = "craft", item = "lunar_extract", count = 1000 }, 450, 110, 14)
main("q17", "Kristallveredelung", "Schleife 1 Kristallkern.", { type = "craft", item = "crystal_core", count = 1 }, 500, 130, 16)
main("q18", "Stabiler Betrieb", "Erreiche 10 hergestellte Teile pro Minute, gemessen über eine volle Minute.", { type = "rate", perMin = 10, windowSec = 60 }, 600, 150, 18)
main("q19", "Die Leerensaat", "Stelle 1 Leerensaat im Meisterkessel her.", { type = "craft", item = "void_seed", count = 1 }, 800, 180, 20)
main("q20", "Das Meisterelixier", "Braue das Meisterelixier und bring es zur Dorfzeremonie ins Rathaus.", { type = "deliver", at = "town_hall", items = { elixir_master = 1 } }, 2500, 0, 60)

-- NPC story chains: 8 characters, 3 deliveries each, strictly in order.
local function chain(id, npc, at, name, steps)
	local c = { id = id, npc = npc, at = at, name = name, steps = {} }
	for i, s in ipairs(steps) do
		c.steps[i] = { id = id .. "_" .. i, title = s[1], objective = { type = "deliver", at = at, items = s[2] },
			rewards = { coins = s[3], knowledge = s[4], rep = s[5] } }
	end
	Q.chains[id] = c
end
chain("c_baker", "npc_baker", "bakery", "Die müde Bäckerin", {
	{ "Wach bleiben", { vitality_draught = 2 }, 70, 8, 6 }, { "Beerenglasur", { berry_tonic = 3 }, 180, 12, 8 },
	{ "Festtagsbrot", { potion_vigor = 4 }, 420, 18, 12 } })
chain("c_innkeeper", "npc_innkeeper", "tavern", "Der Goldene Krug", {
	{ "Hausmarke", { tonic_minor = 4 }, 110, 8, 6 }, { "Tinte fürs Gästebuch", { night_ink = 3 }, 140, 10, 8 },
	{ "Traumzimmer", { dream_draught = 3 }, 520, 20, 14 } })
chain("c_miller", "npc_miller", "windmill", "Mühlstein und Minze", {
	{ "Mahlprobe", { mint_powder = 4 }, 60, 10, 6 }, { "Bretter fürs Mühlrad", { plank = 6 }, 120, 12, 8 },
	{ "Feines Steinmehl", { stone_dust = 8 }, 200, 16, 10 } })
chain("c_farmer", "npc_farmer", "farm", "Saat und Ernte", {
	{ "Stärkung fürs Feld", { vitality_draught = 3 }, 100, 8, 6 }, { "Beerenernte", { berry_mash = 6 }, 150, 12, 8 },
	{ "Gesunde Beete", { tonic_bottled = 4 }, 320, 18, 12 } })
chain("c_smith", "npc_smith", "smithy", "Feuer und Eisen", {
	{ "Kupfer für Beschläge", { copper_ingot = 3 }, 260, 14, 10 }, { "Eisen für den Amboss", { iron_ingot = 3 }, 300, 16, 10 },
	{ "Schutz für die Wache", { ring_warding = 2 }, 520, 24, 16 } })
chain("c_fisher", "npc_fisher", "fisher", "Am Bach", {
	{ "Gegen die Kälte", { tonic_minor = 3 }, 80, 8, 6 }, { "Netzknoten", { plank = 4 }, 100, 10, 6 },
	{ "Glück beim Fang", { charm_luck = 1 }, 240, 20, 12 } })
chain("c_priest", "npc_priest", "chapel", "Licht der Kapelle", {
	{ "Runensteine", { rune_blank = 2 }, 220, 16, 10 }, { "Nachtwache", { dream_draught = 2 }, 380, 20, 12 },
	{ "Das Relikt", { twilight_relic = 1 }, 620, 30, 20 } })
chain("c_watchman", "npc_watchman", "watchtower", "Der Blick ins Tal", {
	{ "Wache halten", { potion_vigor = 2 }, 200, 12, 8 }, { "Ein klarer Kopf", { charm_focus = 1 }, 700, 28, 16 },
	{ "Zwillingswacht", { twin_elixir = 1 }, 520, 26, 16 } })

-- Repeatable order templates for the market hall board. tier = highest unlockTier of the items.
local function order(id, title, items, coinFactor, rep, need)
	Q.orders[#Q.orders + 1] = { id = id, title = title, items = items, coinFactor = coinFactor, rep = rep, need = need }
end
order("o01", "Tonikum für den Markt", { tonic_minor = 4 }, 1.25, 3)
order("o02", "Vitaltrunk für die Bäckerei", { vitality_draught = 3 }, 1.25, 3)
order("o03", "Tinte für das Rathaus", { night_ink = 3 }, 1.25, 3)
order("o04", "Gemischte Kiste", { tonic_minor = 2, vitality_draught = 2 }, 1.3, 4)
order("o05", "Minzpulver für die Küche", { mint_powder = 6 }, 9, 2, "herbalism")
order("o06", "Bretter für den Zaun", { plank = 8 }, 8, 2, "craftsman")
order("o07", "Phiolen für den Bader", { vial = 6 }, 14, 3, "glassworks")
order("o08", "Abgefülltes Tonikum", { tonic_bottled = 4 }, 1.3, 5, "essence_craft")
order("o09", "Tatkraft für die Erntehelfer", { potion_vigor = 4 }, 1.3, 6, "essence_craft")
order("o10", "Beerentonikum fürs Fest", { berry_tonic = 5 }, 1.3, 5, "fruit_mixing")
order("o11", "Kupfer für den Kesselflicker", { copper_ingot = 4 }, 40, 5, "smithing")
order("o12", "Eisenbarren", { iron_ingot = 4 }, 45, 5, "smithing")
order("o13", "Runenrohlinge", { rune_blank = 3 }, 45, 6, "rune_study")
order("o14", "Glücksbringer", { charm_luck = 3 }, 1.3, 8, "enchantment")
order("o15", "Schutzringe für die Torwache", { ring_warding = 2 }, 1.3, 8, "enchantment")
order("o16", "Traumtrunk", { dream_draught = 3 }, 1.3, 9, "moonbotany")
order("o17", "Zwielichtrelikt für die Kapelle", { twilight_relic = 1 }, 1.35, 10, "relic_weaving")
order("o18", "Zwillingselixier", { twin_elixir = 2 }, 1.35, 12, "infusion")
order("o19", "Fokusamulett für den Gelehrten", { charm_focus = 1 }, 1.35, 12, "focus_charms")
order("o20", "Großauftrag der Gilde", { potion_vigor = 6, tonic_bottled = 6 }, 1.4, 14, "commission_contracts")

-- Village projects (one per server session, shared by all players).
Q.projects = {
	{ id = "p_lanterns", title = "Laternen für die Südstraße", item = "night_ink", count = 12, rep = 20, cosmetic = "sign_lantern" },
	{ id = "p_herbbed", title = "Kräuterbeet am Brunnen", item = "vitality_draught", count = 14, rep = 20, cosmetic = "sign_herb" },
	{ id = "p_bridgeward", title = "Schutz für die Steinbrücke", item = "ring_warding", count = 6, rep = 40, cosmetic = "sign_ward" },
}
return Q
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000026"><Properties><string name="Name">Recipes</string><ProtectedString name="Source"><![CDATA[-- Recipes. Liquid amounts are millilitres. `research` is the tech node that unlocks the recipe.
local W = 1000
local R = {}
local function add(id, tier, machine, inputs, outputs, t, research, extra)
	local r = { id = id, tier = tier, machineId = machine, inputs = inputs, outputs = outputs, durationSec = t,
		requiredResearch = research, knowledgeRewardFirstCraft = 5 }
	if extra then for k, v in pairs(extra) do r[k] = v end end
	R[id] = r
end
add("r01", 0, "kettle", { herb_mint = 2, water = W }, { tonic_minor = 1 }, 8, "starter_alchemy")
add("r02", 0, "kettle", { herb_sunleaf = 2, water = W }, { vitality_draught = 1 }, 10, "starter_alchemy")
add("r03", 0, "kettle", { mushroom_gloom = 1, herb_mint = 1, water = W }, { night_ink = 1 }, 12, "starter_alchemy")
add("r04", 1, "saw", { wood_log = 1 }, { plank = 2 }, 6, "craftsman")
add("r05", 1, "crusher", { stone = 2 }, { stone_dust = 2 }, 7, "craftsman")
add("r06", 1, "grinder", { herb_mint = 2 }, { mint_powder = 2 }, 6, "herbalism")
add("r07", 1, "grinder", { herb_sunleaf = 2 }, { sunleaf_powder = 2 }, 6, "herbalism")
add("r08", 1, "furnace", { sand = 2 }, { glass = 2 }, 12, "glassworks", { fuelUnits = 1 })
add("r09", 1, "glassbench", { glass = 1 }, { vial = 2 }, 5, "glassworks")
add("r10", 2, "extractor", { mint_powder = 1, water = W }, { herbal_extract = W }, 12, "essence_craft")
add("r11", 2, "extractor", { sunleaf_powder = 1, water = W }, { solar_extract = W }, 12, "essence_craft")
add("r12", 2, "bottler", { vial = 1, herbal_extract = W }, { tonic_bottled = 1 }, 7, "essence_craft")
add("r13", 2, "bottler", { vial = 1, solar_extract = W }, { potion_vigor = 1 }, 8, "essence_craft")
add("r14", 2, "runetable", { stone_dust = 1, crystal_raw = 1 }, { rune_blank = 1 }, 14, "rune_study")
add("r15", 2, "furnace", { ore_copper = 2 }, { copper_ingot = 1 }, 14, "smithing", { fuelUnits = 1 })
add("r16", 3, "enchanter", { copper_ingot = 1, rune_blank = 1 }, { charm_luck = 1 }, 18, "enchantment")
add("r17", 2, "furnace", { ore_iron = 2 }, { iron_ingot = 1 }, 15, "smithing", { fuelUnits = 1 })
add("r18", 3, "forge", { iron_ingot = 1, rune_blank = 1 }, { ring_warding = 1 }, 18, "enchantment", { fuelUnits = 1 })
add("r19", 3, "grinder", { herb_moonleaf = 2 }, { moon_powder = 2 }, 8, "moonbotany")
add("r20", 3, "extractor", { moon_powder = 1, water = W }, { lunar_extract = W }, 14, "moonbotany")
add("r21", 3, "bottler", { vial = 1, lunar_extract = W }, { dream_draught = 1 }, 9, "moonbotany")
add("r22", 3, "mixer", { mushroom_gloom = 1, moon_powder = 1, water = W }, { shadow_essence = W }, 15, "moonbotany")
add("r23", 4, "enchanter", { shadow_essence = W, rune_blank = 1 }, { twilight_relic = 1 }, 21, "relic_weaving")
add("r24", 2, "crusher", { berry_red = 2 }, { berry_mash = 2 }, 5, "craftsman")
add("r25", 2, "mixer", { berry_mash = 1, water = W }, { berry_tonic = 1 }, 9, "fruit_mixing")
add("r26", 4, "infuser", { potion_vigor = 1, dream_draught = 1 }, { twin_elixir = 1 }, 18, "infusion")
add("r27", 4, "crystal_refiner", { crystal_raw = 2 }, { crystal_core = 1 }, 18, "crystal_mastery")
add("r28", 4, "enchanter", { crystal_core = 1, copper_ingot = 1, rune_blank = 1 }, { charm_focus = 1 }, 24, "focus_charms")
add("r29", 5, "advanced_cauldron", { crystal_core = 1, shadow_essence = W }, { void_seed = 1 }, 30, "arcane_depths")
add("r30", 5, "advanced_cauldron", { void_seed = 1, potion_vigor = 1, dream_draught = 1 }, { elixir_master = 1 }, 36, "masterwork")
-- supply machines (not part of the 30 crafting recipes). `source` recipes need no solid input.
local S = { knowledgeRewardFirstCraft = 0, supply = true }
add("g01", 2, "herb_grower", { seed_mint = 1, water = W }, { herb_mint = 4, seed_mint = 1 }, 24, "farming", S)
add("g02", 2, "herb_grower", { seed_sunleaf = 1, water = W }, { herb_sunleaf = 4, seed_sunleaf = 1 }, 28, "farming", S)
add("d01", 3, "quarry_drill", {}, { stone = 1 }, 20, "licensed_mining", { knowledgeRewardFirstCraft = 0, supply = true, fuelUnits = 1, source = true })
add("d02", 3, "quarry_drill", {}, { ore_copper = 1 }, 30, "licensed_mining", { knowledgeRewardFirstCraft = 0, supply = true, fuelUnits = 1, source = true })
add("d03", 3, "quarry_drill", {}, { ore_iron = 1 }, 30, "licensed_mining", { knowledgeRewardFirstCraft = 0, supply = true, fuelUnits = 1, source = true })
return R
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000027"><Properties><string name="Name">Research</string><ProtectedString name="Source"><![CDATA[-- Tech tree (DAG). cost = knowledge points. unlocks: machines / recipes / features.
local T = {}
local function node(id, tier, cost, prereqs, unlocks, name)
	T[id] = { id = id, tier = tier, cost = cost, prereqs = prereqs, unlocks = unlocks, name = name }
end
node("starter_alchemy", 0, 0, {}, { "kettle", "storage_crate", "shop_shelf", "r01", "r02", "r03" }, "Grundlagen der Alchemie")
node("herbalism", 1, 10, { "starter_alchemy" }, { "grinder", "r06", "r07" }, "Kräuterkunde")
node("craftsman", 1, 12, { "starter_alchemy" }, { "saw", "crusher", "r04", "r05", "r24" }, "Handwerk")
node("glassworks", 1, 15, { "craftsman" }, { "furnace", "glassbench", "r08", "r09" }, "Glashütte")
node("storage", 1, 10, { "starter_alchemy" }, { "second_crate", "workshop_48" }, "Lagerhaltung")
node("belt_basics", 2, 25, { "herbalism", "craftsman" }, { "wooden_belt", "belt_turn", "input_hopper", "workshop_64" }, "Förderbänder")
node("flow_control", 2, 30, { "belt_basics" }, { "splitter", "merger" }, "Flusssteuerung")
node("essence_craft", 2, 30, { "herbalism", "glassworks" }, { "extractor", "bottler", "r10", "r11", "r12", "r13" }, "Essenzhandwerk")
node("fruit_mixing", 2, 20, { "craftsman" }, { "mixer", "r25" }, "Fruchtmischung")
node("water_engineering", 2, 30, { "belt_basics" }, { "well_pump" }, "Wasserbau")
node("farming", 2, 35, { "herbalism", "water_engineering" }, { "herb_grower", "g01", "g02" }, "Kräuteranbau")
node("commission_contracts", 2, 20, { "storage" }, { "order_board_tier2" }, "Lieferverträge")
node("pipe_networks", 3, 50, { "water_engineering", "essence_craft" }, { "pipe_straight", "pipe_bend", "fluid_tank" }, "Rohrnetze")
node("smart_sorting", 3, 45, { "flow_control" }, { "filter_sorter" }, "Sortierlogik")
node("smithing", 3, 50, { "glassworks" }, { "forge", "r15", "r17" }, "Schmiedekunst")
node("rune_study", 3, 55, { "craftsman", "essence_craft" }, { "runetable", "r14" }, "Runenkunde")
node("enchantment", 3, 70, { "smithing", "rune_study" }, { "enchanter", "r16", "r18" }, "Verzauberung")
node("multi_floor", 3, 60, { "belt_basics", "storage" }, { "workshop_80", "workshop_floor_2", "vertical_lift" }, "Etagenbau")
node("licensed_mining", 3, 70, { "smithing" }, { "quarry_drill", "d01", "d02", "d03" }, "Schürflizenz")
node("moonbotany", 4, 90, { "essence_craft", "fruit_mixing" }, { "r19", "r20", "r21", "r22" }, "Mondbotanik")
node("relic_weaving", 4, 100, { "moonbotany", "enchantment" }, { "r23" }, "Reliktweberei")
node("crystal_mastery", 4, 120, { "rune_study" }, { "crystal_refiner", "r27", "workshop_floor_3" }, "Kristallkunde")
node("infusion", 4, 105, { "moonbotany" }, { "infuser", "r26" }, "Infusion")
node("focus_charms", 4, 115, { "crystal_mastery", "enchantment" }, { "r28" }, "Fokusamulette")
node("arcane_depths", 5, 180, { "crystal_mastery", "relic_weaving" }, { "advanced_cauldron", "r29" }, "Arkane Tiefen")
node("masterwork", 5, 240, { "arcane_depths", "infusion" }, { "r30" }, "Meisterwerk")
node("portal_logistics", 5, 200, { "arcane_depths", "smart_sorting" }, { "magical_gate" }, "Portallogistik")
node("master_blueprints", 5, 130, { "multi_floor", "flow_control" }, { "blueprint_slots_20" }, "Meisterbaupläne")
return T
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000028"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[-- Small pure helpers (Lua 5.1 compatible, no Roblox API).
local Util = {}
function Util.isInt(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge and math.floor(v) == v
end
function Util.isFinite(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end
function Util.deepCopy(v)
	if type(v) ~= "table" then return v end
	local out = {}
	for k, x in pairs(v) do out[k] = Util.deepCopy(x) end
	return out
end
function Util.count(t)
	local n = 0
	for _ in pairs(t) do n = n + 1 end
	return n
end
function Util.sortedKeys(t)
	local keys = {}
	for k in pairs(t) do keys[#keys + 1] = k end
	table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
	return keys
end
function Util.clamp(v, lo, hi)
	if v < lo then return lo elseif v > hi then return hi end
	return v
end
-- Deterministic generator (Park-Miller). state is an integer in [1, 2147483646].
function Util.nextRandom(state)
	local s = (state * 48271) % 2147483647
	return s, (s - 1) / 2147483646
end
return Util
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000029"><Properties><string name="Name">Validator</string><ProtectedString name="Source"><![CDATA[-- Referential integrity checks over all data tables. Returns a list of error strings (empty = valid).
local Validator = {}
function Validator.run(D)
	local errs = {}
	local function e(msg) errs[#errs + 1] = msg end
	local Items, Recipes, Machines, Research, Quests, Locations, Config =
		D.Items, D.Recipes, D.Machines, D.Research, D.Quests, D.Locations, D.Config
	local function isInt(v) return type(v) == "number" and math.floor(v) == v end
	for id, it in pairs(Items) do
		if it.id ~= id then e("item id mismatch " .. id) end
		if not (isInt(it.sellBase) and it.sellBase >= 0) then e("item sellBase " .. id) end
		if it.type == "product" and it.sellBase <= 0 then e("product without price " .. id) end
		if it.type ~= "product" and it.sellBase ~= 0 then e("non-product is sellable " .. id) end
	end
	local unlockedBy = {}
	for id, n in pairs(Research) do
		if n.id ~= id then e("research id mismatch " .. id) end
		for _, p in ipairs(n.prereqs) do
			if not Research[p] then e("research " .. id .. " unknown prereq " .. p) end
		end
		for _, u in ipairs(n.unlocks) do
			if unlockedBy[u] then e("unlock " .. u .. " granted twice") end
			unlockedBy[u] = id
		end
	end
	-- DAG check (depth first)
	local state = {}
	local function visit(id)
		if state[id] == 2 then return end
		if state[id] == 1 then e("research cycle at " .. id) return end
		state[id] = 1
		for _, p in ipairs(Research[id].prereqs) do if Research[p] then visit(p) end end
		state[id] = 2
	end
	for id in pairs(Research) do visit(id) end
	for id, m in pairs(Machines) do
		if m.id ~= id then e("machine id mismatch " .. id) end
		if not Research[m.research] then e("machine " .. id .. " unknown research") end
		if unlockedBy[id] ~= m.research then e("machine " .. id .. " not unlocked by its research node") end
		if not (isInt(m.w) and isInt(m.d) and m.w >= 1 and m.d >= 1) then e("machine footprint " .. id) end
		if not (isInt(m.cost) and m.cost >= 0) then e("machine cost " .. id) end
		for _, p in ipairs(m.ports) do
			if p.x < 0 or p.x >= m.w or p.z < 0 or p.z >= m.d then e("port outside footprint " .. id) end
		end
	end
	local produced, crafting = {}, 0
	for id, r in pairs(Recipes) do
		if r.id ~= id then e("recipe id mismatch " .. id) end
		local m = Machines[r.machineId]
		if not m then e("recipe " .. id .. " unknown machine") end
		if not Research[r.requiredResearch] then e("recipe " .. id .. " unknown research")
		elseif unlockedBy[id] ~= r.requiredResearch then e("recipe " .. id .. " not unlocked by its research node") end
		if not (r.durationSec and r.durationSec > 0) then e("recipe duration " .. id) end
		if not r.supply then crafting = crafting + 1 end
		local n = 0
		for item, amount in pairs(r.inputs) do
			n = n + 1
			if not Items[item] then e("recipe " .. id .. " unknown input " .. item)
			elseif not (isInt(amount) and amount > 0) then e("recipe " .. id .. " bad amount " .. item)
			elseif Items[item].unit == "ml" and m then
				local ok = false
				for _, p in ipairs(m.ports) do if p.type == "fluid" and p.mode == "in" then ok = true end end
				if not ok then e("recipe " .. id .. " needs liquid but " .. r.machineId .. " has no fluid input") end
			end
		end
		if n == 0 and not r.source then e("recipe " .. id .. " has no inputs") end
		for item, amount in pairs(r.outputs) do
			if not Items[item] then e("recipe " .. id .. " unknown output " .. item)
			elseif not (isInt(amount) and amount > 0) then e("recipe " .. id .. " bad output amount") end
			produced[item] = true
			if Items[item] and Items[item].unit == "ml" and m then
				local ok = false
				for _, p in ipairs(m.ports) do if p.type == "fluid" and p.mode == "out" then ok = true end end
				if not ok then e("recipe " .. id .. " makes liquid but " .. r.machineId .. " has no fluid output") end
			end
		end
		if r.fuelUnits and m and not m.usesFuel then e("recipe " .. id .. " needs fuel but machine has no fuel slot") end
	end
	if crafting < 30 then e("fewer than 30 crafting recipes") end
	local gathered = {}
	for id, n in pairs(Locations.nodes) do
		if not Items[n.item] then e("node " .. id .. " unknown item") end
		if not Locations.locations[n.at] then e("node " .. id .. " unknown location") end
		gathered[n.item] = true
		if n.unlock and n.unlock.research and not Research[n.unlock.research] then e("node " .. id .. " unknown research") end
		if n.unlock and n.unlock.quest and not Quests.main[n.unlock.quest] then e("node " .. id .. " unknown quest") end
	end
	for id, it in pairs(Items) do
		if it.type == "raw" or it.type == "fuel" then
			if not gathered[id] then e("raw item without source " .. id) end
		elseif not produced[id] then e("item never produced " .. id) end
	end
	for id, l in pairs(Locations.locations) do
		if l.unlock and l.unlock.research and not Research[l.unlock.research] then e("location " .. id .. " unknown research") end
		if l.unlock and l.unlock.quest and not Quests.main[l.unlock.quest] then e("location " .. id .. " unknown quest") end
	end
	local function checkItems(tag, items)
		for item, n in pairs(items or {}) do
			if not Items[item] then e(tag .. " unknown item " .. item) end
			if not (isInt(n) and n > 0) then e(tag .. " bad count") end
		end
	end
	local function checkObjective(tag, o)
		if o.item and not Items[o.item] then e(tag .. " unknown item") end
		if o.at and not Locations.locations[o.at] then e(tag .. " unknown location") end
		if o.visit and not Locations.locations[o.visit] then e(tag .. " unknown visit location") end
		if o.type == "research" and not Research[o.id] then e(tag .. " unknown research") end
		checkItems(tag, o.items)
		for _, item in ipairs(o.anyOf or {}) do if not Items[item] then e(tag .. " unknown anyOf item") end end
	end
	if #Quests.mainOrder < 20 then e("fewer than 20 main quests") end
	for _, id in ipairs(Quests.mainOrder) do checkObjective("quest " .. id, Quests.main[id].objective) end
	local chains = 0
	for id, c in pairs(Quests.chains) do
		chains = chains + 1
		if not Locations.locations[c.at] then e("chain " .. id .. " unknown location") end
		for _, s in ipairs(c.steps) do checkObjective("chain " .. id, s.objective) end
	end
	if chains < 8 then e("fewer than 8 npc chains") end
	if #Quests.orders < 20 then e("fewer than 20 order templates") end
	for _, o in ipairs(Quests.orders) do
		checkItems("order " .. o.id, o.items)
		if o.need and not Research[o.need] then e("order " .. o.id .. " unknown research") end
	end
	for _, p in ipairs(Quests.projects) do
		if not Items[p.item] then e("project " .. p.id .. " unknown item") end
	end
	for item, n in pairs(Config.start.items) do
		if not Items[item] or not isInt(n) then e("start item " .. item) end
	end
	for _, t in ipairs(Config.plotTiers) do
		if t.research and not Research[t.research] then e("plot tier unknown research") end
	end
	return errs
end
return Validator
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000030"><Properties><string name="Name">WorkshopArchitecture</string><ProtectedString name="Source"><![CDATA[-- Shared room geometry for Roblox and the Blender workshop generator.
-- Positions are part centres in room-local Roblox coordinates.
local Architecture = {}

-- open = true builds the walkable outdoor variant that stands on a plot in the village: low stone
-- walls instead of closed ones, a 12 stud opening in the middle of every ground floor wall, no
-- door, no wall decoration and no roof, so the room can be entered and looked into from all sides.
Architecture.OPENING = 12

function Architecture.build(size, floors, height, open)
	local parts, lights = {}, {}
	local h = size / 2
	local function box(name, color, x, y, z, w, t, d, collides, floor, roll)
		parts[#parts + 1] = { name = name, color = color, position = { x, y, z },
			size = { w, t, d }, collides = collides == true, floor = floor, roll = roll }
	end
	local function light(x, y, z, strength, range)
		lights[#lights + 1] = { position = { x, y, z }, strength = strength, range = range }
	end
	local function panel(name, color, x, y, z, w, t, d, roll)
		box(name, color, x, y, z, w, t, d, false, nil, roll)
	end
	for floor = 1, floors do
		local y = (floor - 1) * height
		if floor == 1 then
			box("Floor", "wood_pale", 0, y - 0.5, 0, size, 1, size, true, floor)
		else
			-- The two slabs leave the reserved 6 × 8 stair opening clear.
			box("Floor", "wood_pale", 0, y - 0.5, -4, size, 1, size - 8, true, floor)
			box("FloorLanding", "wood_pale", 3, y - 0.5, h - 4, size - 6, 1, 8, true, floor)
		end
		local function wall(name, x, z, w, d)
			if open then
				box(name, "stone_warm", x, y + 1.2, z, w, 2.4, d, true)
			else
				box(name, "plaster_cream", x, y + height / 2, z, w, height, d, true)
				panel(name .. "StoneSkirt", "stone_warm", x, y + 1.2, z, w + 0.12, 2.4, d + 0.12)
			end
			panel(name .. "SillBeam", "wood_dark", x, y + 2.65, z, w + 0.16, 0.48, d + 0.16)
			panel(name .. "EavesBeam", "wood_dark", x, y + height - 0.46, z, w + 0.2, 0.9, d + 0.2)
		end
		if open and floor == 1 then
			-- every side: two wall pieces with an opening between them, a beam above the opening
			local gap = Architecture.OPENING
			local piece = (size - gap) / 2
			local offset = gap / 2 + piece / 2
			for s = -1, 1, 2 do
				wall("WestWall", -h - 0.5, s * offset, 1, piece)
				wall("EastWall", h + 0.5, s * offset, 1, piece)
				wall("RearWall", s * (offset + 0.5), h + 0.5, piece + 1, 1)
				wall("FrontWall", s * (offset + 0.5), -h - 0.5, piece + 1, 1)
				for _, side in ipairs({ -1, 1 }) do
					panel("GatePost", "wood_dark", s * (h + 0.5), y + height / 2, side * gap / 2, 0.9, height, 0.9)
					panel("GatePost", "wood_dark", side * gap / 2, y + height / 2, s * (h + 0.5), 0.9, height, 0.9)
				end
				panel("GateBeam", "wood_dark", s * (h + 0.5), y + height - 0.46, 0, 1.2, 0.9, gap)
				panel("GateBeam", "wood_dark", 0, y + height - 0.46, s * (h + 0.5), gap, 0.9, 1.2)
			end
		else
			wall("WestWall", -h - 0.5, 0, 1, size)
			wall("EastWall", h + 0.5, 0, 1, size)
			wall("RearWall", 0, h + 0.5, size + 2, 1)
		end
		if open and floor == 1 then
			-- walls and openings are complete
		elseif floor == 1 then
			local width = h - 3
			wall("FrontWallLeft", -(3 + width / 2), -h - 0.5, width, 1)
			wall("FrontWallRight", 3 + width / 2, -h - 0.5, width, 1)
			box("Lintel", "wood_dark", 0, height - 1, -h - 0.5, 6.5, 2, 1, true)
			box("ExitDoor", "wood_red", 0, 4.3, -h - 0.12, 5.9, 8.6, 0.48, true)
			panel("DoorPanel", "wood_mid", 0, 4.5, -h + 0.14, 4.9, 7.4, 0.14)
			panel("DoorBrace", "iron", 0, 3.2, -h + 0.23, 5.1, 0.26, 0.14)
			panel("DoorBrace", "iron", 0, 6.1, -h + 0.23, 5.1, 0.26, 0.14)
			panel("DoorHandle", "brass", 1.65, 4.1, -h + 0.32, 0.34, 0.36, 0.24)
		else
			wall("FrontWall", 0, -h - 0.5, size + 2, 1)
		end
		for s = -1, 1, 2 do
			for p = -h + 7, h - 5, 8 do
				if not (open and floor == 1 and math.abs(p) < Architecture.OPENING / 2 + 0.5) then
					panel("WallPost", "wood_dark", s * (h + 0.18), y + height / 2, p, 0.54, height, 0.62)
				end
				if floor == 1 and s == 1 and p < -2 and not open then
					panel("WindowFrame", "wood_dark", h - 0.12, y + 6.6, p + 3.3, 0.22, 4.6, 5.3)
					panel("AmberWindow", "glass_lit", h - 0.27, y + 6.6, p + 3.3, 0.12, 3.8, 4.5)
					panel("WindowMullion", "wood_dark", h - 0.4, y + 6.6, p + 3.3, 0.2, 4, 0.24)
					panel("WindowCrossbar", "wood_dark", h - 0.4, y + 6.6, p + 3.3, 0.2, 0.27, 4.5)
					panel("WindowSill", "wood_mid", h - 0.34, y + 4.4, p + 3.3, 0.66, 0.25, 5.6)
				end
			end
			panel("CornerPost", "wood_dark", s * h, y + height / 2, -h, 0.9, height, 0.9)
			panel("CornerPost", "wood_dark", s * h, y + height / 2, h, 0.9, height, 0.9)
		end
		-- The braces sit against the plaster so the room stays clear below them.
		local bays = math.floor(size / 8)
		local bayWidth = size / bays
		for i = 1, open and 0 or bays do
			local x = -h + (i - 0.5) * bayWidth
			local rise = 3.75
			local span = bayWidth - 0.65
			local angle = math.deg(math.atan(rise / span))
			local beamLength = math.sqrt(span * span + rise * rise)
			panel("RearTrim", "plaster_sage", x, y + 7.25, h - 0.04, span + 0.1, 4.45, 0.14)
			panel("RearBeam", "wood_dark", x, y + 7.25, h - 0.15, beamLength, 0.3, 0.24, angle)
			panel("RearBeam", "wood_mid", x, y + 7.25, h - 0.2, beamLength, 0.25, 0.24, -angle)
			panel("RearPost", "wood_dark", x - bayWidth / 2, y + height / 2, h - 0.13, 0.57, height, 0.6)
		end
		if not open then
			panel("RearBeam", "wood_dark", 0, y + 5.03, h - 0.14, size, 0.35, 0.44)
			panel("RearBeam", "wood_dark", 0, y + 9.45, h - 0.14, size, 0.35, 0.44)
		end
		for z = -h + 4, h - 2, 8 do
			panel("Rafter", "wood_dark", 0, y + height - 0.5, z, size, 0.7, 0.65)
		end
		local lamps = math.max(2, math.floor(size / 14))
		for i = 1, lamps do
			local z = -h + i * size / (lamps + 1)
			for _, x in ipairs({ -h * 0.6, h * 0.6 }) do
				panel("LampMount", "iron", x, y + height - 0.7, z, 0.18, 1, 0.18)
				panel("Lamp", "glass_lit", x, y + height - 1.36, z, 0.64, 0.8, 0.64)
				panel("LampCap", "iron", x, y + height - 0.88, z, 0.8, 0.19, 0.8)
				light(x, y + height - 1.5, z, 0.9, 20)
			end
		end
		if floor < floors then
			-- Walk up along the west edge of the stairwell and turn onto the upper landing.
			for i = 1, 12 do
				local t = i * height / 12
				box("StairTread", "wood_mid", -h + 2, y + t - 0.5, h - 8 + (i - 0.5) * 8 / 12,
					4, 1, 8 / 12 + 0.04, true)
			end
			box("StairLanding", "wood_mid", -h + 5, y + height - 0.5, h - 0.55, 2, 1, 1.1, true)
		end
	end

	if open then return parts, lights end

	-- Plaster recess and shelf anchored to the outer wall, outside the machine grid.
	panel("HearthStone", "stone_dark", -h + 0.02, 4.9, -1, 0.16, 5.1, 7.4)
	for row = 0, 4 do
		for col = 0, 3 do
			panel("HearthBlock", (row + col) % 3 == 0 and "stone_light" or "stone_warm",
				-h + 0.15, 2.9 + row * 0.94, -3.72 + col * 1.7 + (row % 2) * 0.34,
				0.2, 0.77, 1.54)
		end
	end
	panel("HerbRail", "wood_mid", h - 0.08, 8.85, -h + 9, 0.34, 0.3, 5.2)
	panel("BottleLedge", "wood_mid", h - 0.16, 5.5, -h + 9, 0.55, 0.22, 5.2)
	for i = 1, 4 do
		local z = -h + 7 + i * 0.8
		panel("HerbStem", "wood_pale", h - 0.29, 8.45, z, 0.13, 0.66, 0.12)
		panel("DriedHerbs", i % 2 == 0 and "leaf_dark" or "leaf_teal", h - 0.37, 7.95, z, 0.29, 0.61, 0.36)
		panel("Bottle", i % 2 == 0 and "glass_light" or "roof_purple", h - 0.26, 5.95, z, 0.26, 0.56, 0.39)
		panel("BottleLabel", "plaster_cream", h - 0.41, 5.91, z, 0.05, 0.18, 0.3)
		panel("BottleCork", "wood_pale", h - 0.26, 6.29, z, 0.19, 0.17, 0.19)
	end
	light(h - 1, 7, -h + 4, 1.6, 22)
	light(-h + 3, 6, -1, 1.15, 18)
	return parts, lights
end

return Architecture
]]></ProtectedString></Properties></Item>
