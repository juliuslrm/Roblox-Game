<Item class="ReplicatedStorage" referent="RBX000028"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX000027"><Properties><string name="Name">ArcaneShared</string></Properties><Item class="ModuleScript" referent="RBX000011"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Global tuning values. Pure data (Lua 5.1 compatible).
return {
	schemaVersion = 1,
	cellSize = 2,                 -- studs per workshop grid cell
	floorHeight = 12,             -- studs between workshop floors
	liquidPortion = 1000,         -- ml
	start = { coins = 60, items = { herb_mint = 4, herb_sunleaf = 2, water = 3000 } },
	inventory = { slots = 24, liquidCap = 20000 },
	-- workshop size tiers: cells per side, cost, required research / quest
	plotTiers = {
		{ cells = 16, cost = 0 },
		{ cells = 24, cost = 400, research = "storage" },
		{ cells = 32, cost = 1200, research = "belt_basics" },
		{ cells = 40, cost = 3500, research = "multi_floor" },
	},
	floors = {
		{ cost = 0 },
		{ cost = 1800, research = "multi_floor" },
		{ cost = 4500, research = "crystal_mastery", quest = "q14" },
	},
	door = { width = 4, depth = 3 },          -- reserved cells at the entrance (front edge centre)
	limits = { machines = 150, logistics = 400, blueprintParts = 100, blueprintSlots = 10,
		blueprintSlotsMaster = 20, crateLimitStart = 2, layoutBytes = 200000 },
	sim = { tick = 0.25, maxDt = 1.0, maxCyclesPerTick = 4, beltSecondsPerItem = 2, hopperSecondsPerItem = 1,
		pipeMlPerSec = 500, pumpMlPerSec = 250, liftSecondsPerItem = 2, gateSecondsPerItem = 1,
		statsWindowSec = 900 },
	machine = { inputFactor = 4, outputCap = 8, fluidCap = 4000, fuelCap = 16 },
	refundFactor = 0.6,
	shop = { customerMinSec = 15, customerMaxSec = 25, queueMax = 4, demandMin = 0.85, demandMax = 1.15,
		repPriceStep = 0.04, demandDriftSec = 120 },
	reputation = { 0, 30, 100, 240, 480, 850 },   -- points needed for level 0..5
	knowledge = { firstCraft = 5, experiment = 3, experimentDailyCap = 5 },
	orders = { active = 3, refreshSec = 300, repPerOrderCapPerDay = 60 },
	rate = { default = { burst = 12, perSec = 6 }, GatherNode = { burst = 4, perSec = 2 },
		PlaceBlueprint = { burst = 2, perSec = 0.5 } },
	interactRadius = 14,
	autosaveSec = 90,
	maxPlayers = 4,
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000012"><Properties><string name="Name">GridMath</string><ProtectedString name="Source"><![CDATA[-- Grid geometry of the workshop. Cells are integers; direction 0=+z 1=+x 2=-z 3=-x.
local GridMath = {}
GridMath.DX = { [0] = 0, [1] = 1, [2] = 0, [3] = -1 }
GridMath.DZ = { [0] = 1, [1] = 0, [2] = -1, [3] = 0 }
function GridMath.key(floor, x, z)
	return floor * 1000000 + x * 1000 + z
end
function GridMath.size(def, rot)
	if rot % 2 == 0 then return def.w, def.d end
	return def.d, def.w
end
-- local cell (lx, lz) of a w x d footprint -> offset inside the rotated footprint
function GridMath.rotateCell(lx, lz, w, d, rot)
	if rot == 0 then return lx, lz
	elseif rot == 1 then return lz, w - 1 - lx
	elseif rot == 2 then return w - 1 - lx, d - 1 - lz
	end
	return d - 1 - lz, lx
end
function GridMath.cells(def, gx, gz, rot)
	local w, d = GridMath.size(def, rot)
	local out = {}
	for x = 0, w - 1 do
		for z = 0, d - 1 do out[#out + 1] = { gx + x, gz + z } end
	end
	return out
end
-- world cell and facing of a port for an entity placed at (gx, gz) with rotation rot
function GridMath.port(def, port, gx, gz, rot)
	local ox, oz = GridMath.rotateCell(port.x, port.z, def.w, def.d, rot)
	local dir = (port.dir + rot) % 4
	return gx + ox, gz + oz, dir
end
function GridMath.opposite(dir)
	return (dir + 2) % 4
end
return GridMath
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000013"><Properties><string name="Name">Items</string><ProtectedString name="Source"><![CDATA[-- Item database. Liquids are counted in integer millilitres (unit = "ml").
local Items = {}
local function add(id, type_, name, sell, tier, extra)
	local it = { id = id, type = type_, name = name, sellBase = sell or 0, unlockTier = tier or 0,
		stackLimit = 50, rarity = "common", icon = "icon_" .. id, tags = {} }
	if extra then for k, v in pairs(extra) do it[k] = v end end
	Items[id] = it
end
local liquid = { unit = "ml", stackLimit = 20000, tags = { "liquid" } }
-- raw
add("herb_mint", "raw", "Minze", 0, 0)
add("herb_sunleaf", "raw", "Sonnenblatt", 0, 0)
