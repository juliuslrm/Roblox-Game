add("shadow_essence", "intermediate", "Schattenessenz", 0, 3, liquid)
add("rune_blank", "intermediate", "Runenrohling", 0, 2)
add("copper_ingot", "intermediate", "Kupferbarren", 0, 2)
add("iron_ingot", "intermediate", "Eisenbarren", 0, 2)
