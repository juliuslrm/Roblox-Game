<Item class="ModuleScript" referent="RBX000030"><Properties><string name="Name">README</string><ProtectedString name="Source"><![CDATA[-- Arcane Village: press Play.
-- Without imported meshes the village appears as placeholder blocks on voxel terrain.
-- To get the real models import exports/library/village_assets.glb and village_terrain.glb into
-- ServerStorage.VillageAssets and exports/library/arcane_machines.glb into ServerStorage.ArcaneAssets.
return {}
]]></ProtectedString></Properties></Item>
</Item>
<Item class="ServerScriptService" referent="RBX000059"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX000032"><Properties><string name="Name">VillageAutoBuild</string><ProtectedString name="Source"><![CDATA[-- Runs VillageAutoBuild once when the server starts (UNVERIFIED_IN_STUDIO).
-- Characters are held back until the ground exists, so nobody falls into the void.
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local folder = ServerStorage:WaitForChild("VillageWorld")

Players.CharacterAutoLoads = false
local ok, err = pcall(function()
	local Auto = require(folder:WaitForChild("VillageAutoBuild"))
	-- Fetch the uploaded model libraries; without them the village is built from placeholder blocks.
	local loadOk, loaded = pcall(function()
		return require(folder:WaitForChild("VillageAssetLoader")).load({
			ids = require(folder:WaitForChild("VillageAssetIds")),
			insertService = game:GetService("InsertService"),
			parent = ServerStorage,
		})
	end)
	if loadOk then
		print(string.format("[Village] assets: %d libraries loaded, %d failed, %d mesh parts, %d retextured",
			loaded.loaded, #loaded.failed, loaded.meshParts, loaded.retextured))
		for _, message in ipairs(loaded.failed) do warn("[Village] asset load failed: " .. message) end
	else
		warn("[Village] asset loader failed: " .. tostring(loaded))
	end
	local origin = workspace:GetAttribute("VillageOrigin")
	if typeof(origin) ~= "CFrame" then origin = CFrame.new() end
	local facade = folder:FindFirstChild("WorkshopFacade")
	local layout = require(folder:WaitForChild("WorldLayout"))
	local builder = require(folder:WaitForChild("VillageWorldBuilder"))
	-- Use the meshes only if their names match the level plan; otherwise say what arrived and
	-- fall back to placeholder blocks instead of building an empty world.
	local templates = ServerStorage:FindFirstChild("VillageAssets")
	if templates then
		local found, missing = builder.checkTemplates(templates, layout)
		print(string.format("[Village] templates: %d found, %d missing", #found, #missing))
		if #found == 0 then
			local names = {}
			for _, d in ipairs(templates:GetDescendants()) do
				if #names >= 20 then break end
				names[#names + 1] = d.ClassName .. ":" .. d.Name
			end
			warn("[Village] no template name matches the level plan. First instances: " .. table.concat(names, ", "))
			templates = nil
		end
	end
	local report = Auto.run({
		layout = layout,
		heightmap = require(folder:WaitForChild("WorldHeightmap")),
		workshopFacade = facade and require(facade),
		builder = builder,
		terrainBuilder = require(folder:WaitForChild("VillageTerrainBuilder")),
		templates = templates,
		-- The time of day is fixed to the afternoon; 76 lantern and window lights on top of the
		-- sunlight made the village glow.  Switch back on once there is a day/night cycle.
		createLights = false,
		origin = origin,
	})
	if layout.lighting then builder.applyLighting(layout.lighting) end
	print(string.format("[Village] built in mode '%s': %d objects placed, %d missing, %d terrain cells",
		report.mode, report.placed, report.missing, report.terrainCells))
	if report.mode == "greybox" then
		print("[Village] No meshes in ServerStorage.VillageAssets - showing placeholder blocks. See docs/ROBLOX_IMPORT.md.")
	elseif #report.missingTerrain > 0 then
		warn("[Village] Using voxel terrain. Missing or empty terrain templates: " .. table.concat(report.missingTerrain, ", "))
	end
	for _, message in ipairs(report.warnings) do
		warn("[Village] " .. message)
	end
	local precise = {}
	for name in pairs(report.needsPreciseCollision) do
		precise[#precise + 1] = name
	end
	if #precise > 0 then
		table.sort(precise)
		warn("[Village] Check CollisionFidelity in Studio for: " .. table.concat(precise, ", "))
	end
end)
if not ok then warn("[Village] auto build failed: " .. tostring(err)) end
workspace:SetAttribute("VillageReady", true)
-- Exact ground (rendering and collision) takes about half a minute; do it while people already
-- play, starting at the spawn point.
task.spawn(function()
	local village = workspace:FindFirstChild("Village")
	if village and village:FindFirstChild("terrain") then
		local t0 = os.clock()
		local okRefine, result = pcall(function()
			local layout = require(folder:WaitForChild("WorldLayout"))
			local origin = workspace:GetAttribute("VillageOrigin")
			if typeof(origin) ~= "CFrame" then origin = CFrame.new() end
			return require(folder:WaitForChild("VillageAutoBuild")).refineGround({
				village = village, assetService = game:GetService("AssetService"), origin = origin,
				heightmap = require(folder:WaitForChild("WorldHeightmap")),
				decodeHeights = require(folder:WaitForChild("VillageTerrainBuilder")).decodeHeights,
				focus = origin * Vector3.new(layout.spawn[1], layout.spawn[2], layout.spawn[3]),
			})
		end)
		if okRefine then
			print(string.format("[Village] precise ground: %d parts converted, %d failed, %d collision holes patched in %.1f s %s",
				result.converted, result.failed, result.patches, os.clock() - t0, tostring(result.lastError or "")))
		else
			warn("[Village] precise ground failed: " .. tostring(result))
		end
	end
	workspace:SetAttribute("VillageGroundRefined", true)
end)
Players.CharacterAutoLoads = true
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(function() player:LoadCharacter() end)
end
Players.PlayerAdded:Connect(function(player)
	if not player.Character then player:LoadCharacter() end
end)
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX000058"><Properties><string name="Name">ArcaneServer</string></Properties><Item class="ModuleScript" referent="RBX000033"><Properties><string name="Name">Actions</string><ProtectedString name="Source"><![CDATA[-- Single entry point for every client request (spec §12 protocol, §14 security).
-- handle(world, session, action, payload, ctx) -> { ok, code, version, payload }
-- ctx = { now = seconds (server clock) }.  The client never supplies positions, prices or amounts of money.
local D = require(script.Parent.Data)
local Inv = require(script.Parent.InventoryService)
local Eco = require(script.Parent.EconomyService)
local Place = require(script.Parent.PlacementService)
local Logistics = require(script.Parent.LogisticsService)
local Prod = require(script.Parent.ProductionService)
local Quest = require(script.Parent.QuestService)
local Research = require(script.Parent.ResearchService)
local Res = require(script.Parent.ResourceService)
local Sec = require(script.Parent.SecurityService)
local Co = require(script.Parent.CoOpPermissions)
local Game = require(script.Parent.Game)
local Config, Machines, Recipes, Items, Quests, Locations, Util =
	D.Config, D.Machines, D.Recipes, D.Items, D.Quests, D.Locations, D.Util
local Actions = {}
local H = {}

local function fail(code, payload) return { ok = false, code = code, payload = payload } end
local function ok(payload) return { ok = true, code = "OK", payload = payload } end

-- Workshop the player stands in, with the profile that owns it. role = minimum right needed.
local function workshop(world, session, role)
	local ownerId = session.rt.inWorkshop
	if not ownerId then return nil, nil, "TOO_FAR" end
	local owner = world.sessions[ownerId]
	if not owner then return nil, nil, "NOT_FOUND" end
	if not Co.atLeast(world, ownerId, session.userId, role) then return nil, nil, "FORBIDDEN" end
	return owner.profile, owner, nil
end

local function touched(owner, layoutChanged)
	owner.rt.version = owner.rt.version + 1
	if layoutChanged then owner.rt.dirty = true end
end

local function afterChange(world, owner, events)
	local function notify(n) Game.notify(owner, n) end
	Quest.onEvents(owner.profile, events or {}, notify)
	Quest.evaluate(owner.profile, owner.rt, notify)
end

function H.RequestSnapshot() return ok() end

function H.GatherNode(world, session, p)
	local def = Locations.nodes[p.node]
	if not def then return fail("NOT_FOUND") end
	local P = session.profile
	if session.rt.inWorkshop then return fail("TOO_FAR") end
	if not Quest.ruleMet(P, def.unlock) or not Quest.locationUnlocked(P, def.at) then return fail("LOCKED") end
	local a, pos = world.nodeAnchors[p.node], session.rt.pos
	if not a or not pos then return fail("TOO_FAR") end
	local dx, dz = pos.x - a.x, pos.z - a.z
	if dx * dx + dz * dz > Config.interactRadius * Config.interactRadius then return fail("TOO_FAR") end
	local n, code = Res.gather(world.nodes, P, p.node)
	if not n then return fail(code) end
	return ok({ item = def.item, amount = n, remaining = world.nodes[p.node].remaining })
end

function H.BuyMarketOffer(world, session, p)
	local merchant = D.Market.merchants[p.merchant]
	if not merchant then return fail("NOT_FOUND") end
	if session.rt.inWorkshop or not D.Market.near(world.marketAnchors[p.merchant], session.rt.pos) then
		return fail("TOO_FAR")
	end
	local offer
	for _, candidate in ipairs(merchant.offers) do
		if candidate.item == p.item then offer = candidate break end
	end
	if not offer then return fail("NOT_FOUND") end
	local P = session.profile
	if not Quest.ruleMet(P, offer.unlock) then return fail("LOCKED") end
	local items = { [offer.item] = offer.amount }
	if not Inv.canAdd(P.items, items, Inv.PLAYER) then return fail("NO_SPACE") end
	if not Eco.pay(P, offer.coins) then return fail("NO_FUNDS") end
	Inv.add(P.items, items)
	touched(session, false)
	return ok({ item = offer.item, amount = offer.amount, coins = offer.coins })
end

function H.EnterWorkshop(world, session, p)
	local ownerId = p.owner or session.userId
	if session.rt.inWorkshop then return fail("BUSY") end
	if world.plotPresence then
		-- walkable workshops: the server adapter records on whose plot each character stands
		if world.plotPresence[session.userId] ~= ownerId then return fail("TOO_FAR") end
	elseif not Game.near(world, session, "workshop_door") then
		return fail("TOO_FAR")
	end
	if not world.sessions[ownerId] then return fail("NOT_FOUND") end
	if not Co.atLeast(world, ownerId, session.userId, "visitor") then return fail("FORBIDDEN") end
	session.rt.inWorkshop = ownerId
	if ownerId == session.userId then afterChange(world, session, { { type = "enter_workshop" } }) end
	return ok({ owner = ownerId })
end

function H.LeaveWorkshop(world, session)
	if not session.rt.inWorkshop then return fail("NOT_READY") end
	session.rt.inWorkshop = nil
	return ok()
end

function H.PlaceMachine(world, session, p)
	local P, owner, code = workshop(world, session, "builder")
	if not P then return fail(code) end
	local e, why = Place.place(P, p.machine, p.gx, p.gz, p.floor, p.rot)
	if not e then return fail(why) end
	touched(owner, true)
	afterChange(world, owner, { { type = "place", machine = p.machine } })
	return ok({ uid = e.uid })
end

function H.RemoveMachine(world, session, p)
	local P, owner, code = workshop(world, session, "builder")
	if not P then return fail(code) end
	local res, why = Place.remove(P, p.uid)
	if not res then return fail(why) end
	touched(owner, true)
	return ok(res)
end

function H.RotateMachine(world, session, p)
	local P, owner, code = workshop(world, session, "builder")
	if not P then return fail(code) end
	local e, why = Place.rotate(P, p.uid)
	if not e then return fail(why) end
	touched(owner, true)
	return ok({ rot = e.rot })
end

local function recipeAllowed(P, e, recipeId)
	local r = Recipes[recipeId]
	if not r or r.machineId ~= e.machine then return nil, "NOT_FOUND" end
	if not P.research[r.requiredResearch] then return nil, "LOCKED" end
	return r
end

-- Returns inputs that do not belong to recipe `r` to the inventory (all or nothing).
local function flushForeign(P, b, r)
	local back = {}
	for item, n in pairs(b.inv) do if not (r and r.inputs[item]) then back[item] = n end end
	for item, n in pairs(b.fluids) do if not (r and r.inputs[item]) then back[item] = (back[item] or 0) + n end end
	if not Inv.canAdd(P.items, back, Inv.PLAYER) then return false end
	Inv.add(P.items, back)
	for item in pairs(back) do b.inv[item] = nil b.fluids[item] = nil end
	return true
end

function H.SetRecipe(world, session, p)
	local P, owner, code = workshop(world, session, "operator")
	if not P then return fail(code) end
	local e = Place.find(P, p.uid)
	if not e or Machines[e.machine].kind ~= "machine" then return fail("NOT_FOUND") end
	local b = P.workshop.buffers[e.uid]
	if b.job then return fail("BUSY") end
	local r = nil
	if p.recipe then
		local why
		r, why = recipeAllowed(P, e, p.recipe)
		if not r then return fail(why) end
	end
	if not flushForeign(P, b, r) then return fail("NO_SPACE") end
	e.recipe = p.recipe
	touched(owner, false)
	return ok()
end

function H.StartManualCraft(world, session, p)
	local P, owner, code = workshop(world, session, "operator")
	if not P then return fail(code) end
	local e = Place.find(P, p.uid)
	if not e or Machines[e.machine].kind ~= "machine" then return fail("NOT_FOUND") end
	local r, why = recipeAllowed(P, e, p.recipe)
	if not r then return fail(why) end
	local b = P.workshop.buffers[e.uid]
	if b.job and e.recipe ~= p.recipe then return fail("BUSY") end
	if e.recipe ~= p.recipe and not flushForeign(P, b, r) then return fail("NO_SPACE") end
	local need = {}
	for item, n in pairs(r.inputs) do
		local have = (Items[item].unit == "ml") and (b.fluids[item] or 0) or (b.inv[item] or 0)
		if have < n then need[item] = n - have end
	end
	if r.fuelUnits and b.fuel < r.fuelUnits then need.fuel_charcoal = (need.fuel_charcoal or 0) + r.fuelUnits - b.fuel end
	local has, missing = Inv.has(P.items, need)
	if not has then return fail("NO_ITEMS", { item = missing }) end
	Inv.remove(P.items, need)
	for item, n in pairs(need) do
		if item == "fuel_charcoal" and not r.inputs[item] then b.fuel = b.fuel + n
		elseif Items[item].unit == "ml" then b.fluids[item] = (b.fluids[item] or 0) + n
		else b.inv[item] = (b.inv[item] or 0) + n end
	end
	e.recipe = p.recipe
	b.auto = false
	touched(owner, false)
	return ok({ durationSec = r.durationSec })
end

-- Room of an entity slot for `item` when filled by hand.
local function entityRoom(P, e, b, item)
	local def, it = Machines[e.machine], Items[item]
	if def.kind == "crate" then return Inv.room(b.inv, item, def), b.inv end
	if def.kind == "shelf" then
		return (it.type == "product") and Inv.room(b.inv, item, def) or 0, b.inv
	end
	if def.kind == "tank" then
		local held = next(b.fluids)
		if it.unit ~= "ml" or (held and held ~= item) then return 0 end
		return def.capacity - (b.fluids[item] or 0), b.fluids
	end
	if def.kind == "machine" then
		if def.usesFuel and item == "fuel_charcoal" then return Config.machine.fuelCap - b.fuel, "fuel" end
		local r = e.recipe and Recipes[e.recipe]
		local need = r and r.inputs[item]
		if not need then return 0 end
		if it.unit == "ml" then return Config.machine.fluidCap - (b.fluids[item] or 0), b.fluids end
		return need * Config.machine.inputFactor - (b.inv[item] or 0), b.inv
	end
	return 0
end

local function moveToEntity(P, e, item, amount)
	local b = P.workshop.buffers[e.uid]
	local room, store = entityRoom(P, e, b, item)
	local n = math.min(amount, room, P.items[item] or 0)
	if (P.items[item] or 0) <= 0 then return nil, "NO_ITEMS" end
	if n <= 0 then return nil, "NO_SPACE" end
	Inv.remove(P.items, { [item] = n })
	if store == "fuel" then b.fuel = b.fuel + n else store[item] = (store[item] or 0) + n end
	if Machines[e.machine].kind == "machine" and store ~= "fuel" then b.auto = false end
	return n
end

local function moveFromEntity(P, e, item, amount, slot)
	local b = P.workshop.buffers[e.uid]
	local def, it = Machines[e.machine], Items[item]
	local store
	if slot == "fuel" then
		if item ~= "fuel_charcoal" then return nil, "BAD_REQUEST" end
		local n = math.min(amount, b.fuel, Inv.room(P.items, item, Inv.PLAYER))
		if n <= 0 then return nil, (b.fuel > 0) and "NO_SPACE" or "NO_ITEMS" end
		b.fuel = b.fuel - n
		Inv.add(P.items, { [item] = n })
		return n
	elseif Logistics.CARRIER[def.kind] then
		if b.item ~= item then return nil, "NO_ITEMS" end
		if Inv.room(P.items, item, Inv.PLAYER) < 1 then return nil, "NO_SPACE" end
		b.item = nil
		Inv.add(P.items, { [item] = 1 })
		return 1
	elseif def.kind == "machine" then
		if slot == "in" then store = (it.unit == "ml") and b.fluids or b.inv
		else store = (it.unit == "ml") and b.outFluid or b.out end
	elseif def.kind == "tank" or def.kind == "pump" then store = b.fluids
	else store = b.inv end
	local n = math.min(amount, store[item] or 0, Inv.room(P.items, item, Inv.PLAYER))
	if (store[item] or 0) <= 0 then return nil, "NO_ITEMS" end
	if n <= 0 then return nil, "NO_SPACE" end
	store[item] = store[item] - n
	if store[item] == 0 then store[item] = nil end
	Inv.add(P.items, { [item] = n })
	return n
end

function H.TransferStack(world, session, p)
	local P, owner, code = workshop(world, session, "operator")
	if not P then return fail(code) end
	if not Items[p.item] or p.amount < 1 then return fail("BAD_REQUEST") end
	if p.slot and p.slot ~= "in" and p.slot ~= "out" and p.slot ~= "fuel" then return fail("BAD_REQUEST") end
	local n, why
	if p.from == "inv" and p.to ~= "inv" then
		local e = Place.find(P, p.to)
		if not e then return fail("NOT_FOUND") end
		n, why = moveToEntity(P, e, p.item, p.amount)
	elseif p.to == "inv" and p.from ~= "inv" then
		local e = Place.find(P, p.from)
		if not e then return fail("NOT_FOUND") end
		n, why = moveFromEntity(P, e, p.item, p.amount, p.slot)
	else
		return fail("BAD_REQUEST")
	end
	if not n then return fail(why) end
	touched(owner, false)
	return ok({ moved = n })
end

function H.StockShelf(world, session, p)
	local P, owner, code = workshop(world, session, "operator")
	if not P then return fail(code) end
	local e = Place.find(P, p.uid)
	if not e or Machines[e.machine].kind ~= "shelf" then return fail("NOT_FOUND") end
	if not Items[p.item] or Items[p.item].type ~= "product" or p.amount < 1 then return fail("BAD_REQUEST") end
	local n, why = moveToEntity(P, e, p.item, p.amount)
	if not n then return fail(why) end
	touched(owner, false)
	return ok({ moved = n })
end

function H.SetFilter(world, session, p)
	local P, owner, code = workshop(world, session, "operator")
	if not P then return fail(code) end
	local e = Place.find(P, p.uid)
	if not e then return fail("NOT_FOUND") end
	local kind = Machines[e.machine].kind
	if kind == "gate" then
		if p.link then
			local other = Place.find(P, p.link)
			if not other or other.uid == e.uid or Machines[other.machine].kind ~= "gate" then return fail("NOT_FOUND") end
		end
		e.link = p.link
	elseif kind == "sorter" or kind == "hopper" then
		local items = p.items or {}
		if #items > 8 then return fail("LIMIT") end
		for _, id in ipairs(items) do
			if not Items[id] or Items[id].unit == "ml" then return fail("BAD_REQUEST") end
		end
		e.filter = (#items > 0) and items or nil
	else
		return fail("BAD_REQUEST")
	end
	touched(owner, true)
	return ok()
end

function H.ToggleMachine(world, session, p)
	local P, owner, code = workshop(world, session, "operator")
	if not P then return fail(code) end
	local e = Place.find(P, p.uid)
	if not e or Machines[e.machine].kind ~= "machine" then return fail("NOT_FOUND") end
	e.paused = (not e.paused) or nil
	touched(owner, false)
	return ok({ paused = e.paused == true })
end

function H.Experiment(world, session, p)
	local P, owner, code = workshop(world, session, "owner")
	if not P then return fail(code) end
	local e = Place.find(P, p.uid)
	if not e or e.machine ~= "kettle" then return fail("NOT_FOUND") end
	local day = math.floor(session.rt.now / 86400)
	if P.experiment.day ~= day then P.experiment.day, P.experiment.count = day, 0 end
	if P.experiment.count >= Config.knowledge.experimentDailyCap then return fail("LIMIT") end
	local herb
	for _, id in ipairs({ "herb_mint", "herb_sunleaf", "mushroom_gloom", "herb_moonleaf" }) do
		if (P.items[id] or 0) >= 1 then herb = id break end
	end
	if not herb or (P.items.water or 0) < Config.liquidPortion then return fail("NO_ITEMS") end
	Inv.remove(P.items, { [herb] = 1, water = Config.liquidPortion })
	P.experiment.count = P.experiment.count + 1
	Eco.addKnowledge(P, Config.knowledge.experiment)
	touched(owner, false)
	return ok({ knowledge = Config.knowledge.experiment, left = Config.knowledge.experimentDailyCap - P.experiment.count })
end

-- Owner-only economy actions always work on the caller's own profile.
local function ownContext(world, session, locationId)
	if session.rt.inWorkshop == session.userId then return true end
	if not session.rt.inWorkshop and locationId and Game.near(world, session, locationId) then return true end
	return false
end

function H.BuyUpgrade(world, session, p)
	local P = session.profile
	if not ownContext(world, session, "town_hall") then return fail("TOO_FAR") end
	local list, key
	if p.kind == "plot" then list, key = Config.plotTiers, "sizeTier"
	elseif p.kind == "floor" then list, key = Config.floors, "floors"
	else return fail("BAD_REQUEST") end
	local nextTier = list[P.workshop[key] + 1]
	if not nextTier then return fail("LIMIT") end
	if nextTier.research and not P.research[nextTier.research] then return fail("LOCKED") end
	if nextTier.quest and not Quest.isDone(P, nextTier.quest) then return fail("LOCKED") end
	if not Eco.pay(P, nextTier.cost) then return fail("NO_FUNDS") end
	if key == "sizeTier" then
		-- the entrance and the staircase move with the plot size: grow around the old layout
		local old = Place.cells(P)
		P.workshop.sizeTier = P.workshop.sizeTier + 1
		local shift = math.floor((Place.cells(P) - old) / 2)
		for _, e in ipairs(P.workshop.layout) do e.gx, e.gz = e.gx + shift, e.gz end
	else
		P.workshop.floors = P.workshop.floors + 1
	end
	touched(session, true)
	afterChange(world, session, {})
	return ok({ sizeTier = P.workshop.sizeTier, floors = P.workshop.floors })
end

function H.UnlockResearch(world, session, p)
	local P = session.profile
	if not ownContext(world, session, "market_hall") then return fail("TOO_FAR") end
	local node, code = Research.unlock(P, p.research)
	if not node then return fail(code) end
	touched(session, false)
	afterChange(world, session, { { type = "research", id = p.research } })
	return ok({ unlocks = node.unlocks })
end

function H.ClaimOrder(world, session, p)
	local P = session.profile
	if session.rt.inWorkshop then return fail("TOO_FAR") end
	local function notify(n) Game.notify(session, n) end
	local res, code
	if p.kind == "main" then
		local q = Quest.current(P)
		if not q or q.id ~= p.id or q.objective.type ~= "deliver" then return fail("NOT_READY") end
		if not Game.near(world, session, q.objective.at) then return fail("TOO_FAR") end
		res, code = Quest.claimMain(P, p.id, notify)
	elseif p.kind == "chain" then
		local c = Quests.chains[p.id]
		if not c then return fail("NOT_FOUND") end
		if not Quest.locationUnlocked(P, c.at) then return fail("LOCKED") end
		if not Game.near(world, session, c.at) then return fail("TOO_FAR") end
		res, code = Quest.claimChain(P, p.id, notify)
	elseif p.kind == "order" then
		if not Game.near(world, session, "market_hall") then return fail("TOO_FAR") end
		res, code = Quest.claimOrder(P, p.id, session.rt.now, notify)
	else
		return fail("BAD_REQUEST")
	end
	if not res then return fail(code) end
	touched(session, false)
	afterChange(world, session, {})
	return ok()
end

function H.DonateProject(world, session, p)
	local P, project = session.profile, world.project
	if session.rt.inWorkshop or not Game.near(world, session, "plaza") then return fail("TOO_FAR") end
	local def
	for _, d in ipairs(Quests.projects) do if d.id == project.id then def = d end end
	if project.done then return fail("LIMIT") end
	local n = math.min(p.amount, def.count - project.progress, P.items[def.item] or 0)
	if p.amount < 1 then return fail("BAD_REQUEST") end
	if n <= 0 then return fail("NO_ITEMS") end
	Inv.remove(P.items, { [def.item] = n })
	project.progress = project.progress + n
	project.contributors[session.userId] = (project.contributors[session.userId] or 0) + n
	if project.progress >= def.count then
		project.done = true
		for userId in pairs(project.contributors) do
			local s = world.sessions[userId]
			if s and not s.profile.claims[def.id] then
				s.profile.claims[def.id] = true
				Eco.addRep(s.profile, def.rep)
				Game.notify(s, { kind = "project_done", project = def.id, rep = def.rep, cosmetic = def.cosmetic })
			end
		end
	end
	touched(session, false)
	return ok({ progress = project.progress, done = project.done })
end

local function setRole(world, session, p)
	if not world.sessions[p.user] then return fail("NOT_FOUND") end
	if not Co.set(world, session.userId, p.user, p.role) then return fail("BAD_REQUEST") end
	if p.role == "none" then
		local guest = world.sessions[p.user]
		if guest.rt.inWorkshop == session.userId then guest.rt.inWorkshop = nil end
	end
	Game.notify(world.sessions[p.user], { kind = "coop", owner = session.userId, role = p.role })
	return ok()
end
H.InviteCoOp = setRole
H.SetCoOpPermission = setRole

function H.SaveBlueprint(world, session, p)
	local P, owner, code = workshop(world, session, "owner")
	if not P then return fail(code) end
	local bp, why = Place.saveBlueprint(P, p.slot, p.name, p.uids)
	if not bp then return fail(why) end
	touched(owner, false)
	return ok({ parts = #bp.parts, estimateCost = bp.estimateCost })
end

function H.PlaceBlueprint(world, session, p)
	local P, owner, code = workshop(world, session, "owner")
	if not P then return fail(code) end
	local placed, why = Place.placeBlueprint(P, p.slot, p.gx, p.gz, p.floor)
	if not placed then return fail(why) end
	touched(owner, true)
	return ok({ uids = placed })
end

function Actions.handle(world, session, action, payload, ctx)
	local now = ctx and ctx.now or 0
	session.rt.now = now
	local handler = H[action]
	local clean = handler and Sec.validate(action, payload)
	local result
	if not clean then
		result = fail("BAD_REQUEST")
	elseif not Sec.allow(session, action, now) then
		result = fail("RATE_LIMITED")
	else
		local previous = Sec.replayed(session, clean.actionId)
		if previous then
			result = { ok = previous.ok, code = previous.ok and "DUPLICATE" or previous.code, payload = previous.payload }
		elseif session.safeMode and action ~= "RequestSnapshot" then
			result = fail("SAFE_MODE")
		else
			result = handler(world, session, clean)
			Sec.remember(session, clean.actionId, result)
		end
	end
	result.version = session.rt.version
	result.action = action
	return result
end
Actions.handlers = H
return Actions
]]></ProtectedString></Properties></Item>
<Item class="Script" referent="RBX000034"><Properties><string name="Name">Bootstrap</string><ProtectedString name="Source"><![CDATA[-- ROBLOX ADAPTER (UNVERIFIED_IN_STUDIO): wires the pure game core to players, remotes, the village
-- and the DataStore.  Place under ServerScriptService.ArcaneServer (see default.project.json).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local DataStoreService = game:GetService("DataStoreService")

local D = require(script.Parent.Data)
local Game = require(script.Parent.Game)
local Actions = require(script.Parent.Actions)
local ProfileStore = require(script.Parent.ProfileStore)
local VillageAdapter = require(script.Parent.VillageAdapter)
local WorkshopWorld = require(script.Parent.WorkshopWorld)
local MarketWorld = require(script.Parent.MarketWorld)
local ResourceWorld = require(script.Parent.ResourceWorld)
local Config, Locations, Protocol = D.Config, D.Locations, D.Protocol

-- wait until the village (or its greybox stand-in) exists, otherwise ground raycasts hit nothing
if game:GetService("ServerScriptService"):FindFirstChild("VillageAutoBuild") then
	local waited = 0
	while not workspace:GetAttribute("VillageReady") and waited < 180 do
		waited = waited + task.wait(0.25)
	end
end

do
	local errors = D.Validator.run(D)
	for _, e in ipairs(errors) do warn("[Arcane] data error: " .. e) end
end

-- ---- village anchors (the village itself is built by VillageWorldBuilder, independently) ----
local origin = workspace:GetAttribute("VillageOrigin")
if typeof(origin) ~= "CFrame" then origin = CFrame.new() end
local layout
do
	local folder = ServerStorage:FindFirstChild("VillageWorld")
	local module = folder and folder:FindFirstChild("WorldLayout")
	if module then
		local ok, result = pcall(require, module)
		if ok then layout = result else warn("[Arcane] WorldLayout failed to load: " .. tostring(result)) end
	end
end
local anchors, nodeAnchors = {}, {}
if layout then
	local missing
	anchors, nodeAnchors, missing = VillageAdapter.computeAnchors(layout)
	for _, id in ipairs(missing) do warn("[Arcane] location without building: " .. id) end
else
	warn("[Arcane] ServerStorage.VillageWorld.WorldLayout not found - village services are disabled")
end

local function groundPosition(a)
	local p = origin * Vector3.new(a.x, a.y or 0, a.z)
	local hit = workspace:Raycast(p + Vector3.new(0, 200, 0), Vector3.new(0, -500, 0))
	return hit and hit.Position or p
end
-- the pure core works in village-local coordinates; convert character positions back into them
local function toLocal(position)
	local p = origin:PointToObjectSpace(position)
	return p.X, p.Z
end

local world = Game.newWorld(anchors, nodeAnchors, os.time(), D.Market.anchors(layout))
-- Walkable workshops: one open building per player on a levelled plot of the village.  Without a
-- level plan (plain test place) the old closed interiors with teleport stay in use.
local plotPositions = {}
if layout and layout.workshopPlots then
	for _, p in ipairs(layout.workshopPlots.plots) do
		plotPositions[#plotPositions + 1] = origin * Vector3.new(p[1], p[2], p[3])
	end
end
local walkable = #plotPositions > 0
local workshops = WorkshopWorld.new(workspace, ServerStorage:FindFirstChild("ArcaneAssets"), plotPositions,
	layout and layout.workshopPlots and layout.workshopPlots.half)
if walkable then world.plotPresence = {} end

-- ---- persistence ----
local persistent, store = true, nil
do
	local ok, result = pcall(function() return DataStoreService:GetDataStore("ArcaneVillage_v1") end)
	if ok then
		store = result
	else
		persistent = false
		warn("[Arcane] DataStore unavailable (" .. tostring(result) .. ") - progress will NOT be saved in this session")
		local memory = {}
		store = { UpdateAsync = function(_, key, fn)
			local new = fn(memory[key])
			if new ~= nil then memory[key] = new end
			return new
		end }
	end
end
local profiles = ProfileStore.new({ store = store, serverId = game.JobId ~= "" and game.JobId or "studio",
	now = os.time, wait = task.wait })

-- ---- remotes ----
local request = Instance.new("RemoteFunction")
request.Name = Protocol.remoteName
request.Parent = ReplicatedStorage
local event = Instance.new("RemoteEvent")
event.Name = Protocol.eventName
event.Parent = ReplicatedStorage

local function snapshotFor(player)
	local session = world.sessions[player.UserId]
	if not session then return nil end
	local snap = Game.snapshot(world, session)
	snap.persistent = persistent
	if snap.workshop then
		local room = workshops.rooms[snap.workshop.owner]
		if room then snap.room = { x = room.origin.X, y = room.origin.Y, z = room.origin.Z } end
	end
	return snap
end
local function push(player)
	local snap = snapshotFor(player)
	if snap then event:FireClient(player, "Snapshot", snap) end
end

local function teleport(player, cframe)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then character:PivotTo(cframe) end
end
local function sendHome(player)
	if walkable then return end -- nobody is locked in: leaving a plot is just walking away
	local a = anchors.workshop_door or anchors.plaza
	if a then
		teleport(player, CFrame.new(groundPosition(a) + Vector3.new(0, 4, 0)))
	elseif layout then
		teleport(player, origin * CFrame.new(layout.spawn[1], layout.spawn[2] + 4, layout.spawn[3]))
	end
end

local function perform(player, action, payload)
	local session = world.sessions[player.UserId]
	if not session then return { ok = false, code = "NOT_READY" } end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if action == "BuyMarketOffer" and not root then return { ok = false, code = "NOT_READY" } end
	if root and (walkable or not session.rt.inWorkshop) then
		local x, z = toLocal(root.Position)
		Game.updatePosition(world, session, x, z)
	end
	local result = Actions.handle(world, session, action, payload, { now = workspace:GetServerTimeNow() })
	if result.ok and action == "EnterWorkshop" and not walkable then
		local view = Game.workshopView(world, session.rt.inWorkshop)
		local room = workshops:sync(view)
		teleport(player, workshops:spawnCFrame(room))
	elseif result.ok and action == "LeaveWorkshop" then
		sendHome(player)
	elseif result.ok and (action == "SetCoOpPermission" or action == "InviteCoOp") and payload.role == "none" then
		local guest = Players:GetPlayerByUserId(payload.user)
		if guest then sendHome(guest) end
	end
	return result
end

request.OnServerInvoke = function(player, action, payload)
	if type(action) ~= "string" then return { ok = false, code = "BAD_REQUEST" } end
	local ok, result = pcall(perform, player, action, payload)
	if not ok then
		warn("[Arcane] action " .. action .. " failed: " .. tostring(result))
		return { ok = false, code = "BAD_REQUEST" }
	end
	result.snapshot = snapshotFor(player)
	return result
end

-- ---- world markers: prompts at locations, nodes and the workshop door ----
local markers = Instance.new("Folder")
markers.Name = "ArcaneMarkers"
markers.Parent = workspace
local function marker(name, position, color, actionText, objectText, onTrigger)
	local p = Instance.new("Part")
	p.Name, p.Anchored, p.CanCollide, p.Shape = name, true, false, Enum.PartType.Cylinder
	p.Size, p.Color, p.Material, p.Transparency = Vector3.new(0.4, 5, 5), color, Enum.Material.Neon, 0.35
	p.CFrame = CFrame.new(position + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90))
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText, prompt.ObjectText, prompt.MaxActivationDistance, prompt.RequiresLineOfSight = actionText, objectText, 12, false
	prompt.HoldDuration = 0.15
	prompt.Triggered:Connect(onTrigger)
	prompt.Parent = p
	p.Parent = markers
	return p
end
for id, a in pairs(anchors) do
	local loc = Locations.locations[id]
	if id == "workshop_door" and not walkable then
		marker("Door", groundPosition(a), Color3.fromRGB(201, 154, 60), "Betreten", loc.name, function(player)
			perform(player, "EnterWorkshop", {})
			push(player)
		end)
	else
		marker("Location_" .. id, groundPosition(a), Color3.fromRGB(127, 178, 201), "Ansprechen", loc.name, function(player)
			local session = world.sessions[player.UserId]
			if session then
				local x, z = toLocal(player.Character.HumanoidRootPart.Position)
				Game.updatePosition(world, session, x, z)
			end
			event:FireClient(player, "OpenLocation", id)
			push(player)
		end)
	end
end
-- resource nodes: a model of the resource itself, harvested through its own prompt
local resources
resources = ResourceWorld.build(workspace, nodeAnchors, origin, ServerStorage:FindFirstChild("ArcaneResourceAssets"),
	groundPosition, function(player, id)
		local result = perform(player, "GatherNode", { node = id })
		event:FireClient(player, "ActionResult", result)
		push(player)
		resources:update(world.nodes)
	end)

MarketWorld.build(workspace, world.marketAnchors, origin, ServerStorage:FindFirstChild("ArcaneMarketAssets"), groundPosition,
	function(player, id)
		local session = world.sessions[player.UserId]
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not session or not root or session.rt.inWorkshop then return end
		local x, z = toLocal(root.Position)
		if D.Market.near(world.marketAnchors[id], { x = x, z = z }) then
			push(player)
			event:FireClient(player, "OpenMarket", id)
		end
	end)

-- ---- players ----
local function onPlayer(player)
	local profile, status = profiles:load(player.UserId)
	local safe = profile == nil
	if safe then warn("[Arcane] profile of " .. player.Name .. " not available (" .. tostring(status) .. ") - safe mode") end
	Game.addSession(world, player.UserId, profile, safe)
	player.CharacterAdded:Connect(function()
		task.wait(0.2)
		local session = world.sessions[player.UserId]
		if session then session.rt.inWorkshop = nil end
		if layout then
			teleport(player, origin * CFrame.new(layout.spawn[1], layout.spawn[2] + 4, layout.spawn[3]))
		end
	end)
	event:FireClient(player, "Status", { status = status, persistent = persistent })
	push(player)
end
local function saveAndRemove(player, release)
	local session = world.sessions[player.UserId]
	if not session then return end
	if not session.safeMode then
		local ok, reason = profiles:save(player.UserId, session.profile, release)
		if not ok then warn("[Arcane] save failed for " .. player.Name .. ": " .. tostring(reason)) end
		if not release then event:FireClient(player, "Saved", { ok = ok, persistent = persistent }) end
	end
	if release then
		for _, guestId in ipairs(Game.removeSession(world, player.UserId)) do
			local guest = Players:GetPlayerByUserId(guestId)
			if guest then sendHome(guest) end
		end
		workshops:removeRoom(player.UserId)
		if world.plotPresence then world.plotPresence[player.UserId] = nil end
	end
end
Players.PlayerAdded:Connect(onPlayer)
for _, player in ipairs(Players:GetPlayers()) do task.spawn(onPlayer, player) end
Players.PlayerRemoving:Connect(function(player) saveAndRemove(player, true) end)
game:BindToClose(function()
	for _, player in ipairs(Players:GetPlayers()) do saveAndRemove(player, true) end
end)

-- ---- main loop: fixed simulation tick, 1 s position / snapshot / visuals, periodic autosave ----
local simAcc, slowAcc, saveAcc, presenceAcc = 0, 0, 0, 0
RunService.Heartbeat:Connect(function(dt)
	simAcc = simAcc + math.min(dt, 1)
	local guard = 0
	while simAcc >= Config.sim.tick and guard < 8 do
		simAcc = simAcc - Config.sim.tick
		guard = guard + 1
		Game.tick(world, Config.sim.tick, os.time())
	end
	slowAcc = slowAcc + dt
	if slowAcc >= 1 then
		slowAcc = 0
		resources:update(world.nodes)
		for _, player in ipairs(Players:GetPlayers()) do
			local session = world.sessions[player.UserId]
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if session and root then
				if walkable then
					local x, z = toLocal(root.Position)
					Game.updatePosition(world, session, x, z)
				elseif session.rt.inWorkshop then
					-- fell out of the interior? bring the player back instead of leaving him in the void
					local room = workshops.rooms[session.rt.inWorkshop]
					if room and (root.Position - room.origin).Magnitude > 400 then teleport(player, workshops:spawnCFrame(room)) end
				else
					local x, z = toLocal(root.Position)
					Game.updatePosition(world, session, x, z)
				end
			end
			if session and not session.safeMode then
				workshops:sync(Game.workshopView(world, player.UserId), "Werkstatt von " .. player.DisplayName)
			end
			push(player)
		end
	end
	-- walkable workshops: whoever stands on a plot is "in" that workshop, nobody is teleported
	presenceAcc = presenceAcc + dt
	if walkable and presenceAcc >= 0.25 then
		presenceAcc = 0
		local now = workspace:GetServerTimeNow()
		for _, player in ipairs(Players:GetPlayers()) do
			local session = world.sessions[player.UserId]
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if session and not session.safeMode then
				local owner = root and workshops:ownerAt(root.Position) or nil
				world.plotPresence[player.UserId] = owner
				local changed = false
				if session.rt.inWorkshop and session.rt.inWorkshop ~= owner then
					Actions.handle(world, session, "LeaveWorkshop", {}, { now = now })
					changed = true
				end
				-- a refused entry (no permission from the owner) is retried only every 3 seconds
				if owner and not session.rt.inWorkshop and (session.rt.enterRetry or 0) <= now then
					local result = Actions.handle(world, session, "EnterWorkshop", { owner = owner }, { now = now })
					if result.ok then changed = true else session.rt.enterRetry = now + 3 end
				end
				if changed then push(player) end
			end
		end
	end
	saveAcc = saveAcc + dt
	if saveAcc >= Config.autosaveSec then
		saveAcc = 0
		for _, player in ipairs(Players:GetPlayers()) do task.spawn(saveAndRemove, player, false) end
	end
end)

-- exit prompts of the interiors
workspace.DescendantAdded:Connect(function(inst)
	if inst:IsA("ProximityPrompt") and inst.Parent and inst.Parent.Name == "ExitDoor" then
		inst.Triggered:Connect(function(player)
			perform(player, "LeaveWorkshop", {})
			push(player)
		end)
	end
end)
print("[Arcane] server ready - persistent saves: " .. tostring(persistent))
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000035"><Properties><string name="Name">CoOpPermissions</string><ProtectedString name="Source"><![CDATA[-- Session-scoped co-op rights. Nothing here is persisted (spec §4: no hosted factory without the owner).
local Co = {}
Co.RANK = { visitor = 1, operator = 2, builder = 3, owner = 4 }
function Co.role(world, ownerId, userId)
	if ownerId == userId then return "owner" end
	local grants = world.coop[ownerId]
	return grants and grants[userId] or nil
end
function Co.atLeast(world, ownerId, userId, role)
	local have = Co.role(world, ownerId, userId)
	return have ~= nil and Co.RANK[have] >= Co.RANK[role]
end
-- Owner grants or revokes ("none"). Ownership itself can never be transferred.
function Co.set(world, ownerId, userId, role)
	if userId == ownerId then return false end
	world.coop[ownerId] = world.coop[ownerId] or {}
	if role == "none" then
		world.coop[ownerId][userId] = nil
		return true
	end
	if role ~= "visitor" and role ~= "operator" and role ~= "builder" then return false end
	world.coop[ownerId][userId] = role
	return true
end
function Co.clearOwner(world, ownerId) world.coop[ownerId] = nil end
return Co
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000036"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[-- Loads the shared data tables once for all server modules.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("ArcaneShared")
return {
	Market = require(Shared.MarketCatalog), Config = require(Shared.Config), Items = require(Shared.Items), Recipes = require(Shared.Recipes),
	Machines = require(Shared.Machines), Research = require(Shared.Research), Quests = require(Shared.Quests),
	Locations = require(Shared.Locations), Protocol = require(Shared.Protocol), GridMath = require(Shared.GridMath),
	Util = require(Shared.Util), Validator = require(Shared.Validator),
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000037"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source"><![CDATA[-- Sole writer of wallet, knowledge and reputation.
local D = require(script.Parent.Data)
local Config, Util = D.Config, D.Util
local Eco = {}
function Eco.canPay(P, coins) return Util.isInt(coins) and coins >= 0 and P.wallet >= coins end
function Eco.pay(P, coins)
	if not Eco.canPay(P, coins) then return false end
	P.wallet = P.wallet - coins
	return true
end
function Eco.earn(P, coins)
	if Util.isInt(coins) and coins > 0 then
		P.wallet = P.wallet + coins
		P.stats.coinsEarned = P.stats.coinsEarned + coins
	end
end
function Eco.addKnowledge(P, n)
	if Util.isInt(n) and n > 0 then P.knowledge = P.knowledge + n end
end
function Eco.spendKnowledge(P, n)
	if not (Util.isInt(n) and n >= 0 and P.knowledge >= n) then return false end
	P.knowledge = P.knowledge - n
	return true
end
function Eco.addRep(P, n)
	if Util.isInt(n) and n > 0 then P.repPoints = P.repPoints + n end
end
function Eco.repLevel(P)
	local level = 0
	for i, need in ipairs(Config.reputation) do
		if P.repPoints >= need then level = i - 1 end
	end
	return level
end
function Eco.priceFor(P, itemId, baseSell)
	local demand = (P.shop.demand[itemId] or 100) / 100
	local rep = 1 + Config.shop.repPriceStep * Eco.repLevel(P)
	return math.floor(baseSell * demand * rep)
end
return Eco
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000038"><Properties><string name="Name">Game</string><ProtectedString name="Source"><![CDATA[-- World state of one server: sessions, shared nodes, village project, ticking and snapshots.
-- Pure Lua; the Roblox adapters (Bootstrap) feed positions, time and network into it.
local D = require(script.Parent.Data)
local Profile = require(script.Parent.ProfileService)
local Sim = require(script.Parent.WorkshopSimulation)
local Quest = require(script.Parent.QuestService)
local Res = require(script.Parent.ResourceService)
local Shop = require(script.Parent.ShopService)
local Eco = require(script.Parent.EconomyService)
local Metrics = require(script.Parent.MetricsService)
local Co = require(script.Parent.CoOpPermissions)
local Prod = require(script.Parent.ProductionService)
local Config, Quests, Locations, Machines, Recipes = D.Config, D.Quests, D.Locations, D.Machines, D.Recipes
local Game = {}

-- anchors: { [locationId] = {x=, z=} }, nodeAnchors: { [nodeId] = {x=, z=} } in world studs.
function Game.newWorld(anchors, nodeAnchors, seed, marketAnchors)
	local project = Quests.projects[((seed or 0) % #Quests.projects) + 1]
	return { sessions = {}, nodes = Res.new(), anchors = anchors or {}, nodeAnchors = nodeAnchors or {},
		marketAnchors = marketAnchors or {}, coop = {},
		project = { id = project.id, progress = 0, contributors = {}, done = false } }
end

function Game.addSession(world, userId, profile, safeMode)
	local session = { userId = userId, profile = profile or Profile.new(userId), safeMode = safeMode == true }
	local rt = Sim.newRuntime()
	rt.buckets, rt.recent, rt.recentOrder, rt.version, rt.notes = {}, {}, {}, 0, {}
	session.rt = rt
	world.sessions[userId] = session
	return session
end

-- Returns the visitors that must be sent back to the hub because their host left.
function Game.removeSession(world, userId)
	local evicted = {}
	for id, s in pairs(world.sessions) do
		if id ~= userId and s.rt.inWorkshop == userId then
			s.rt.inWorkshop = nil
			evicted[#evicted + 1] = id
		end
	end
	Co.clearOwner(world, userId)
	world.sessions[userId] = nil
	return evicted
end

function Game.notify(session, note)
	local notes = session.rt.notes
	notes[#notes + 1] = note
	if #notes > 40 then table.remove(notes, 1) end
end

function Game.near(world, session, locationId, extra)
	local a, p = world.anchors[locationId], session.rt.pos
	if not a or not p then return false end
	local loc = Locations.locations[locationId]
	local dx, dz = p.x - a.x, p.z - a.z
	local r = (loc and loc.radius or Config.interactRadius) + (extra or 0)
	return dx * dx + dz * dz <= r * r
end

-- Called with the server-side character position. Marks unlocked locations as visited.
function Game.updatePosition(world, session, x, z)
	session.rt.pos = { x = x, z = z }
	if session.rt.inWorkshop or session.safeMode then return end
	local P = session.profile
	for id in pairs(Locations.locations) do
		if not P.quest.visited[id] and Quest.locationUnlocked(P, id) and Game.near(world, session, id) then
			Quest.onEvents(P, { { type = "visit", at = id } })
			Game.notify(session, { kind = "visit", at = id })
		end
	end
end

-- Advances everything by dt seconds. Returns { [userId] = events } for client effects.
function Game.tick(world, dt, now)
	Res.step(world.nodes, dt)
	local out = {}
	for userId, session in pairs(world.sessions) do
		if not session.safeMode then
			local P = session.profile
			local events = Sim.step(P, session.rt, dt)
			local function notify(n) Game.notify(session, n) end
			Quest.onEvents(P, events, notify)
			Quest.evaluate(P, session.rt, notify)
			Quest.refreshOrders(P, now or 0)
			out[userId] = events
		end
	end
	return out
end

local function entityView(P, e)
	local b = P.workshop.buffers[e.uid]
	local v = { uid = e.uid, machine = e.machine, gx = e.gx, gz = e.gz, floor = e.floor, rot = e.rot,
		recipe = e.recipe, paused = e.paused, filter = e.filter, link = e.link, state = b.state, waiting = b.waiting,
		inv = b.inv, out = b.out, fluids = b.fluids, outFluid = b.outFluid, fuel = b.fuel, item = b.item }
	if b.job then
		v.job = { recipe = b.job.recipe, remaining = b.job.remaining, total = Recipes[b.job.recipe].durationSec }
	end
	return v
end

function Game.workshopView(world, ownerId)
	local s = world.sessions[ownerId]
	if not s then return nil end
	local P = s.profile
	local ents = {}
	for i, e in ipairs(P.workshop.layout) do ents[i] = entityView(P, e) end
	return { owner = ownerId, sizeTier = P.workshop.sizeTier, cells = Config.plotTiers[P.workshop.sizeTier].cells,
		floors = P.workshop.floors, entities = ents, version = s.rt.version,
		ratePerMin = Metrics.rate(s.rt.stats, s.rt.clock, 60), perItem5 = Metrics.perItem(s.rt.stats, s.rt.clock, 300),
		stock = Shop.stock(P), demand = P.shop.demand, nextCustomerIn = P.shop.nextIn }
end

-- Everything the owning client may know. Built from server state only.
function Game.snapshot(world, session)
	local P = session.profile
	local q = Quest.current(P)
	local chains = {}
	for id, c in pairs(Quests.chains) do
		local step = Quest.chainStep(P, id)
		chains[id] = { done = P.quest.chains[id] or 0, total = #c.steps, at = c.at, name = c.name,
			unlocked = Quest.locationUnlocked(P, c.at), step = step and { id = step.id, title = step.title,
				items = step.objective.items, rewards = step.rewards } or nil }
	end
	local orders = {}
	for i, o in ipairs(P.quest.orders.list) do
		local t = Quest.templateById[o.tpl]
		orders[i] = { id = o.id, title = t.title, items = t.items, coins = Quest.orderReward(t), rep = t.rep }
	end
	local nodes = {}
	for id, st in pairs(world.nodes) do
		nodes[id] = { remaining = st.remaining, unlocked = Quest.ruleMet(P, Locations.nodes[id].unlock) }
	end
	local locations = {}
	for id in pairs(Locations.locations) do
		locations[id] = { unlocked = Quest.locationUnlocked(P, id), visited = P.quest.visited[id] == true }
	end
	local project = nil
	for _, p in ipairs(Quests.projects) do
		if p.id == world.project.id then
			project = { id = p.id, title = p.title, item = p.item, count = p.count, progress = world.project.progress,
				done = world.project.done, mine = world.project.contributors[session.userId] or 0,
				claimed = P.claims[p.id] == true }
		end
	end
	local market = {}
	for _, id in ipairs(D.Market.order) do
		for _, offer in ipairs(D.Market.merchants[id].offers) do
			market[offer.item] = Quest.ruleMet(P, offer.unlock)
		end
	end
	local notes = session.rt.notes
	session.rt.notes = {}
	return {
		userId = session.userId, safeMode = session.safeMode, version = session.rt.version,
		wallet = P.wallet, knowledge = P.knowledge, repPoints = P.repPoints, repLevel = Eco.repLevel(P),
		items = P.items, research = P.research, discoveries = P.discoveries, stats = P.stats,
		quest = q and { id = q.id, title = q.title, hint = q.hint, objective = q.objective, progress = P.quest.progress,
			giver = q.giver, rewards = q.rewards } or nil,
		questIndex = P.quest.main, market = market, chains = chains, orders = orders, nodes = nodes, locations = locations,
		project = project, blueprints = P.blueprints, inWorkshop = session.rt.inWorkshop,
		workshop = session.rt.inWorkshop and Game.workshopView(world, session.rt.inWorkshop) or nil,
		coop = world.coop[session.userId] or {}, notes = notes,
	}
end
return Game
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000039"><Properties><string name="Name">InventoryService</string><ProtectedString name="Source"><![CDATA[-- Sole writer of item stores. A store is a plain map itemId -> integer amount (pieces or ml).
-- Player inventory: limited slots for solids, capacity per liquid. Containers: slot limited.
local D = require(script.Parent.Data)
local Items, Config, Util = D.Items, D.Config, D.Util
local Inv = {}

local function slotsUsed(store)
	local n = 0
	for id, amount in pairs(store) do
		local it = Items[id]
		if it and it.unit ~= "ml" and amount > 0 then n = n + math.ceil(amount / it.stackLimit) end
	end
	return n
end
Inv.slotsUsed = slotsUsed

function Inv.count(store, id) return store[id] or 0 end

function Inv.has(store, items)
	for id, n in pairs(items) do
		if (store[id] or 0) < n then return false, id end
	end
	return true
end

-- How many units of `id` still fit. opts = { slots, liquidCap, only = function(id) }
function Inv.room(store, id, opts)
	local it = Items[id]
	if not it then return 0 end
	if opts.only and not opts.only(id) then return 0 end
	if it.unit == "ml" then
		if not opts.liquidCap then return 0 end
		return math.max(0, opts.liquidCap - (store[id] or 0))
	end
	local have = store[id] or 0
	local freeSlots = opts.slots - slotsUsed(store)
	local inStack = (math.ceil(have / it.stackLimit) * it.stackLimit) - have
	return math.max(0, inStack + freeSlots * it.stackLimit)
end

function Inv.canAdd(store, items, opts)
	local trial = {}
	for k, v in pairs(store) do trial[k] = v end
	for id, n in pairs(items) do
		if not Items[id] or not Util.isInt(n) or n < 0 then return false, id end
		if Inv.room(trial, id, opts) < n then return false, id end
		trial[id] = (trial[id] or 0) + n
	end
	return true
end

function Inv.add(store, items)
	for id, n in pairs(items) do
		if n > 0 then store[id] = (store[id] or 0) + n end
	end
end

-- Atomic: removes everything or nothing.
function Inv.remove(store, items)
	local ok, missing = Inv.has(store, items)
	if not ok then return false, missing end
	for id, n in pairs(items) do
		local left = store[id] - n
		if left <= 0 then store[id] = nil else store[id] = left end
	end
	return true
end

Inv.PLAYER = { slots = Config.inventory.slots, liquidCap = Config.inventory.liquidCap }
function Inv.playerOpts() return Inv.PLAYER end
function Inv.total(store)
	local n = 0
	for _, v in pairs(store) do n = n + v end
	return n
end
return Inv
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX000040"><Properties><string name="Name">LogisticsService</string><ProtectedString name="Source"><![CDATA[-- Transport graph (solids and fluids) of one workshop and its deterministic transfer step.
-- Tokens are data only; nothing here creates Roblox instances.
local D = require(script.Parent.Data)
local Place = require(script.Parent.PlacementService)
local Inv = require(script.Parent.InventoryService)
local Config, Machines, Recipes, Items, Grid, Util = D.Config, D.Machines, D.Recipes, D.Items, D.GridMath, D.Util
local L = {}
local CARRIER = { belt = true, splitter = true, merger = true, sorter = true, lift = true, gate = true }
L.CARRIER = CARRIER

function L.build(P)
	local G = { ents = {}, order = {}, solid = {}, hopperSrc = {}, comps = {} }
	local ground, pipe = Place.occupancy(P)
	G.ground, G.pipe = ground, pipe
	for _, e in ipairs(P.workshop.layout) do
		G.ents[e.uid] = e
		G.order[#G.order + 1] = e.uid
	end
	local function entAt(floor, x, z)
		local uid = ground[Grid.key(floor, x, z)]
		return uid and G.ents[uid] or nil
	end
	local function solidTarget(floor, x, z, dir)
		local t = entAt(floor, x, z)
		if not t then return false end
		local def = Machines[t.machine]
		if def.kind == "crate" or def.kind == "shelf" then return t.uid end
		for _, p in ipairs(def.ports) do
			if p.type == "solid" and p.mode == "in" then
				local px, pz, pd = Grid.port(def, p, t.gx, t.gz, t.rot)
				if px == x and pz == z and pd == Grid.opposite(dir) then return t.uid end
			end
		end
		return false
	end
	-- fluid network: union-find over pipes and tanks
	local parent = {}
	local function find(a)
		while parent[a] ~= a do
			parent[a] = parent[parent[a]]
			a = parent[a]
		end
		return a
	end
	local function union(a, b) parent[find(a)] = find(b) end
	for _, e in ipairs(P.workshop.layout) do
		local kind = Machines[e.machine].kind
		if kind == "pipe" or kind == "tank" then parent[e.uid] = e.uid end
	end
	for _, e in ipairs(P.workshop.layout) do
		if Machines[e.machine].kind == "pipe" then
			for dir = 0, 3 do
				local k = Grid.key(e.floor, e.gx + Grid.DX[dir], e.gz + Grid.DZ[dir])
				if pipe[k] then union(e.uid, pipe[k]) end
				local g = ground[k] and G.ents[ground[k]]
				if g and Machines[g.machine].kind == "tank" then union(e.uid, g.uid) end
			end
		end
	end
	local compOf = {}
	local function comp(root)
		if not compOf[root] then
			compOf[root] = { sources = {}, sinks = {}, tanks = {} }
			G.comps[#G.comps + 1] = compOf[root]
		end
		return compOf[root]
	end
	for _, e in ipairs(P.workshop.layout) do
		local def = Machines[e.machine]
		if def.kind == "tank" then
			local c = comp(find(e.uid))
			c.tanks[#c.tanks + 1] = e.uid
		end
		local outs = {}
		for _, p in ipairs(def.ports) do
			local px, pz, dir = Grid.port(def, p, e.gx, e.gz, e.rot)
			local nx, nz = px + Grid.DX[dir], pz + Grid.DZ[dir]
			if p.type == "solid" and p.mode == "out" then
				local floor = e.floor
				if def.kind == "lift" then floor = floor + 1 end
				if def.kind == "gate" then
					local partner = e.link and G.ents[e.link]
					if partner and Machines[partner.machine].kind == "gate" and partner.uid ~= e.uid then
						local qx, qz, qdir = Grid.port(def, p, partner.gx, partner.gz, partner.rot)
						outs[#outs + 1] = solidTarget(partner.floor, qx + Grid.DX[qdir], qz + Grid.DZ[qdir], qdir)
					else
						outs[#outs + 1] = false
					end
				else
					outs[#outs + 1] = solidTarget(floor, nx, nz, dir)
				end
			elseif p.type == "fluid" then
				local k = Grid.key(e.floor, nx, nz)
				local n = ground[k] and G.ents[ground[k]]
				local root
				if pipe[k] then root = find(pipe[k])
				elseif n and Machines[n.machine].kind == "tank" then root = find(n.uid) end
				if root then
					local c = comp(root)
					local list = (p.mode == "out") and c.sources or c.sinks
					list[#list + 1] = e.uid
				elseif n and p.mode == "out" then
					for _, q in ipairs(Machines[n.machine].ports) do
						if q.type == "fluid" and q.mode == "in" then
							local qx, qz, qd = Grid.port(Machines[n.machine], q, n.gx, n.gz, n.rot)
							if qx == nx and qz == nz and qd == Grid.opposite(dir) then
								G.comps[#G.comps + 1] = { sources = { e.uid }, sinks = { n.uid }, tanks = {} }
							end
						end
					end
				end
			end
		end
		G.solid[e.uid] = outs
		if def.kind == "hopper" then
			local front = e.rot % 4
			local src = entAt(e.floor, e.gx - Grid.DX[front], e.gz - Grid.DZ[front])
			if src then
				local kind = Machines[src.machine].kind
				if kind == "crate" or kind == "machine" then G.hopperSrc[e.uid] = src.uid end
			end
		end
	end
	return G
end

-- Which slot of entity `uid` would take one `item`? nil = not accepted now.
function L.accepts(P, G, uid, item)
	local e = G.ents[uid]
	local def, b = Machines[e.machine], P.workshop.buffers[uid]
	local it = Items[item]
	if not it or it.unit == "ml" then return nil end
	if def.kind == "crate" then
		return Inv.room(b.inv, item, def) >= 1 and "inv" or nil
	elseif def.kind == "shelf" then
		return (it.type == "product" and Inv.room(b.inv, item, def) >= 1) and "inv" or nil
	elseif def.kind == "machine" then
		if def.usesFuel and item == "fuel_charcoal" then
			return b.fuel < Config.machine.fuelCap and "fuel" or nil
		end
		local r = e.recipe and Recipes[e.recipe]
		local need = r and r.inputs[item]
		if need and (b.inv[item] or 0) < need * Config.machine.inputFactor then return "inv" end
		return nil
	elseif CARRIER[def.kind] then
		return b.item == nil and "item" or nil
	end
	return nil
end

function L.give(P, uid, slot, item, viaLogistics)
	local b = P.workshop.buffers[uid]
	if slot == "item" then
		b.item, b.t = item, 0
	elseif slot == "fuel" then
		b.fuel = b.fuel + 1
	else
		b.inv[item] = (b.inv[item] or 0) + 1
		if viaLogistics then b.auto = true end
	end
end

local function takeOne(store, item)
	local left = store[item] - 1
	if left <= 0 then store[item] = nil else store[item] = left end
end

local function inFilter(e, item)
	if not e.filter then return false end
	for _, id in ipairs(e.filter) do if id == item then return true end end
	return false
end

-- Moves solid tokens. Returns the number of transfers.
function L.stepSolids(P, G, dt, tickIndex)
	local buffers, sim = P.workshop.buffers, Config.sim
	local n = #G.order
	if n == 0 then return 0 end
	for i = 1, n do
		local b = buffers[G.order[i]]
		b.t = math.min((b.t or 0) + dt, 60)
	end
	local moved = 0
	local start = tickIndex % n
	for i = 1, n do
		local uid = G.order[((start + i - 1) % n) + 1]
		local e, b = G.ents[uid], buffers[uid]
		local kind = Machines[e.machine].kind
		local outs = G.solid[uid]
		if kind == "machine" then
			local target = outs[1]
			if target and b.t >= 0.5 then
				for _, item in ipairs(Util.sortedKeys(b.out)) do
					local slot = L.accepts(P, G, target, item)
					if slot then
						takeOne(b.out, item)
						L.give(P, target, slot, item, true)
						b.t, moved = 0, moved + 1
						break
					end
				end
			end
		elseif kind == "hopper" then
			local src, target = G.hopperSrc[uid], outs[1]
			if src and target and b.t >= sim.hopperSecondsPerItem then
				local sb = buffers[src]
				local store = (Machines[G.ents[src].machine].kind == "crate") and sb.inv or sb.out
				for _, item in ipairs(Util.sortedKeys(store)) do
					if (not e.filter or inFilter(e, item)) then
						local slot = L.accepts(P, G, target, item)
						if slot then
							takeOne(store, item)
							L.give(P, target, slot, item, true)
							b.t, moved = 0, moved + 1
							break
						end
					end
				end
			end
		elseif CARRIER[kind] and b.item then
			local period = 0.5
			if kind == "belt" then period = sim.beltSecondsPerItem
			elseif kind == "lift" then period = sim.liftSecondsPerItem
			elseif kind == "gate" then period = sim.gateSecondsPerItem end
			if b.t >= period then
				local target
				if kind == "splitter" then
					local count = #outs
					for k = 0, count - 1 do
						local idx = ((b.rr or 0) + k) % count + 1
						if outs[idx] and L.accepts(P, G, outs[idx], b.item) then
							target = outs[idx]
							b.rr = idx % count
							break
						end
					end
				elseif kind == "sorter" then
					target = inFilter(e, b.item) and outs[1] or outs[2]
				else
					target = outs[1]
				end
				local slot = target and L.accepts(P, G, target, b.item)
				if slot then
					local item = b.item
					b.item = nil
					L.give(P, target, slot, item, true)
					moved = moved + 1
				end
			end
		end
	end
	return moved
end

local function fluidSource(P, G, uid)
	local e, b = G.ents[uid], P.workshop.buffers[uid]
	if Machines[e.machine].kind == "pump" then return b.fluids, true end
	return b.outFluid, false
end

-- Moves liquids (integer ml) inside every fluid component. emit(event) reports piped water.
function L.stepFluids(P, G, dt, emit)
	local buffers = P.workshop.buffers
	for _, c in ipairs(G.comps) do
		local budget = math.floor(Config.sim.pipeMlPerSec * dt)
		for _, sinkUid in ipairs(c.sinks) do
			local e, b = G.ents[sinkUid], buffers[sinkUid]
			local r = e.recipe and Recipes[e.recipe]
			if r then
				for _, item in ipairs(Util.sortedKeys(r.inputs)) do
					if Items[item].unit == "ml" then
						local function pull(store, countsAsPiped)
							local room = Config.machine.fluidCap - (b.fluids[item] or 0)
							local n = math.min(room, store[item] or 0, budget)
							if n > 0 then
								store[item] = store[item] - n
								if store[item] == 0 then store[item] = nil end
								b.fluids[item] = (b.fluids[item] or 0) + n
								budget = budget - n
								if countsAsPiped and item == "water" then emit({ type = "piped", ml = n }) end
							end
						end
						for _, srcUid in ipairs(c.sources) do
							local store, isPump = fluidSource(P, G, srcUid)
							pull(store, isPump)
						end
						for _, tankUid in ipairs(c.tanks) do pull(buffers[tankUid].fluids, true) end
					end
				end
			end
		end
		-- surplus of producers goes into tanks (one liquid type per tank)
		for _, srcUid in ipairs(c.sources) do
			local store = fluidSource(P, G, srcUid)
			for _, item in ipairs(Util.sortedKeys(store)) do
				for _, tankUid in ipairs(c.tanks) do
					local tb = buffers[tankUid]
					local held = next(tb.fluids)
					if held == nil or held == item then
						local cap = Machines[G.ents[tankUid].machine].capacity
						local n = math.min(cap - (tb.fluids[item] or 0), store[item] or 0, budget)
						if n > 0 then
							store[item] = store[item] - n
							if store[item] == 0 then store[item] = nil end
							tb.fluids[item] = (tb.fluids[item] or 0) + n
							budget = budget - n
						end
					end
				end
			end
		end
	end
end
return L
]]></ProtectedString></Properties></Item>
